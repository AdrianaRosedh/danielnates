---
/**
 * EditOverlay — inline-edit affordance for admins on the public site.
 *
 * Mounted by BaseLayout when Astro.locals.isAdmin is true. Renders a
 * floating toolbar at the bottom-right and attaches click-to-edit
 * behaviour to every element on the page that carries a
 * data-edit-field="entity.field" attribute.
 *
 * UX:
 *   - "Editar" toggle in the toolbar turns edit mode on/off
 *   - Hovered editable element: subtle outline, dotted underline
 *   - Click in edit mode: element becomes contentEditable
 *   - Enter (or blur) commits via /api/admin/inline-edit
 *   - Escape reverts the field to its pre-edit value
 *   - Save state shown in toolbar ("Guardado · 2s")
 *
 * When the host page provides editContext (entity + id), two extra
 * affordances appear in the toolbar:
 *   - Publish toggle (calls /api/admin/entity-action publish/unpublish)
 *   - Delete button with confirm (calls entity-action delete, then
 *     redirects to the indexHref)
 *
 * Server-rendered as nothing for non-admin visitors.
 */

interface EditContext {
  entity: "article" | "art" | "project" | "daily" | "press_mention";
  id: string;
  published?: boolean;
  indexHref: string;
}
interface CreateContext {
  entity: "article" | "art" | "project" | "daily" | "press_mention";
  label?: string;
}

interface Props {
  editContext?: EditContext;
  createContext?: CreateContext;
}
const { editContext, createContext } = Astro.props as Props;
---

<div
  class="editbar"
  data-editbar
  role="region"
  aria-label="Editor en línea"
  data-edit-entity={editContext?.entity ?? undefined}
  data-edit-entity-id={editContext?.id ?? undefined}
  data-edit-entity-index={editContext?.indexHref ?? undefined}
  data-edit-create-entity={createContext?.entity ?? undefined}
>
  <div class="editbar__row">
    <span class="editbar__dot" aria-hidden="true"></span>
    <span class="editbar__label">Admin</span>
    <button class="editbar__toggle" type="button" data-edit-toggle aria-pressed="false">
      <span class="editbar__toggleDot" aria-hidden="true"></span>
      <span data-edit-toggle-label>Editar</span>
    </button>
    {createContext ? (
      <button class="editbar__create" type="button" data-edit-create>
        <span aria-hidden="true">+</span>
        <span>{createContext.label ?? "Nuevo"}</span>
      </button>
    ) : null}
    {editContext ? (
      <>
        <span class="editbar__sep" aria-hidden="true"></span>
        <button
          class="editbar__toggle editbar__toggle--small"
          type="button"
          data-edit-publish
          aria-pressed={editContext.published ? "true" : "false"}
          title="Publicar / despublicar"
        >
          <span class="editbar__toggleDot" aria-hidden="true"></span>
          <span data-edit-publish-label>{editContext.published ? "Publicado" : "Borrador"}</span>
        </button>
        <button
          class="editbar__delete"
          type="button"
          data-edit-delete
          title="Borrar para siempre"
        >Borrar</button>
      </>
    ) : null}
    <span class="editbar__status" data-edit-status aria-live="polite"></span>
    <a class="editbar__link" href="/admin">Panel ↗</a>
    <form class="editbar__logout" method="post" action="/admin/logout">
      <button class="editbar__link" type="submit">Salir</button>
    </form>
  </div>
</div>
<input
  type="file"
  accept="image/*"
  data-edit-image-input
  hidden
  aria-hidden="true"
/>

<div
  class="editModal"
  data-edit-modal
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  hidden
>
  <div class="editModal__bg" data-edit-modal-bg></div>
  <div class="editModal__panel">
    <div class="editModal__head">
      <p class="editModal__label" data-edit-modal-label>Editar texto</p>
      <p class="editModal__hint">Cmd ⌘ + Enter para guardar · Esc para cancelar</p>
    </div>
    <textarea
      class="editModal__textarea"
      data-edit-modal-textarea
      spellcheck="true"
      autocomplete="off"
    ></textarea>
    <div class="editModal__foot">
      <button class="editModal__btn editModal__btn--ghost" type="button" data-edit-modal-cancel>Cancelar</button>
      <button class="editModal__btn editModal__btn--primary" type="button" data-edit-modal-save>Guardar</button>
    </div>
  </div>
</div>

{/* Floating formatting toolbar for in-place rich text editing.
    Shown while a [data-edit-portable] field is in an editing session;
    positioned just above the field, follows it on scroll. */}
<div class="editRich" data-edit-rich role="toolbar" aria-label="Formato de texto" hidden>
  <button class="editRich__btn" type="button" data-rich-cmd="bold" title="Negrita · ⌘B"><strong>B</strong></button>
  <button class="editRich__btn editRich__btn--em" type="button" data-rich-cmd="italic" title="Itálica · ⌘I"><em>I</em></button>
  <button class="editRich__btn" type="button" data-rich-cmd="link" title="Enlace">⌁</button>
  <span class="editRich__sep" aria-hidden="true"></span>
  <button class="editRich__btn" type="button" data-rich-block="p" title="Párrafo">¶</button>
  <button class="editRich__btn editRich__btn--serif" type="button" data-rich-block="h2" title="Título">T</button>
  <button class="editRich__btn editRich__btn--serif editRich__btn--sm" type="button" data-rich-block="h3" title="Subtítulo">t</button>
  <button class="editRich__btn editRich__btn--serif" type="button" data-rich-block="blockquote" title="Cita">❝</button>
  <span class="editRich__sep" aria-hidden="true"></span>
  <span class="editRich__hint" aria-hidden="true">Esc cancela</span>
  <button class="editRich__btn editRich__btn--done" type="button" data-rich-done>Listo</button>
</div>

<style is:global>
  .editbar{
    position: fixed;
    right: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 28px);
    z-index: 1100;
    pointer-events: auto;
    color: #F4EFE6;
    background: rgba(14, 15, 12, .92);
    border: 1px solid rgba(244, 239, 230, .14);
    border-radius: 999px;
    padding: 8px 14px;
    box-shadow:
      0 18px 40px -12px rgba(0,0,0,.55),
      0 0 0 1px rgba(244,239,230,.04) inset;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: .04em;
  }
  .editbar__row{
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 28px;
  }
  .editbar__dot{
    width: 7px; height: 7px;
    border-radius: 999px;
    background: #D9421C;
    box-shadow: 0 0 0 3px rgba(217, 66, 28, .18);
  }
  .editbar__label{
    font-size: 10.5px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, .55);
  }
  .editbar__toggle{
    appearance: none;
    background: transparent;
    border: 1px solid rgba(244, 239, 230, .22);
    color: #F4EFE6;
    border-radius: 999px;
    padding: 5px 12px;
    font: inherit;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background .25s, border-color .25s;
  }
  .editbar__toggle:hover{ border-color: rgba(244, 239, 230, .45); }
  .editbar__toggle[aria-pressed="true"]{
    background: rgba(217, 66, 28, .14);
    border-color: rgba(217, 66, 28, .55);
  }
  .editbar__toggleDot{
    width: 6px; height: 6px;
    border-radius: 999px;
    background: rgba(244, 239, 230, .35);
    transition: background .25s;
  }
  .editbar__toggle[aria-pressed="true"] .editbar__toggleDot{
    background: #D9421C;
  }
  .editbar__toggle--small{
    padding: 4px 10px;
    font-size: 10.5px;
    letter-spacing: .12em;
  }
  .editbar__toggle[aria-pressed="true"][data-edit-publish] .editbar__toggleDot{
    background: #9DBE8A;
  }
  .editbar__toggle[data-edit-publish]{
    background: rgba(157, 190, 138, .08);
    border-color: rgba(157, 190, 138, .35);
  }
  .editbar__toggle[data-edit-publish][aria-pressed="false"]{
    background: transparent;
    border-color: rgba(244, 239, 230, .22);
  }
  .editbar__sep{
    width: 1px;
    height: 14px;
    background: rgba(244, 239, 230, .14);
  }
  .editbar__delete{
    appearance: none;
    background: transparent;
    border: 1px solid rgba(226, 125, 90, .35);
    color: #E27D5A;
    font: inherit;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 10.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 4px 10px;
    cursor: pointer;
    transition: background .2s, border-color .2s, color .2s;
  }
  .editbar__delete:hover{
    background: rgba(226, 125, 90, .12);
    border-color: rgba(226, 125, 90, .7);
    color: #E27D5A;
  }
  .editbar__delete[data-busy="1"],
  .editbar__toggle[data-busy="1"]{
    opacity: .65;
    pointer-events: none;
  }
  .editbar__create{
    appearance: none;
    background: rgba(157, 190, 138, .14);
    border: 1px solid rgba(157, 190, 138, .55);
    color: #C8DCBA;
    font: inherit;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background .2s, border-color .2s, color .2s;
  }
  .editbar__create:hover{
    background: rgba(157, 190, 138, .22);
    border-color: rgba(157, 190, 138, .8);
    color: #F4EFE6;
  }
  .editbar__create[data-busy="1"]{
    opacity: .65;
    pointer-events: none;
  }
  .editbar__status{
    font-size: 11px;
    color: rgba(244, 239, 230, .55);
    min-width: 0;
    transition: color .25s, opacity .35s;
  }
  .editbar__status[data-state="saving"]{ color: rgba(244, 239, 230, .75); }
  .editbar__status[data-state="saved"]{ color: #9DBE8A; }
  .editbar__status[data-state="error"]{ color: #E27D5A; }
  .editbar__link{
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, .55);
    transition: color .25s;
  }
  .editbar__link:hover{ color: #F4EFE6; }
  .editbar__logout{ display: contents; }
  button.editbar__link{ background: none; border: 0; padding: 0; font: inherit; cursor: pointer; }

  /* Visual affordance applied to editable fields when edit mode is on.
     Scoped to <html data-edit-mode="1"> so the public site is untouched
     when the toggle is off. */
  html[data-edit-mode="1"] [data-edit-field]{
    outline: 1px dashed rgba(217, 66, 28, .35);
    outline-offset: 4px;
    cursor: text;
    transition: outline-color .25s, background-color .25s;
  }
  html[data-edit-mode="1"] [data-edit-field]:hover{
    outline-color: rgba(217, 66, 28, .85);
    background-color: rgba(217, 66, 28, .04);
  }
  html[data-edit-mode="1"] [data-edit-field][data-editing="1"]{
    outline-style: solid;
    outline-color: #D9421C;
    background-color: rgba(217, 66, 28, .08);
  }

  /* Image-edit affordance — a "Cambiar foto" badge overlaid on any
     element with data-edit-image-field. Scoped the same way so it
     only appears in admin edit mode. */
  html[data-edit-mode="1"] [data-edit-image-field]{
    outline: 1px dashed rgba(217, 66, 28, .35);
    outline-offset: 0;
  }
  html[data-edit-mode="1"] [data-edit-image-field]:hover{
    outline-color: rgba(217, 66, 28, .85);
  }
  .editImageBadge{
    position: absolute;
    top: clamp(12px, 2vw, 24px);
    left: clamp(12px, 2vw, 24px);
    z-index: 5;
    appearance: none;
    background: rgba(14, 15, 12, .92);
    color: #F4EFE6;
    border: 1px solid rgba(244, 239, 230, .22);
    border-radius: 999px;
    padding: 8px 14px;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,.5);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    transition: background .25s, border-color .25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .editImageBadge:hover{
    background: rgba(217, 66, 28, .85);
    border-color: rgba(217, 66, 28, .9);
  }
  .editImageBadge[data-busy="1"]{
    pointer-events: none;
    opacity: .7;
  }
  .editImageBadge__dot{
    width: 6px; height: 6px;
    border-radius: 999px;
    background: #D9421C;
    box-shadow: 0 0 0 3px rgba(217, 66, 28, .25);
  }
  /* The badge needs an absolute parent. Most data-edit-image-field
     elements are already positioned (cold__media, frame__media). */
  html[data-edit-mode="1"] [data-edit-image-field]{
    position: relative;
  }
  /* Full-bleed hosts (the landing hero) park the badge bottom-right
     so it doesn't collide with the dock brand in the top-left. */
  html[data-edit-mode="1"] [data-edit-image-field][data-edit-badge="br"] .editImageBadge{
    top: auto;
    left: auto;
    bottom: clamp(84px, 12vh, 140px);
    right: clamp(20px, 4vw, 56px);
  }

  /* Sortable lists — each [data-edit-list-field] container has child
     [data-edit-list-key] items that become drag-reorderable in edit
     mode. The grip handle is overlaid at the left edge of each item. */
  html[data-edit-mode="1"] [data-edit-list-field]{
    position: relative;
  }
  html[data-edit-mode="1"] [data-edit-list-key]{
    position: relative;
  }
  html[data-edit-mode="1"] [data-edit-list-key][draggable="true"]{
    cursor: grab;
  }
  html[data-edit-mode="1"] [data-edit-list-key].is-dragging{
    opacity: .55;
    cursor: grabbing;
  }
  html[data-edit-mode="1"] [data-edit-list-key].is-drop-target{
    box-shadow: inset 0 2px 0 0 #D9421C;
  }
  .editGrip{
    position: absolute;
    top: 50%;
    left: -28px;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(217, 66, 28, .7);
    background: rgba(14, 15, 12, .04);
    border: 1px solid rgba(217, 66, 28, .25);
    border-radius: 6px;
    cursor: grab;
    user-select: none;
    transition: background .2s, border-color .2s, color .2s;
    z-index: 4;
  }
  .editGrip:hover{
    background: rgba(217, 66, 28, .12);
    border-color: rgba(217, 66, 28, .55);
    color: #D9421C;
  }
  .editGrip svg{ width: 12px; height: 12px; display: block; }

  /* Popover modal — used for multi-paragraph and PortableText edits.
     Triggered by clicks on [data-edit-multi]. */
  .editModal{
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(20px, 4vw, 56px);
    color: #F4EFE6;
  }
  .editModal[hidden]{ display: none; }
  .editModal__bg{
    position: absolute;
    inset: 0;
    background: rgba(8, 9, 10, .72);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }
  .editModal__panel{
    position: relative;
    width: min(720px, 100%);
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(14, 15, 12, .96);
    border: 1px solid rgba(244, 239, 230, .18);
    border-radius: 14px;
    box-shadow: 0 32px 70px -20px rgba(0,0,0,.7);
    padding: 22px 22px 18px;
  }
  .editModal__head{ display: flex; flex-direction: column; gap: 4px; }
  .editModal__label{
    margin: 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, .6);
  }
  .editModal__hint{
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    color: rgba(244, 239, 230, .35);
    letter-spacing: .04em;
  }
  .editModal__textarea{
    flex: 1;
    width: 100%;
    min-height: 200px;
    background: rgba(244, 239, 230, .04);
    border: 1px solid rgba(244, 239, 230, .14);
    border-radius: 8px;
    padding: 14px 16px;
    color: #F4EFE6;
    font-family: var(--font-display, "Instrument Serif", serif);
    font-size: 17px;
    line-height: 1.55;
    resize: vertical;
    outline: none;
    transition: border-color .2s, background .2s;
  }
  .editModal__textarea:focus{
    border-color: rgba(217, 66, 28, .55);
    background: rgba(244, 239, 230, .07);
  }
  .editModal__foot{
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .editModal__btn{
    appearance: none;
    border: 1px solid rgba(244, 239, 230, .18);
    background: transparent;
    color: #F4EFE6;
    font: inherit;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background .2s, border-color .2s;
  }
  .editModal__btn:hover{ border-color: rgba(244, 239, 230, .45); }
  .editModal__btn--primary{
    background: rgba(217, 66, 28, .9);
    border-color: rgba(217, 66, 28, .9);
  }
  .editModal__btn--primary:hover{
    background: #D9421C;
    border-color: #D9421C;
  }
  .editModal__btn[data-busy="1"]{
    opacity: .7;
    pointer-events: none;
  }

  /* Floating rich-text toolbar */
  .editRich{
    position: fixed;
    z-index: 1150;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    background: rgba(14, 15, 12, .94);
    border: 1px solid rgba(244, 239, 230, .16);
    border-radius: 999px;
    box-shadow: 0 18px 40px -12px rgba(0,0,0,.55);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  .editRich[hidden]{ display: none; }
  .editRich__btn{
    appearance: none;
    background: transparent;
    border: none;
    color: #F4EFE6;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border-radius: 999px;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 13px;
    cursor: pointer;
    transition: background .2s, color .2s;
  }
  .editRich__btn:hover{ background: rgba(244, 239, 230, .12); }
  .editRich__btn--serif{ font-family: var(--font-display, serif); font-size: 15px; }
  .editRich__btn--sm{ font-size: 12px; }
  .editRich__btn--done{
    background: rgba(217, 66, 28, .9);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 0 14px;
  }
  .editRich__btn--done:hover{ background: #D9421C; }
  .editRich__sep{
    width: 1px;
    height: 16px;
    margin: 0 4px;
    background: rgba(244, 239, 230, .14);
  }
  .editRich__hint{
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10px;
    color: rgba(244, 239, 230, .4);
    padding: 0 6px;
    letter-spacing: .04em;
  }

  /* Portable (rich) fields keep the dashed affordance from
     [data-edit-field]; during a session the container needs room to
     type even when empty, and a calmer solid outline. */
  html[data-edit-mode="1"] [data-edit-portable]{ min-height: 1.6em; }
  html[data-edit-mode="1"] [data-edit-portable][data-editing="1"]{
    outline-style: solid;
    outline-color: rgba(217, 66, 28, .8);
    background-color: rgba(217, 66, 28, .05);
  }
  [data-edit-portable] .pt[contenteditable="true"]{
    outline: none;
    caret-color: #D9421C;
  }
</style>

<script>
  /* Inline-edit script — runs once per page load. Idempotent across
   * Astro ClientRouter swaps via a window flag + page-load rebind. */

  import { blocksToHtml } from "../../lib/portable";

  declare global {
    interface Window {
      __dnInlineEditBooted?: boolean;
    }
  }

  type PtSpan = { _type: "span"; _key: string; text: string; marks: string[] };
  type PtMarkDef = { _type: "link"; _key: string; href: string };
  type PtBlock = {
    _type: "block";
    _key: string;
    style: "normal" | "h2" | "h3" | "blockquote";
    children: PtSpan[];
    markDefs: PtMarkDef[];
  };

  function boot() {
    if (window.__dnInlineEditBooted) {
      // Re-run setup on a swap so newly-rendered fields get bound.
      bindFields();
      bindEntityActions();
      return;
    }
    window.__dnInlineEditBooted = true;

    const toggleBtn = document.querySelector<HTMLButtonElement>("[data-edit-toggle]");
    const toggleLabel = document.querySelector<HTMLElement>("[data-edit-toggle-label]");
    const statusEl = document.querySelector<HTMLElement>("[data-edit-status]");

    function setStatus(text: string, state: "" | "saving" | "saved" | "error" = "") {
      if (!statusEl) return;
      statusEl.textContent = text;
      if (state) statusEl.dataset.state = state;
      else delete statusEl.dataset.state;
    }

    function setMode(on: boolean) {
      document.documentElement.dataset.editMode = on ? "1" : "";
      if (toggleBtn) toggleBtn.setAttribute("aria-pressed", on ? "true" : "false");
      if (toggleLabel) toggleLabel.textContent = on ? "Editando" : "Editar";
      if (!on) setStatus("");
    }

    toggleBtn?.addEventListener("click", () => {
      const on = document.documentElement.dataset.editMode !== "1";
      setMode(on);
      try { localStorage.setItem("dn_edit_mode", on ? "1" : "0"); } catch {}
    });

    // Persist toggle state across navigations.
    try {
      if (localStorage.getItem("dn_edit_mode") === "1") setMode(true);
    } catch {}

    bindFields();
    bindEntityActions();

    document.addEventListener("astro:page-load", () => {
      bindFields();
      bindEntityActions();
    });
  }

  function bindFields() {
    document.querySelectorAll<HTMLElement>("[data-edit-field]").forEach((el) => {
      const e = el as HTMLElement & { __dnEditBound?: boolean };
      if (e.__dnEditBound) return;
      e.__dnEditBound = true;

      el.addEventListener("click", (ev) => {
        if (document.documentElement.dataset.editMode !== "1") return;
        if (el.dataset.editing === "1") return;
        // Let links inside an already-rendered rich body behave
        // normally outside edit mode; in edit mode we take over.
        ev.preventDefault();
        if (el.dataset.editPortable === "1") beginPortableEdit(el);
        else if (el.dataset.editMulti === "1") beginModalEdit(el);
        else beginEdit(el);
      });
    });

    // Image fields — render a "Cambiar foto" badge overlay so the
    // image surface itself stays clean. Click → opens the file picker.
    document.querySelectorAll<HTMLElement>("[data-edit-image-field]").forEach((host) => {
      const h = host as HTMLElement & { __dnImgBound?: boolean };
      if (h.__dnImgBound) return;
      h.__dnImgBound = true;

      const field = host.dataset.editImageField ?? "";
      if (!field) return;

      const badge = document.createElement("button");
      badge.type = "button";
      badge.className = "editImageBadge";
      badge.innerHTML =
        '<span class="editImageBadge__dot" aria-hidden="true"></span>' +
        '<span>Cambiar foto</span>';
      badge.addEventListener("click", (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        beginImagePick(host, badge, field);
      });
      host.appendChild(badge);
    });

    // Sortable lists — each child gets a drag handle and the parent
    // listens for drops to compute the new order.
    document.querySelectorAll<HTMLElement>("[data-edit-list-field]").forEach((list) => {
      const l = list as HTMLElement & { __dnListBound?: boolean };
      if (l.__dnListBound) return;
      l.__dnListBound = true;
      bindSortableList(list);
    });
  }

  /** Wire the Publish toggle and Delete button to the entity-action
   *  endpoint when the page advertises an editContext via data
   *  attributes on the toolbar. Idempotent — bindEntityActions reads
   *  the same DOM each call, but flags handlers so we don't double-bind. */
  function bindEntityActions() {
    const bar = document.querySelector<HTMLElement>("[data-editbar]");
    if (!bar) return;
    const entity = bar.dataset.editEntity;
    const id = bar.dataset.editEntityId;
    const indexHref = bar.dataset.editEntityIndex ?? "/admin";
    if (!entity || !id) return;

    const pubBtn = document.querySelector<HTMLButtonElement>("[data-edit-publish]");
    const pubLabel = document.querySelector<HTMLElement>("[data-edit-publish-label]");
    const delBtn = document.querySelector<HTMLButtonElement>("[data-edit-delete]");
    const status = document.querySelector<HTMLElement>("[data-edit-status]");

    if (pubBtn && !(pubBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound) {
      (pubBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound = true;
      pubBtn.addEventListener("click", async () => {
        const wasPublished = pubBtn.getAttribute("aria-pressed") === "true";
        const action = wasPublished ? "unpublish" : "publish";
        pubBtn.dataset.busy = "1";
        if (status) {
          status.textContent = wasPublished ? "Despublicando…" : "Publicando…";
          status.dataset.state = "saving";
        }
        try {
          const res = await fetch("/api/admin/entity-action", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ entity, id, action }),
          });
          if (!res.ok) throw new Error(await res.text());
          pubBtn.setAttribute("aria-pressed", wasPublished ? "false" : "true");
          if (pubLabel) pubLabel.textContent = wasPublished ? "Borrador" : "Publicado";
          if (status) {
            status.textContent = wasPublished ? "En borrador" : "Publicado";
            status.dataset.state = "saved";
          }
        } catch (err) {
          if (status) {
            status.textContent = "Error";
            status.dataset.state = "error";
          }
          // eslint-disable-next-line no-console
          console.error("[entity-action] publish failed", err);
        } finally {
          delete pubBtn.dataset.busy;
        }
      });
    }

    const createEntity = bar.dataset.editCreateEntity;
    const createBtn = document.querySelector<HTMLButtonElement>("[data-edit-create]");
    if (createEntity && createBtn && !(createBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound) {
      (createBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound = true;
      createBtn.addEventListener("click", async () => {
        createBtn.dataset.busy = "1";
        if (status) {
          status.textContent = "Creando…";
          status.dataset.state = "saving";
        }
        try {
          const res = await fetch("/api/admin/entity-create", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ entity: createEntity }),
          });
          if (!res.ok) throw new Error(await res.text());
          const { url } = (await res.json()) as { url: string };
          // Persist edit-mode so the new page lands ready to edit.
          try { localStorage.setItem("dn_edit_mode", "1"); } catch {}
          window.location.href = url;
        } catch (err) {
          if (status) {
            status.textContent = "Error al crear";
            status.dataset.state = "error";
          }
          // eslint-disable-next-line no-console
          console.error("[entity-create] failed", err);
          delete createBtn.dataset.busy;
        }
      });
    }

    if (delBtn && !(delBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound) {
      (delBtn as HTMLButtonElement & { __dnBound?: boolean }).__dnBound = true;
      delBtn.addEventListener("click", async () => {
        const ok = window.confirm(
          "¿Borrar para siempre? Esta acción no se puede deshacer.",
        );
        if (!ok) return;
        delBtn.dataset.busy = "1";
        if (status) {
          status.textContent = "Borrando…";
          status.dataset.state = "saving";
        }
        try {
          const res = await fetch("/api/admin/entity-action", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ entity, id, action: "delete" }),
          });
          if (!res.ok) throw new Error(await res.text());
          if (status) {
            status.textContent = "Borrado";
            status.dataset.state = "saved";
          }
          // Redirect to the index page so the admin doesn't sit on a
          // 404 of a now-deleted detail page.
          setTimeout(() => { window.location.href = indexHref; }, 400);
        } catch (err) {
          if (status) {
            status.textContent = "Error al borrar";
            status.dataset.state = "error";
          }
          // eslint-disable-next-line no-console
          console.error("[entity-action] delete failed", err);
          delete delBtn.dataset.busy;
        }
      });
    }
  }

  /** HTML5-drag-based sortable list. Each child must declare
   *  [data-edit-list-key="<key>"]; the parent's [data-edit-list-field]
   *  is the field path the new comma-separated order is saved to. */
  function bindSortableList(list: HTMLElement) {
    const field = list.dataset.editListField ?? "";
    if (!field) return;

    const itemSel = "[data-edit-list-key]";
    let dragKey: string | null = null;

    function getItems(): HTMLElement[] {
      return Array.from(list.querySelectorAll<HTMLElement>(`:scope > ${itemSel}`));
    }

    function attachItem(item: HTMLElement) {
      // Drag handle (only renders once)
      if (!item.querySelector(":scope > .editGrip")) {
        const grip = document.createElement("span");
        grip.className = "editGrip";
        grip.setAttribute("aria-hidden", "true");
        grip.innerHTML =
          '<svg viewBox="0 0 12 12"><circle cx="3" cy="3" r="1" fill="currentColor"/><circle cx="3" cy="6" r="1" fill="currentColor"/><circle cx="3" cy="9" r="1" fill="currentColor"/><circle cx="9" cy="3" r="1" fill="currentColor"/><circle cx="9" cy="6" r="1" fill="currentColor"/><circle cx="9" cy="9" r="1" fill="currentColor"/></svg>';
        item.appendChild(grip);
      }
    }

    function refresh() {
      const editing = document.documentElement.dataset.editMode === "1";
      getItems().forEach((item) => {
        attachItem(item);
        item.draggable = editing;
      });
    }
    refresh();

    // Re-evaluate when edit mode toggles.
    const observer = new MutationObserver(refresh);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-edit-mode"] });

    list.addEventListener("dragstart", (ev) => {
      const target = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      if (!target) return;
      dragKey = target.dataset.editListKey ?? null;
      target.classList.add("is-dragging");
      ev.dataTransfer?.setData("text/plain", dragKey ?? "");
      if (ev.dataTransfer) ev.dataTransfer.effectAllowed = "move";
    });

    list.addEventListener("dragend", () => {
      getItems().forEach((i) => i.classList.remove("is-dragging", "is-drop-target"));
      dragKey = null;
    });

    list.addEventListener("dragover", (ev) => {
      if (!dragKey) return;
      ev.preventDefault();
      const over = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      if (!over) return;
      getItems().forEach((i) => {
        i.classList.toggle("is-drop-target", i === over && i.dataset.editListKey !== dragKey);
      });
    });

    list.addEventListener("drop", async (ev) => {
      if (!dragKey) return;
      ev.preventDefault();
      const over = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      const source = list.querySelector<HTMLElement>(`${itemSel}[data-edit-list-key="${dragKey}"]`);
      if (!source || !over || source === over) return;

      // Decide insertion side based on cursor Y vs midpoint.
      const r = over.getBoundingClientRect();
      const before = ev.clientY < r.top + r.height / 2;
      list.insertBefore(source, before ? over : over.nextSibling);

      const newOrder = getItems().map((i) => i.dataset.editListKey ?? "").filter(Boolean).join(",");
      await saveField(field, newOrder, () => {
        // On error, the previous server-side order is the source of
        // truth; a reload restores it.
        window.location.reload();
      });

      getItems().forEach((i) => i.classList.remove("is-dragging", "is-drop-target"));
    });
  }

  /* ── In-place rich text editing ─────────────────────────────────
   * The rendered Portable Text body itself becomes contentEditable.
   * A floating toolbar offers bold / italic / link / block styles.
   * On commit the DOM is serialized back to blocks and POSTed; the
   * DOM is then re-rendered from the same serializer the server and
   * public renderer share, so view === storage. No page reload. */

  /** Serialize the edited DOM back into Portable Text blocks.
   *  Deterministic keys so snapshots can be compared for dirtiness. */
  function domToBlocks(root: HTMLElement): PtBlock[] {
    const blocks: PtBlock[] = [];
    Array.from(root.children).forEach((child) => {
      const tag = child.tagName.toLowerCase();
      const style = (tag === "h2" || tag === "h3" || tag === "blockquote" ? tag : "normal") as PtBlock["style"];
      const bi = blocks.length;
      const defs: PtMarkDef[] = [];
      const spans: PtSpan[] = [];
      let defN = 0;

      const visit = (node: Node, marks: string[]) => {
        if (node.nodeType === Node.TEXT_NODE) {
          const text = node.nodeValue ?? "";
          if (text) spans.push({ _type: "span", _key: "", text, marks });
          return;
        }
        if (node.nodeType !== Node.ELEMENT_NODE) return;
        const elm = node as HTMLElement;
        const t = elm.tagName.toLowerCase();
        if (t === "br") {
          spans.push({ _type: "span", _key: "", text: "\n", marks });
          return;
        }
        let next = marks;
        if (t === "b" || t === "strong") next = marks.includes("strong") ? marks : [...marks, "strong"];
        else if (t === "i" || t === "em") next = marks.includes("em") ? marks : [...marks, "em"];
        else if (t === "a") {
          const href = elm.getAttribute("href") ?? "";
          if (/^(https?:\/\/|mailto:)/i.test(href)) {
            const key = `b${bi}l${defN++}`;
            defs.push({ _type: "link", _key: key, href });
            next = [...marks, key];
          }
        }
        elm.childNodes.forEach((ch) => visit(ch, next));
      };
      child.childNodes.forEach((ch) => visit(ch, []));

      // Merge adjacent spans with identical marks, trim trailing breaks.
      const merged: PtSpan[] = [];
      for (const s of spans) {
        const prev = merged[merged.length - 1];
        if (prev && prev.marks.join("|") === s.marks.join("|")) prev.text += s.text;
        else merged.push({ ...s, marks: [...s.marks] });
      }
      while (merged.length) {
        const last = merged[merged.length - 1];
        last.text = last.text.replace(/\n+$/, "");
        if (last.text) break;
        merged.pop();
      }
      if (!merged.some((s) => s.text.trim())) return;
      merged.forEach((s, si) => { s._key = `s${bi}-${si}`; });
      blocks.push({ _type: "block", _key: `b${bi}`, style, children: merged, markDefs: defs });
    });
    return blocks;
  }

  function execFormatBlock(tag: string) {
    // Firefox wants the bare tag; older WebKit wanted angle brackets.
    if (!document.execCommand("formatBlock", false, tag)) {
      document.execCommand("formatBlock", false, `<${tag}>`);
    }
  }

  function selectionAnchor(): HTMLAnchorElement | null {
    const sel = window.getSelection();
    let node: Node | null = sel?.anchorNode ?? null;
    while (node) {
      if (node instanceof HTMLAnchorElement) return node;
      node = node.parentNode;
    }
    return null;
  }

  function beginPortableEdit(el: HTMLElement) {
    const field = el.dataset.editField;
    const bar = document.querySelector<HTMLElement>("[data-edit-rich]");
    if (!field || !bar) return;

    // The editable surface is the rendered .pt body when present
    // (the wrapper may also hold non-editable chrome), else el itself.
    const container = el.querySelector<HTMLElement>(":scope .pt") ?? el;
    const originalHTML = container.innerHTML;
    // Fields flagged data-edit-empty render an admin-facing placeholder
    // ("añade la bio…") that must not be serialized as content.
    if (el.dataset.editEmpty === "1") container.innerHTML = "";
    const originalBlocks = JSON.stringify(domToBlocks(container));

    el.dataset.editing = "1";
    container.contentEditable = "true";
    container.spellcheck = true;
    try { document.execCommand("defaultParagraphSeparator", false, "p"); } catch {}
    if (!container.children.length) container.innerHTML = "<p><br></p>";
    container.focus();

    bar.hidden = false;
    const place = () => {
      const r = el.getBoundingClientRect();
      const top = Math.max(12, Math.min(r.top - bar.offsetHeight - 12, window.innerHeight - bar.offsetHeight - 12));
      const left = Math.min(Math.max(12, r.left), Math.max(12, window.innerWidth - bar.offsetWidth - 12));
      bar.style.top = `${top}px`;
      bar.style.left = `${left}px`;
    };
    place();
    let raf = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(place);
    };

    let done = false;
    const finish = async (commit: boolean) => {
      if (done) return;
      done = true;
      container.contentEditable = "false";
      delete el.dataset.editing;
      bar.hidden = true;
      window.removeEventListener("scroll", onScroll, true);
      window.removeEventListener("resize", onScroll);
      bar.removeEventListener("mousedown", onBarDown);
      bar.removeEventListener("click", onBarClick);
      container.removeEventListener("keydown", onKey);
      document.removeEventListener("mousedown", onDocDown, true);

      if (!commit) {
        container.innerHTML = originalHTML;
        return;
      }
      const blocks = domToBlocks(container);
      if (JSON.stringify(blocks) === originalBlocks) {
        container.innerHTML = originalHTML; // normalize any editing artifacts
        return;
      }
      const ok = await postSave({ field, blocks }, () => {
        container.innerHTML = originalHTML;
      });
      // Re-render from the canonical serializer so the DOM matches
      // exactly what the database now holds (and what SSR will emit).
      if (ok) {
        container.innerHTML = blocksToHtml(blocks) || "";
        if (blocks.length) delete el.dataset.editEmpty;
      }
    };

    const onBarDown = (ev: MouseEvent) => {
      // Keep the text selection alive while clicking toolbar buttons.
      ev.preventDefault();
    };
    const onBarClick = (ev: MouseEvent) => {
      const btn = (ev.target as HTMLElement | null)?.closest<HTMLButtonElement>("button");
      if (!btn) return;
      ev.preventDefault();
      if (btn.dataset.richDone !== undefined) { void finish(true); return; }
      if (btn.dataset.richBlock) { execFormatBlock(btn.dataset.richBlock); return; }
      const cmd = btn.dataset.richCmd;
      if (cmd === "bold") document.execCommand("bold");
      else if (cmd === "italic") document.execCommand("italic");
      else if (cmd === "link") {
        if (selectionAnchor()) {
          document.execCommand("unlink");
        } else {
          const url = window.prompt("URL del enlace", "https://");
          if (url && /^(https?:\/\/|mailto:).{3,}/i.test(url.trim())) {
            document.execCommand("createLink", false, url.trim());
          }
        }
      }
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") { e.preventDefault(); void finish(false); }
      else if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) { e.preventDefault(); void finish(true); }
    };
    const onDocDown = (e: MouseEvent) => {
      const t = e.target as Node;
      if (container.contains(t) || bar.contains(t)) return;
      void finish(true); // click-away commits — feels like just touching the page
    };

    window.addEventListener("scroll", onScroll, true);
    window.addEventListener("resize", onScroll);
    bar.addEventListener("mousedown", onBarDown);
    bar.addEventListener("click", onBarClick);
    container.addEventListener("keydown", onKey);
    setTimeout(() => document.addEventListener("mousedown", onDocDown, true), 0);
  }

  function beginEdit(el: HTMLElement) {
    const field = el.dataset.editField;
    if (!field) return;

    const original = (el.textContent ?? "").trim();
    el.dataset.editing = "1";
    el.contentEditable = "plaintext-only";
    el.spellcheck = true;
    el.focus();

    // Place caret at end.
    try {
      const range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    } catch {}

    let cancelled = false;
    let autosaveT: ReturnType<typeof setTimeout> | null = null;
    let autosaved = false;

    // Debounced autosave while typing — Daniel never has to think
    // about saving; the field persists itself as he writes.
    const onInput = () => {
      if (autosaveT) clearTimeout(autosaveT);
      autosaveT = setTimeout(() => {
        const v = (el.textContent ?? "").trim();
        if (v !== original) {
          autosaved = true;
          void saveField(field, v, () => {});
        }
      }, 900);
    };

    const cleanup = () => {
      if (autosaveT) clearTimeout(autosaveT);
      el.contentEditable = "false";
      delete el.dataset.editing;
      el.removeEventListener("keydown", onKey);
      el.removeEventListener("blur", onBlur);
      el.removeEventListener("input", onInput);
    };

    const commit = async () => {
      const value = (el.textContent ?? "").trim();
      cleanup();
      if (cancelled) {
        el.textContent = original;
        // An autosave may already have written intermediate text —
        // restore the server to the pre-edit value too.
        if (autosaved) void saveField(field, original, () => {});
        return;
      }
      if (value === original && !autosaved) return;
      await saveField(field, value, () => {
        // Revert if save fails.
        el.textContent = original;
      });
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        el.blur();
      } else if (e.key === "Escape") {
        e.preventDefault();
        cancelled = true;
        el.blur();
      }
    };

    const onBlur = () => {
      // Defer commit so onKey for Enter fires first.
      queueMicrotask(commit);
    };

    el.addEventListener("keydown", onKey);
    el.addEventListener("blur", onBlur);
    el.addEventListener("input", onInput);
  }

  /** Multi-line modal edit. Used when a field is too long for inline
   *  contentEditable — multi-paragraph copy or PortableText body. The
   *  initial textarea value is read from data-edit-source if present
   *  (admin-only attribute carrying the raw text), otherwise from the
   *  rendered textContent. */
  function beginModalEdit(el: HTMLElement) {
    const field = el.dataset.editField;
    if (!field) return;

    const modal = document.querySelector<HTMLElement>("[data-edit-modal]");
    const textarea = document.querySelector<HTMLTextAreaElement>("[data-edit-modal-textarea]");
    const labelEl = document.querySelector<HTMLElement>("[data-edit-modal-label]");
    const saveBtn = document.querySelector<HTMLButtonElement>("[data-edit-modal-save]");
    const cancelBtn = document.querySelector<HTMLButtonElement>("[data-edit-modal-cancel]");
    const bg = document.querySelector<HTMLElement>("[data-edit-modal-bg]");
    if (!modal || !textarea || !saveBtn || !cancelBtn || !bg) return;

    const sourceText = el.dataset.editSource ?? (el.textContent ?? "").trim();
    const original = sourceText;

    if (labelEl) labelEl.textContent = `Editar · ${field}`;
    textarea.value = sourceText;
    modal.hidden = false;
    modal.setAttribute("aria-hidden", "false");
    setTimeout(() => textarea.focus(), 30);

    let closed = false;
    const close = () => {
      if (closed) return;
      closed = true;
      modal.hidden = true;
      modal.setAttribute("aria-hidden", "true");
      saveBtn.removeEventListener("click", onSave);
      cancelBtn.removeEventListener("click", close);
      bg.removeEventListener("click", close);
      window.removeEventListener("keydown", onKey);
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if ((e.key === "Enter") && (e.metaKey || e.ctrlKey)) { e.preventDefault(); onSave(); }
    };

    const onSave = async () => {
      const next = textarea.value;
      if (next === original) { close(); return; }
      saveBtn.dataset.busy = "1";
      const ok = await saveField(field, next, () => {});
      delete saveBtn.dataset.busy;
      close();
      // Update the page in place — no reload. The element shows the
      // new text immediately and the next edit starts from it.
      if (ok) {
        el.dataset.editSource = next;
        el.textContent = next;
      }
    };

    saveBtn.addEventListener("click", onSave);
    cancelBtn.addEventListener("click", close);
    bg.addEventListener("click", close);
    window.addEventListener("keydown", onKey);
  }

  /** Image-pick flow: open the hidden <input type=file>, upload via
   *  /api/admin/upload, save the URL via /api/admin/inline-edit, then
   *  swap the visible <img> in place (video-poster hosts and hosts
   *  with no <img> yet soft-reload instead). */
  function beginImagePick(host: HTMLElement, badge: HTMLButtonElement, field: string) {
    const input = document.querySelector<HTMLInputElement>("[data-edit-image-input]");
    if (!input) return;

    const onChange = async () => {
      input.removeEventListener("change", onChange);
      const file = input.files?.[0];
      input.value = "";
      if (!file) return;

      badge.dataset.busy = "1";
      const status = document.querySelector<HTMLElement>("[data-edit-status]");
      if (status) {
        status.textContent = "Subiendo foto…";
        status.dataset.state = "saving";
      }

      try {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("folder", "landing");
        const upRes = await fetch("/api/admin/upload", { method: "POST", body: fd });
        if (!upRes.ok) throw new Error(await upRes.text());
        const { url } = (await upRes.json()) as { url?: string };
        if (!url) throw new Error("Upload returned no URL");

        const ok = await saveField(field, url, () => {});
        if (ok) {
          // Swap the visible image in place — no reload. WebGL planes
          // and video posters regenerate from markup, so those (and
          // hosts with no <img> yet) still soft-reload.
          const img = host.querySelector<HTMLImageElement>("img");
          const complex = host.querySelector("canvas, video");
          if (img && !complex) {
            img.removeAttribute("srcset");
            img.style.backgroundImage = "";
            img.classList.remove("is-loaded");
            img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
            img.src = url;
          } else {
            setTimeout(() => window.location.reload(), 600);
          }
        }
      } catch (err) {
        if (status) {
          status.textContent = "Error subiendo foto";
          status.dataset.state = "error";
        }
        // eslint-disable-next-line no-console
        console.error("[inline-edit] image upload failed", err);
      } finally {
        delete badge.dataset.busy;
        void host;
      }
    };
    input.addEventListener("change", onChange);
    input.click();
  }

  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  async function postSave(
    payload: { field: string; value?: string; blocks?: PtBlock[] },
    onError: () => void,
  ): Promise<boolean> {
    const status = document.querySelector<HTMLElement>("[data-edit-status]");
    if (status) {
      status.textContent = "Guardando…";
      status.dataset.state = "saving";
    }
    try {
      const res = await fetch("/api/admin/inline-edit", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg || `${res.status}`);
      }
      if (status) {
        status.textContent = "Guardado";
        status.dataset.state = "saved";
      }
      // Fade the status back out after 2.5s.
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        if (status) {
          status.textContent = "";
          delete status.dataset.state;
        }
      }, 2500);
      return true;
    } catch (err) {
      if (status) {
        status.textContent = "Error al guardar";
        status.dataset.state = "error";
      }
      onError();
      // eslint-disable-next-line no-console
      console.error("[inline-edit] save failed", err);
      return false;
    }
  }

  function saveField(field: string, value: string, onError: () => void): Promise<boolean> {
    return postSave({ field, value }, onError);
  }

  if (document.readyState === "complete") boot();
  else window.addEventListener("load", boot, { once: true });
  document.addEventListener("astro:page-load", boot);
</script>

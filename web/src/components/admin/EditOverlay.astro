---
/**
 * EditOverlay — inline-edit affordance for admins on the public site.
 *
 * Mounted by BaseLayout when Astro.locals.isAdmin is true. Renders a
 * floating toolbar at the bottom-right and attaches click-to-edit
 * behaviour to every element on the page that carries a
 * data-edit-field="entity.field" attribute.
 *
 * UX:
 *   - "Editar" toggle in the toolbar turns edit mode on/off
 *   - Hovered editable element: subtle outline, dotted underline
 *   - Click in edit mode: element becomes contentEditable
 *   - Enter (or blur) commits via /api/admin/inline-edit
 *   - Escape reverts the field to its pre-edit value
 *   - Save state shown in toolbar ("Guardado · 2s")
 *
 * Server-rendered as nothing for non-admin visitors.
 */
---

<div class="editbar" data-editbar role="region" aria-label="Editor en línea">
  <div class="editbar__row">
    <span class="editbar__dot" aria-hidden="true"></span>
    <span class="editbar__label">Admin</span>
    <button class="editbar__toggle" type="button" data-edit-toggle aria-pressed="false">
      <span class="editbar__toggleDot" aria-hidden="true"></span>
      <span data-edit-toggle-label>Editar</span>
    </button>
    <span class="editbar__status" data-edit-status aria-live="polite"></span>
    <a class="editbar__link" href="/admin">Panel ↗</a>
    <a class="editbar__link" href="/admin/logout">Salir</a>
  </div>
</div>
<input
  type="file"
  accept="image/*"
  data-edit-image-input
  hidden
  aria-hidden="true"
/>

<style is:global>
  .editbar{
    position: fixed;
    right: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 28px);
    z-index: 1100;
    pointer-events: auto;
    color: #F4EFE6;
    background: rgba(14, 15, 12, .92);
    border: 1px solid rgba(244, 239, 230, .14);
    border-radius: 999px;
    padding: 8px 14px;
    box-shadow:
      0 18px 40px -12px rgba(0,0,0,.55),
      0 0 0 1px rgba(244,239,230,.04) inset;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 12px;
    letter-spacing: .04em;
  }
  .editbar__row{
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 28px;
  }
  .editbar__dot{
    width: 7px; height: 7px;
    border-radius: 999px;
    background: #D9421C;
    box-shadow: 0 0 0 3px rgba(217, 66, 28, .18);
  }
  .editbar__label{
    font-size: 10.5px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, .55);
  }
  .editbar__toggle{
    appearance: none;
    background: transparent;
    border: 1px solid rgba(244, 239, 230, .22);
    color: #F4EFE6;
    border-radius: 999px;
    padding: 5px 12px;
    font: inherit;
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background .25s, border-color .25s;
  }
  .editbar__toggle:hover{ border-color: rgba(244, 239, 230, .45); }
  .editbar__toggle[aria-pressed="true"]{
    background: rgba(217, 66, 28, .14);
    border-color: rgba(217, 66, 28, .55);
  }
  .editbar__toggleDot{
    width: 6px; height: 6px;
    border-radius: 999px;
    background: rgba(244, 239, 230, .35);
    transition: background .25s;
  }
  .editbar__toggle[aria-pressed="true"] .editbar__toggleDot{
    background: #D9421C;
  }
  .editbar__status{
    font-size: 11px;
    color: rgba(244, 239, 230, .55);
    min-width: 0;
    transition: color .25s, opacity .35s;
  }
  .editbar__status[data-state="saving"]{ color: rgba(244, 239, 230, .75); }
  .editbar__status[data-state="saved"]{ color: #9DBE8A; }
  .editbar__status[data-state="error"]{ color: #E27D5A; }
  .editbar__link{
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(244, 239, 230, .55);
    transition: color .25s;
  }
  .editbar__link:hover{ color: #F4EFE6; }

  /* Visual affordance applied to editable fields when edit mode is on.
     Scoped to <html data-edit-mode="1"> so the public site is untouched
     when the toggle is off. */
  html[data-edit-mode="1"] [data-edit-field]{
    outline: 1px dashed rgba(217, 66, 28, .35);
    outline-offset: 4px;
    cursor: text;
    transition: outline-color .25s, background-color .25s;
  }
  html[data-edit-mode="1"] [data-edit-field]:hover{
    outline-color: rgba(217, 66, 28, .85);
    background-color: rgba(217, 66, 28, .04);
  }
  html[data-edit-mode="1"] [data-edit-field][data-editing="1"]{
    outline-style: solid;
    outline-color: #D9421C;
    background-color: rgba(217, 66, 28, .08);
  }

  /* Image-edit affordance — a "Cambiar foto" badge overlaid on any
     element with data-edit-image-field. Scoped the same way so it
     only appears in admin edit mode. */
  html[data-edit-mode="1"] [data-edit-image-field]{
    outline: 1px dashed rgba(217, 66, 28, .35);
    outline-offset: 0;
  }
  html[data-edit-mode="1"] [data-edit-image-field]:hover{
    outline-color: rgba(217, 66, 28, .85);
  }
  .editImageBadge{
    position: absolute;
    top: clamp(12px, 2vw, 24px);
    left: clamp(12px, 2vw, 24px);
    z-index: 5;
    appearance: none;
    background: rgba(14, 15, 12, .92);
    color: #F4EFE6;
    border: 1px solid rgba(244, 239, 230, .22);
    border-radius: 999px;
    padding: 8px 14px;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 12px 28px -10px rgba(0,0,0,.5);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    transition: background .25s, border-color .25s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .editImageBadge:hover{
    background: rgba(217, 66, 28, .85);
    border-color: rgba(217, 66, 28, .9);
  }
  .editImageBadge[data-busy="1"]{
    pointer-events: none;
    opacity: .7;
  }
  .editImageBadge__dot{
    width: 6px; height: 6px;
    border-radius: 999px;
    background: #D9421C;
    box-shadow: 0 0 0 3px rgba(217, 66, 28, .25);
  }
  /* The badge needs an absolute parent. Most data-edit-image-field
     elements are already positioned (cold__media, frame__media). */
  html[data-edit-mode="1"] [data-edit-image-field]{
    position: relative;
  }

  /* Sortable lists — each [data-edit-list-field] container has child
     [data-edit-list-key] items that become drag-reorderable in edit
     mode. The grip handle is overlaid at the left edge of each item. */
  html[data-edit-mode="1"] [data-edit-list-field]{
    position: relative;
  }
  html[data-edit-mode="1"] [data-edit-list-key]{
    position: relative;
  }
  html[data-edit-mode="1"] [data-edit-list-key][draggable="true"]{
    cursor: grab;
  }
  html[data-edit-mode="1"] [data-edit-list-key].is-dragging{
    opacity: .55;
    cursor: grabbing;
  }
  html[data-edit-mode="1"] [data-edit-list-key].is-drop-target{
    box-shadow: inset 0 2px 0 0 #D9421C;
  }
  .editGrip{
    position: absolute;
    top: 50%;
    left: -28px;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(217, 66, 28, .7);
    background: rgba(14, 15, 12, .04);
    border: 1px solid rgba(217, 66, 28, .25);
    border-radius: 6px;
    cursor: grab;
    user-select: none;
    transition: background .2s, border-color .2s, color .2s;
    z-index: 4;
  }
  .editGrip:hover{
    background: rgba(217, 66, 28, .12);
    border-color: rgba(217, 66, 28, .55);
    color: #D9421C;
  }
  .editGrip svg{ width: 12px; height: 12px; display: block; }
</style>

<script>
  /* Inline-edit script — runs once per page load. Idempotent across
   * Astro ClientRouter swaps via a window flag + page-load rebind. */

  declare global {
    interface Window {
      __dnInlineEditBooted?: boolean;
    }
  }

  function boot() {
    if (window.__dnInlineEditBooted) {
      // Re-run setup on a swap so newly-rendered fields get bound.
      bindFields();
      return;
    }
    window.__dnInlineEditBooted = true;

    const toggleBtn = document.querySelector<HTMLButtonElement>("[data-edit-toggle]");
    const toggleLabel = document.querySelector<HTMLElement>("[data-edit-toggle-label]");
    const statusEl = document.querySelector<HTMLElement>("[data-edit-status]");

    function setStatus(text: string, state: "" | "saving" | "saved" | "error" = "") {
      if (!statusEl) return;
      statusEl.textContent = text;
      if (state) statusEl.dataset.state = state;
      else delete statusEl.dataset.state;
    }

    function setMode(on: boolean) {
      document.documentElement.dataset.editMode = on ? "1" : "";
      if (toggleBtn) toggleBtn.setAttribute("aria-pressed", on ? "true" : "false");
      if (toggleLabel) toggleLabel.textContent = on ? "Editando" : "Editar";
      if (!on) setStatus("");
    }

    toggleBtn?.addEventListener("click", () => {
      const on = document.documentElement.dataset.editMode !== "1";
      setMode(on);
      try { localStorage.setItem("dn_edit_mode", on ? "1" : "0"); } catch {}
    });

    // Persist toggle state across navigations.
    try {
      if (localStorage.getItem("dn_edit_mode") === "1") setMode(true);
    } catch {}

    bindFields();

    document.addEventListener("astro:page-load", bindFields);
  }

  function bindFields() {
    document.querySelectorAll<HTMLElement>("[data-edit-field]").forEach((el) => {
      const e = el as HTMLElement & { __dnEditBound?: boolean };
      if (e.__dnEditBound) return;
      e.__dnEditBound = true;

      el.addEventListener("click", (ev) => {
        if (document.documentElement.dataset.editMode !== "1") return;
        if (el.dataset.editing === "1") return;
        ev.preventDefault();
        beginEdit(el);
      });
    });

    // Image fields — render a "Cambiar foto" badge overlay so the
    // image surface itself stays clean. Click → opens the file picker.
    document.querySelectorAll<HTMLElement>("[data-edit-image-field]").forEach((host) => {
      const h = host as HTMLElement & { __dnImgBound?: boolean };
      if (h.__dnImgBound) return;
      h.__dnImgBound = true;

      const field = host.dataset.editImageField ?? "";
      if (!field) return;

      const badge = document.createElement("button");
      badge.type = "button";
      badge.className = "editImageBadge";
      badge.innerHTML =
        '<span class="editImageBadge__dot" aria-hidden="true"></span>' +
        '<span>Cambiar foto</span>';
      badge.addEventListener("click", (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        beginImagePick(host, badge, field);
      });
      host.appendChild(badge);
    });

    // Sortable lists — each child gets a drag handle and the parent
    // listens for drops to compute the new order.
    document.querySelectorAll<HTMLElement>("[data-edit-list-field]").forEach((list) => {
      const l = list as HTMLElement & { __dnListBound?: boolean };
      if (l.__dnListBound) return;
      l.__dnListBound = true;
      bindSortableList(list);
    });
  }

  /** HTML5-drag-based sortable list. Each child must declare
   *  [data-edit-list-key="<key>"]; the parent's [data-edit-list-field]
   *  is the field path the new comma-separated order is saved to. */
  function bindSortableList(list: HTMLElement) {
    const field = list.dataset.editListField ?? "";
    if (!field) return;

    const itemSel = "[data-edit-list-key]";
    let dragKey: string | null = null;

    function getItems(): HTMLElement[] {
      return Array.from(list.querySelectorAll<HTMLElement>(`:scope > ${itemSel}`));
    }

    function attachItem(item: HTMLElement) {
      // Drag handle (only renders once)
      if (!item.querySelector(":scope > .editGrip")) {
        const grip = document.createElement("span");
        grip.className = "editGrip";
        grip.setAttribute("aria-hidden", "true");
        grip.innerHTML =
          '<svg viewBox="0 0 12 12"><circle cx="3" cy="3" r="1" fill="currentColor"/><circle cx="3" cy="6" r="1" fill="currentColor"/><circle cx="3" cy="9" r="1" fill="currentColor"/><circle cx="9" cy="3" r="1" fill="currentColor"/><circle cx="9" cy="6" r="1" fill="currentColor"/><circle cx="9" cy="9" r="1" fill="currentColor"/></svg>';
        item.appendChild(grip);
      }
    }

    function refresh() {
      const editing = document.documentElement.dataset.editMode === "1";
      getItems().forEach((item) => {
        attachItem(item);
        item.draggable = editing;
      });
    }
    refresh();

    // Re-evaluate when edit mode toggles.
    const observer = new MutationObserver(refresh);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-edit-mode"] });

    list.addEventListener("dragstart", (ev) => {
      const target = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      if (!target) return;
      dragKey = target.dataset.editListKey ?? null;
      target.classList.add("is-dragging");
      ev.dataTransfer?.setData("text/plain", dragKey ?? "");
      if (ev.dataTransfer) ev.dataTransfer.effectAllowed = "move";
    });

    list.addEventListener("dragend", () => {
      getItems().forEach((i) => i.classList.remove("is-dragging", "is-drop-target"));
      dragKey = null;
    });

    list.addEventListener("dragover", (ev) => {
      if (!dragKey) return;
      ev.preventDefault();
      const over = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      if (!over) return;
      getItems().forEach((i) => {
        i.classList.toggle("is-drop-target", i === over && i.dataset.editListKey !== dragKey);
      });
    });

    list.addEventListener("drop", async (ev) => {
      if (!dragKey) return;
      ev.preventDefault();
      const over = (ev.target as HTMLElement | null)?.closest(itemSel) as HTMLElement | null;
      const source = list.querySelector<HTMLElement>(`${itemSel}[data-edit-list-key="${dragKey}"]`);
      if (!source || !over || source === over) return;

      // Decide insertion side based on cursor Y vs midpoint.
      const r = over.getBoundingClientRect();
      const before = ev.clientY < r.top + r.height / 2;
      list.insertBefore(source, before ? over : over.nextSibling);

      const newOrder = getItems().map((i) => i.dataset.editListKey ?? "").filter(Boolean).join(",");
      await saveField(field, newOrder, () => {
        // On error, the previous server-side order is the source of
        // truth; a reload restores it.
        window.location.reload();
      });

      getItems().forEach((i) => i.classList.remove("is-dragging", "is-drop-target"));
    });
  }

  function beginEdit(el: HTMLElement) {
    const field = el.dataset.editField;
    if (!field) return;

    const original = (el.textContent ?? "").trim();
    el.dataset.editing = "1";
    el.contentEditable = "plaintext-only";
    el.spellcheck = true;
    el.focus();

    // Place caret at end.
    try {
      const range = document.createRange();
      range.selectNodeContents(el);
      range.collapse(false);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    } catch {}

    let cancelled = false;

    const cleanup = () => {
      el.contentEditable = "false";
      delete el.dataset.editing;
      el.removeEventListener("keydown", onKey);
      el.removeEventListener("blur", onBlur);
    };

    const commit = async () => {
      const value = (el.textContent ?? "").trim();
      cleanup();
      if (cancelled || value === original) return;
      await saveField(field, value, () => {
        // Revert if save fails.
        el.textContent = original;
      });
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        el.blur();
      } else if (e.key === "Escape") {
        e.preventDefault();
        cancelled = true;
        el.textContent = original;
        el.blur();
      }
    };

    const onBlur = () => {
      // Defer commit so onKey for Enter fires first.
      queueMicrotask(commit);
    };

    el.addEventListener("keydown", onKey);
    el.addEventListener("blur", onBlur);
  }

  /** Image-pick flow: open the hidden <input type=file>, upload via
   *  /api/admin/upload, save the URL via /api/admin/inline-edit, then
   *  reload so the new asset paints (WebGLPlane regenerates its
   *  texture; CSS backgrounds re-fetch). */
  function beginImagePick(host: HTMLElement, badge: HTMLButtonElement, field: string) {
    const input = document.querySelector<HTMLInputElement>("[data-edit-image-input]");
    if (!input) return;

    const onChange = async () => {
      input.removeEventListener("change", onChange);
      const file = input.files?.[0];
      input.value = "";
      if (!file) return;

      badge.dataset.busy = "1";
      const status = document.querySelector<HTMLElement>("[data-edit-status]");
      if (status) {
        status.textContent = "Subiendo foto…";
        status.dataset.state = "saving";
      }

      try {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("folder", "landing");
        const upRes = await fetch("/api/admin/upload", { method: "POST", body: fd });
        if (!upRes.ok) throw new Error(await upRes.text());
        const { url } = (await upRes.json()) as { url?: string };
        if (!url) throw new Error("Upload returned no URL");

        await saveField(field, url, () => {});
        // Soft reload so the WebGLPlane / posters reflect the new src.
        // Defer slightly so the user sees the "Guardado" status briefly.
        setTimeout(() => window.location.reload(), 600);
      } catch (err) {
        if (status) {
          status.textContent = "Error subiendo foto";
          status.dataset.state = "error";
        }
        // eslint-disable-next-line no-console
        console.error("[inline-edit] image upload failed", err);
      } finally {
        delete badge.dataset.busy;
        void host;
      }
    };
    input.addEventListener("change", onChange);
    input.click();
  }

  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  async function saveField(field: string, value: string, onError: () => void) {
    const status = document.querySelector<HTMLElement>("[data-edit-status]");
    if (status) {
      status.textContent = "Guardando…";
      status.dataset.state = "saving";
    }
    try {
      const res = await fetch("/api/admin/inline-edit", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ field, value }),
      });
      if (!res.ok) {
        const msg = await res.text();
        throw new Error(msg || `${res.status}`);
      }
      if (status) {
        status.textContent = "Guardado";
        status.dataset.state = "saved";
      }
      // Fade the status back out after 2.5s.
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        if (status) {
          status.textContent = "";
          delete status.dataset.state;
        }
      }, 2500);
    } catch (err) {
      if (status) {
        status.textContent = "Error al guardar";
        status.dataset.state = "error";
      }
      onError();
      // eslint-disable-next-line no-console
      console.error("[inline-edit] save failed", err);
    }
  }

  if (document.readyState === "complete") boot();
  else window.addEventListener("load", boot, { once: true });
  document.addEventListener("astro:page-load", boot);
</script>

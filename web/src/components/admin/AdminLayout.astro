---
import "../../styles/fonts.css";
import "../../styles/tokens.css";
import "../../styles/admin.css";
import { txFor, type AdminLang } from "../../lib/admin-i18n";

interface Props {
  title?: string;
  active?: "dashboard" | "daniel" | "press_kit" | "site" | "projects" | "articles" | "art" | "daily" | "field_notes" | "press" | "messages";
}
const { title = "Admin · Daniel Nates", active } = Astro.props as Props;
const user = Astro.locals.user;
const scope = Astro.locals.adminScope ?? "all";
const isFullAdmin = scope === "all";
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);
const here = Astro.url.pathname;

/* App identity — visualises which "world" the user is in. The accent
 * tints the brand mark, the hover/active states, and the small dot
 * next to each nav item.
 *
 * Olivea + Maizal aren't apps because they don't have their own admin
 * surfaces — they live as project rows under Daniel's portfolio. Only
 * Fritanguita gets its own app context (since the team will eventually
 * have their own login + their own .com).
 *
 * Full admins switch via the cookie (set through /api/admin/app).
 * Scoped users are locked to their scope at the middleware level. */
type AppId = "daniel" | "fritanguita";
interface AppDef { id: AppId; label: string; tagline: string; accent: string }
const APPS: AppDef[] = [
  { id: "daniel",      label: "Daniel Nates",  tagline: t("Chef · Dibujante", "Chef · Draughtsman"),     accent: "#EFE6D4" },
  { id: "fritanguita", label: "Fritanguita",   tagline: t("Roma Norte · CDMX", "Roma Norte · Mexico City"), accent: "#3FAA67" },
];

const appId: AppId = (Astro.locals.adminApp as AppId) ?? "daniel";
const currentApp: AppDef = APPS.find((a) => a.id === appId) ?? APPS[0];
const visibleApps = isFullAdmin ? APPS : APPS.filter((a) => a.id === scope as AppId);

/* Section-grouped nav, with an inline icon ring per item. Icon glyph is
 * just an SVG monogram — kept abstract so it reads as a system, not
 * literal pictograms. */
type NavLink = { href: string; label: string; key?: Props["active"]; icon: string };
type NavSection = { section: string; items: NavLink[] };

const danielNav: NavSection[] = [
  { section: t("Inicio", "Home"), items: [
      { href: "/admin", label: "Dashboard", key: "dashboard", icon: "home" },
  ]},
  { section: t("Identidad", "Identity"), items: [
      { href: "/admin/site",      label: t("Ajustes del sitio", "Site settings"), key: "site",      icon: "tune" },
      { href: "/admin/daniel",    label: "Daniel",                                key: "daniel",    icon: "person" },
      { href: "/admin/press-kit", label: t("Prensa · kit", "Press · kit"),        key: "press_kit", icon: "kit" },
  ]},
  { section: t("Diario", "Journal"), items: [
      { href: "/admin/daily",       label: t("Día · brief", "Day · brief"),       key: "daily",       icon: "sun" },
      { href: "/admin/articles",    label: t("Artículos", "Articles"),            key: "articles",    icon: "doc" },
      { href: "/admin/field-notes", label: "Field Notes",                          key: "field_notes", icon: "note" },
  ]},
  { section: t("Arte", "Art"), items: [
      { href: "/admin/art",         label: t("Piezas", "Pieces"),                 key: "art",        icon: "art" },
  ]},
  { section: t("Proyectos", "Projects"), items: [
      { href: "/admin/projects",    label: t("Todos", "All"),                     key: "projects",   icon: "stack" },
  ]},
  { section: t("Prensa", "Press"), items: [
      { href: "/admin/press",       label: t("Menciones", "Mentions"),            key: "press",      icon: "quote" },
  ]},
  { section: "Inbox", items: [
      { href: "/admin/messages",    label: t("Contacto", "Contact"),              key: "messages",   icon: "mail" },
  ]},
];

/* Fritanguita app — nav scoped to just the Fritanguita surfaces.
 * Same shape for full admins (when they switch via the toggle) and
 * for scoped users (Antonio/Santiago/José etc). */
const fritanguitaNav: NavSection[] = [
  { section: t("Inicio", "Home"), items: [
      { href: "/admin", label: "Dashboard", key: "dashboard", icon: "home" },
  ]},
  { section: t("Página", "Page"), items: [
      { href: "/admin/projects", label: t("Editar página principal", "Edit main page"), key: "projects", icon: "stack" },
  ]},
];

const sections = appId === "fritanguita" ? fritanguitaNav : danielNav;

/* Tiny inline-SVG icon system — single source. Each glyph is a 16×16
 * stroke pictogram; scaled and tinted via currentColor at render. */
const ICONS: Record<string, string> = {
  home:   `<path d="M2 8 L8 3 L14 8 V13 H10 V9 H6 V13 H2 Z"/>`,
  tune:   `<circle cx="5" cy="5" r="2"/><line x1="5" y1="7" x2="5" y2="14"/><line x1="5" y1="2" x2="5" y2="3"/><circle cx="11" cy="11" r="2"/><line x1="11" y1="2" x2="11" y2="9"/><line x1="11" y1="13" x2="11" y2="14"/>`,
  person: `<circle cx="8" cy="6" r="3"/><path d="M2 14 C 2 10 14 10 14 14"/>`,
  kit:    `<rect x="2.5" y="5" width="11" height="8" rx="1"/><path d="M6 5 V3.5 H10 V5"/>`,
  sun:    `<circle cx="8" cy="8" r="3"/><line x1="8" y1="2" x2="8" y2="3.5"/><line x1="8" y1="12.5" x2="8" y2="14"/><line x1="2" y1="8" x2="3.5" y2="8"/><line x1="12.5" y1="8" x2="14" y2="8"/><line x1="3.5" y1="3.5" x2="4.5" y2="4.5"/><line x1="11.5" y1="11.5" x2="12.5" y2="12.5"/><line x1="3.5" y1="12.5" x2="4.5" y2="11.5"/><line x1="11.5" y1="4.5" x2="12.5" y2="3.5"/>`,
  doc:    `<path d="M3 2 H10 L13 5 V14 H3 Z"/><line x1="5" y1="6" x2="11" y2="6"/><line x1="5" y1="9" x2="11" y2="9"/><line x1="5" y1="12" x2="9" y2="12"/>`,
  note:   `<path d="M3 2 H13 V14 L10.5 12 L8 14 L5.5 12 L3 14 Z"/>`,
  art:    `<rect x="2.5" y="2.5" width="11" height="11" rx="1"/><line x1="2.5" y1="11" x2="13.5" y2="11"/><circle cx="5.5" cy="6" r="1"/>`,
  stack:  `<rect x="2.5" y="3" width="11" height="3" rx="0.5"/><rect x="2.5" y="7" width="11" height="3" rx="0.5"/><rect x="2.5" y="11" width="11" height="2.5" rx="0.5"/>`,
  quote:  `<path d="M3 9 V6 C 3 4 4 3 6 3 V5 C 5 5 5 6 5 7 H6 V9 Z"/><path d="M9 9 V6 C 9 4 10 3 12 3 V5 C 11 5 11 6 11 7 H12 V9 Z"/>`,
  mail:   `<rect x="2.5" y="3.5" width="11" height="9" rx="1"/><path d="M2.5 4.5 L8 9 L13.5 4.5"/>`,
};

const iconSvg = (key: string) =>
  `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[key] ?? ""}</svg>`;
---

<!doctype html>
<html lang="es" data-app={currentApp.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />
    <style is:inline define:vars={{ accent: currentApp.accent }}>
      :root { --app-accent: var(--accent); }
    </style>
  </head>
  <body class="admin" data-app={currentApp.id}>
    <aside class="admin__nav">

      {/* App identity card — anchors which "world" you're in. */}
      <a class="appbar" href="/admin">
        <span class="appbar__dot" aria-hidden="true"></span>
        <span class="appbar__body">
          <span class="appbar__label">{currentApp.label}</span>
          <span class="appbar__tag">{currentApp.tagline}</span>
        </span>
      </a>

      {/* App switcher — only visible when user has access to >1 app.
          Each pill hits /api/admin/app which sets the cookie and 303s. */}
      {visibleApps.length > 1 ? (
        <div class="appswitcher" role="group" aria-label={t("Cambiar de app", "Switch app")}>
          {visibleApps.map((a) => (
            <a
              class={`appswitcher__pill${a.id === currentApp.id ? " is-active" : ""}`}
              href={`/api/admin/app?app=${a.id}&from=${encodeURIComponent(here)}`}
              style={`--pill-accent: ${a.accent};`}
            >
              <span class="appswitcher__bullet" aria-hidden="true"></span>
              {a.label.split(" ")[0]}
            </a>
          ))}
        </div>
      ) : null}

      {/* Grouped nav with inline icons. */}
      <nav class="adminnav">
        {sections.map((sec) => (
          <div class="adminnav__section">
            <p class="adminnav__sectionLabel">{sec.section}</p>
            {sec.items.map((it) => (
              <a
                class={`adminnav__link${active === it.key ? " is-active" : ""}`}
                href={it.href}
              >
                <span class="adminnav__icon" set:html={iconSvg(it.icon)}></span>
                <span class="adminnav__label">{it.label}</span>
              </a>
            ))}
          </div>
        ))}
      </nav>

      {/* Footer: who you are + scope + lang toggle + utilities */}
      <div class="adminnav__foot">
        <p class="adminnav__footEmail">{user?.email}</p>
        <p class="adminnav__footScope">
          <span class="adminnav__scopeDot" aria-hidden="true"></span>
          {isFullAdmin ? t("Acceso completo", "Full access") : t(`Acceso · ${scope}`, `Access · ${scope}`)}
        </p>

        <div class="langtoggle" role="group" aria-label={t("Idioma del admin", "Admin language")}>
          <a class={`langtoggle__pill${lang === "es" ? " is-active" : ""}`} href={`/api/admin/lang?lang=es&from=${encodeURIComponent(here)}`}>ES</a>
          <a class={`langtoggle__pill${lang === "en" ? " is-active" : ""}`} href={`/api/admin/lang?lang=en&from=${encodeURIComponent(here)}`}>EN</a>
        </div>

        <div class="adminnav__footLinks">
          <a class="adminnav__util" href="/" target="_blank" rel="noreferrer">{t("Ver el sitio", "View site")} ↗</a>
          <a class="adminnav__util" href="/admin/logout">{t("Cerrar sesión", "Sign out")}</a>
        </div>
      </div>
    </aside>

    <main class="admin__main">
      <slot />
    </main>
  </body>
</html>

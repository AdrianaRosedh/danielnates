---
/**
 * InlineEditBanner — drop-in callout for legacy admin [id] forms
 * pointing the admin at the live page where the same content can
 * now be edited in place (text, photos, order). The form itself
 * stays accessible for the operations that aren't yet inline
 * (voice uploads, JSONB blocks, etc.).
 */
interface Props {
  /** Public URL where this entity renders and the EditOverlay binds. */
  publicHref: string;
  /** Optional descriptor — what's edit-able inline (defaults to "text + fotos"). */
  what?: string;
}
const { publicHref, what = "texto, fotos y orden" } = Astro.props as Props;
---

<aside class="inlineEditBanner">
  <span class="inlineEditBanner__dot" aria-hidden="true"></span>
  <p>
    <strong>Esto se edita ahora en el sitio.</strong>
    {" "}
    Abre <a href={publicHref}><code>{publicHref}</code></a>, activa <em>Editar</em>
    en la barra de admin y cambia {what} en su lugar real.
  </p>
  <a class="inlineEditBanner__cta" href={publicHref}>
    Ir al sitio
    <span aria-hidden="true">→</span>
  </a>
</aside>

<style>
  .inlineEditBanner{
    display: grid;
    grid-template-columns: 8px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 12px 16px 14px;
    margin: 0 0 22px;
    border: 1px solid rgba(217, 66, 28, .28);
    border-radius: 10px;
    background: rgba(217, 66, 28, .04);
  }
  .inlineEditBanner__dot{
    width: 8px; height: 8px;
    margin-top: 6px;
    border-radius: 999px;
    background: var(--ember, #D9421C);
    box-shadow: 0 0 0 4px rgba(217, 66, 28, .14);
  }
  .inlineEditBanner p{
    margin: 0;
    color: var(--text-2, #cfc7b8);
    font-family: var(--font-display, "Instrument Serif", serif);
    font-size: 15px;
    line-height: 1.5;
  }
  .inlineEditBanner p strong{
    color: var(--text, #f4efe6);
    font-weight: 500;
    font-style: italic;
  }
  .inlineEditBanner code{
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    color: var(--text);
    padding: 1px 6px;
    background: rgba(244,239,230,.06);
    border-radius: 4px;
    border-bottom: 1px solid rgba(217, 66, 28, .55);
  }
  .inlineEditBanner__cta{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, system-ui);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text);
    background: rgba(217, 66, 28, .9);
    padding: 8px 14px;
    border-radius: 999px;
    transition: background .25s;
  }
  .inlineEditBanner__cta:hover{ background: #D9421C; }
</style>

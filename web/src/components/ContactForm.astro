---
/**
 * ContactForm — a letter, not a form.
 *
 * Topic chips (Prensa / Colaboración / Una idea / Otro), underline
 * fields in the display face, one send button. Posts to /api/contact
 * (name, email, message); the chosen topic is prefixed to the message
 * so the inbox can sort it without a schema change. A `?tema=` query
 * (e.g. /contacto?tema=prensa from the press page) preselects a topic.
 */
import { ui } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface Props { locale: Locale }
const { locale } = Astro.props as Props;
const es = locale === "es";

const topics = [
  { value: "prensa", label: es ? "Prensa" : "Press" },
  { value: "colaboracion", label: es ? "Colaboración" : "Collaboration" },
  { value: "idea", label: es ? "Una idea" : "An idea" },
  { value: "otro", label: es ? "Otro" : "Other" },
];
---

<form
  class="cform reveal"
  data-contact-form
  data-send-text={ui("send", locale)}
  data-sending-text={es ? "Enviando…" : "Sending…"}
  data-thanks-text={es ? "Gracias. Mensaje recibido." : "Thank you. Message received."}
  data-error-text={es ? "No se pudo enviar. Inténtalo de nuevo." : "Couldn't send. Please try again."}
>
  <input type="hidden" name="locale" value={locale} />
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="cform__honeypot" />

  <fieldset class="cform__topics">
    <legend class="cform__label ui-label">{es ? "Sobre qué" : "About"}</legend>
    <div class="cform__chips">
      {topics.map((t, i) => (
        <label class="cform__chip">
          <input type="radio" name="topic" value={t.value} checked={i === 0} />
          <span>{t.label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class="cform__field">
    <span class="cform__label ui-label">{ui("name", locale)}</span>
    <input type="text" name="name" required maxlength="200" autocomplete="name" />
  </label>
  <label class="cform__field">
    <span class="cform__label ui-label">{ui("email", locale)}</span>
    <input type="email" name="email" required maxlength="320" autocomplete="email" />
  </label>
  <label class="cform__field">
    <span class="cform__label ui-label">{ui("message", locale)}</span>
    <textarea name="message" required maxlength="5000" rows="6"></textarea>
  </label>

  <div class="cform__row">
    <button type="submit" class="cform__send ui-pill ui-pill--solid" data-submit>
      <span data-submit-label>{ui("send", locale)}</span> <span aria-hidden="true">→</span>
    </button>
    <p class="cform__status" data-status role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  function init() {
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    if (!form) return;
    const f = form as HTMLFormElement & { __bound?: boolean };
    if (f.__bound) return;
    f.__bound = true;

    // ?tema=prensa → preselect that topic.
    const tema = new URLSearchParams(location.search).get("tema");
    if (tema) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="topic"][value="${CSS.escape(tema)}"]`);
      if (radio) radio.checked = true;
    }

    const status = form.querySelector<HTMLElement>("[data-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const label = form.querySelector<HTMLElement>("[data-submit-label]");
    const t = (k: string) => form.dataset[k] ?? "";
    const setStatus = (text: string, ok = true) => {
      if (!status) return;
      status.textContent = text;
      status.dataset.ok = ok ? "1" : "0";
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const topic = form.querySelector<HTMLInputElement>('input[name="topic"]:checked');
      const topicLabel = topic?.parentElement?.querySelector("span")?.textContent?.trim();
      if (topicLabel) data.set("message", `[${topicLabel}] ${String(data.get("message") ?? "")}`);
      data.delete("topic");

      if (submit) submit.disabled = true;
      if (label) label.textContent = t("sendingText");
      setStatus("");
      try {
        const res = await fetch("/api/contact", { method: "POST", body: data });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) {
          setStatus(json.error || t("errorText"), false);
          return;
        }
        setStatus(t("thanksText"), true);
        form.reset();
        const first = form.querySelector<HTMLInputElement>('input[name="topic"]');
        if (first) first.checked = true;
      } catch {
        setStatus(t("errorText"), false);
      } finally {
        if (submit) submit.disabled = false;
        if (label) label.textContent = t("sendText");
      }
    });
  }

  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init, { once: true });
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .cform{ display: grid; gap: clamp(26px, 4vh, 40px); }
  .cform__honeypot{ position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .cform__label{ display: block; margin-bottom: 10px; padding: 0; }
  .cform__topics{ border: 0; margin: 0; padding: 0; min-width: 0; }
  .cform__chips{ display: flex; flex-wrap: wrap; gap: 8px; }
  .cform__chip{ position: relative; cursor: pointer; }
  .cform__chip input{ position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .cform__chip span{
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-2);
    transition: background 400ms var(--ease-fluid), color 400ms var(--ease-fluid), border-color 400ms var(--ease-fluid);
  }
  .cform__chip:hover span{ border-color: var(--text); color: var(--text); }
  .cform__chip input:checked + span{ background: var(--ink); border-color: var(--ink); color: var(--bone); }
  .cform__chip input:focus-visible + span{ outline: 2px solid var(--olivar); outline-offset: 3px; }

  .cform__field{ display: block; }
  .cform__field input,
  .cform__field textarea{
    display: block;
    width: 100%;
    padding: 6px 0 12px;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(22px, 1.8vw, 28px);
    line-height: 1.3;
    transition: border-color 400ms var(--ease-fluid);
  }
  .cform__field textarea{ resize: vertical; min-height: 7.5em; }
  .cform__field input:focus,
  .cform__field textarea:focus{
    outline: none;
    border-bottom-color: var(--olivar);
  }

  .cform__row{ display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .cform__status{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--text-2);
  }
  .cform__status[data-ok="0"]{ color: var(--ember); }
  .cform__status[data-ok="1"]{ color: var(--moss); }
</style>

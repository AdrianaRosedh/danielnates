---
import { aboutHref, href, pressHref, ui } from "../../lib/i18n";
import type { Locale, Person } from "../../lib/types";
import TextReveal from "../motion/TextReveal.astro";

interface Props {
  locale?: Locale;
  daniel?: Person | null;
  /** Landing-copy lookup. When provided, `closing.line_<locale>`
   *  overrides the hardcoded fallback below. */
  copy?: Record<string, string>;
}
const { locale: propLocale, daniel = null, copy = {} } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

// Closing thought — Daniel as a whole person (cooks, draws, makes).
const closingLine = copy[`closing.line_${locale}`] ?? (locale === "es"
  ? "La mesa es el último cuadro."
  : "The table is the last painting.");

const sigName = daniel?.name ?? "Daniel Nates";
const place = locale === "es"
  ? "Valle de Guadalupe · CDMX · MMXXVI"
  : "Valle de Guadalupe · Mexico City · MMXXVI";
const email = daniel?.social?.email ?? null;
const igDaniel = daniel?.social?.instagram ?? null;
const ig1 = daniel?.social?.olivea_instagram ?? null;
const ig2 = daniel?.social?.fritanguita_instagram ?? null;
---

<section class="closing scene--ink" data-scene="ink">
  <div class="closing__inner">
    <span class="closing__rule" aria-hidden="true"></span>

    <TextReveal as="p" mode="word" class="closing__line" editField={`copy.closing.line_${locale}`}>
      {closingLine}
    </TextReveal>

    <div class="closing__sig">
      <span class="closing__name">{sigName}</span>
      <span class="closing__place">{place}</span>
    </div>

    {/* The film ends; the house opens. First door of the journey. */}
    <a class="closing__door" href={aboutHref(locale)}>
      <span class="closing__doorKicker">{locale === "es" ? "Sigue" : "Continue"}</span>
      <span class="closing__doorLabel">{locale === "es" ? "Sobre Daniel" : "About Daniel"}</span>
      <span class="closing__doorMeta">
        {locale === "es" ? "El cocinero detrás de la mesa" : "The cook behind the table"}
        <span class="closing__doorArrow" aria-hidden="true">→</span>
      </span>
    </a>
  </div>

  <footer class="closing__foot">
    <div class="closing__col">
      <p class="closing__label">{ui("contact", locale)}</p>
      {email ? <a class="closing__link" href={`mailto:${email}`}>{email}</a> : null}
      <a class="closing__link" href={href("/contacto", locale)}>{locale === "es" ? "Escribe" : "Write"} →</a>
      {igDaniel ? <a class="closing__link" href={igDaniel} target="_blank" rel="noreferrer">Instagram ↗</a> : null}
    </div>

    <div class="closing__col">
      <p class="closing__label">Olivea</p>
      <a class="closing__link" href={href("/olivea", locale)}>{locale === "es" ? "El capítulo" : "The chapter"} →</a>
      {ig1 ? <a class="closing__link" href={ig1} target="_blank" rel="noreferrer">Instagram ↗</a> : null}
      <span class="closing__note">Valle de Guadalupe</span>
    </div>

    <div class="closing__col">
      <p class="closing__label">Fritanguita</p>
      <a class="closing__link" href={href("/fritanguita", locale)}>{locale === "es" ? "El capítulo" : "The chapter"} →</a>
      {ig2 ? <a class="closing__link" href={ig2} target="_blank" rel="noreferrer">Instagram ↗</a> : null}
      <span class="closing__note">Roma Norte · CDMX</span>
    </div>

    <div class="closing__col">
      <p class="closing__label">{ui("press", locale)}</p>
      <a class="closing__link" href={pressHref(locale)}>
        {locale === "es" ? "Bio · fotos · menciones" : "Bio · photos · mentions"}
      </a>
      <a class="closing__link" href={href(Astro.url.pathname, locale === "es" ? "en" : "es")}>
        {locale === "es" ? "English" : "Español"} ↗
      </a>
    </div>

    <div class="closing__bottom">
      <span>© MMXXVI · Daniel Nates</span>
      <span>danielnates.com</span>
    </div>
  </footer>
</section>

<style>
  .closing{
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* Mist → ink gradient. The mountain blue-gray from the hero
       photo gets its only appearance here — closing the natural-
       palette loop without showing it everywhere. */
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--mist) 18%, var(--ink)) 0%,
        var(--ink) 60%,
        #08090A 100%);
    color: var(--bone);
    border-top: 1px solid color-mix(in srgb, var(--mist) 22%, rgba(244,239,230,.04));
    overflow: hidden;
    /* Contain the .scene--ink::after vignette — unpositioned, it
       escaped to the top of the page and darkened the hero. */
    position: relative;
  }
  .closing > *{ position: relative; z-index: 1; }

  /* Hero-like statement — the film's last line */
  .closing__inner{
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(110px, 15vw, 210px) clamp(20px, 6vw, 120px) clamp(90px, 11vw, 150px);
    text-align: center;
  }
  .closing__rule{
    /* Vertical sage hairline — picks up the natural palette as a
       deliberate architectural mark before the closing line. */
    display: block;
    width: 1px;
    height: clamp(56px, 8vw, 96px);
    background: linear-gradient(to bottom,
      transparent,
      color-mix(in srgb, var(--olivar) 70%, transparent),
      transparent);
    margin: 0 auto clamp(40px, 5vw, 64px);
  }
  /* :global — rendered by <TextReveal>, outside this scope. */
  :global(.closing__line){
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(36px, 6vw, 96px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--bone);
    max-width: 22ch;
    margin-inline: auto;
  }
  .closing__sig{
    margin-top: clamp(36px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
  }
  .closing__name{ color: rgba(244,239,230,.9); }
  .closing__place{ color: rgba(244,239,230,.45); }

  /* The onward door — the coda hands you to the next chapter */
  .closing__door{
    margin-top: clamp(56px, 8vw, 96px);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: var(--bone);
  }
  .closing__doorKicker{
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: rgba(244,239,230,.45);
  }
  .closing__doorLabel{
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color 600ms var(--ease-fluid);
  }
  .closing__doorMeta{
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(244,239,230,.55);
    transition: color 600ms var(--ease-fluid);
  }
  .closing__doorArrow{
    display: inline-block;
    transition: transform 600ms var(--ease-fluid);
  }
  .closing__door:hover .closing__doorLabel{ color: color-mix(in srgb, var(--olivar) 45%, var(--bone)); }
  .closing__door:hover .closing__doorMeta{ color: rgba(244,239,230,.8); }
  .closing__door:hover .closing__doorArrow{ transform: translateX(6px); }

  /* Quiet, editorial footer */
  .closing__foot{
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) clamp(20px, 6vw, 120px) clamp(40px, 5vw, 64px);
    border-top: 1px solid rgba(244,239,230,.08);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 36px);
  }
  @media (min-width: 720px){
    .closing__foot{ grid-template-columns: repeat(4, 1fr); }
  }
  .closing__col{ display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .closing__label{
    margin: 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(244,239,230,.45);
  }
  .closing__note{
    display: block;
    margin-top: 2px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(244,239,230,.38);
  }
  .closing__link{
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(244,239,230,.88);
    transition: color .25s, opacity .25s;
    word-break: break-word;
  }
  .closing__link:hover{ color: var(--ember, #D9421C); }

  .closing__bottom{
    grid-column: 1 / -1;
    margin-top: clamp(24px, 3vw, 36px);
    padding-top: clamp(20px, 2vw, 28px);
    border-top: 1px solid rgba(244,239,230,.06);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(244,239,230,.4);
  }
</style>

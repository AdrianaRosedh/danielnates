---
import TextReveal from "../motion/TextReveal.astro";
import type { Locale, Pillar } from "../../lib/types";
import { t2 } from "../../lib/i18n";

interface Props {
  pillars?: Pillar[];
  kicker?: string;
  locale?: Locale;
}

const { pillars = [], kicker = "Manifiesto", locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";
---

{pillars.length ? (
  <section class="manifesto scene--ink" data-scene="ink">
    <div class="manifesto__inner">
      <p class="kicker manifesto__kicker">{kicker}</p>

      <ol class="manifesto__list">
        {pillars.map((p, i) => (
          <li class="manifesto__item">
            <span class="manifesto__num">{String(i + 1).padStart(2, "0")}</span>
            <div class="manifesto__body">
              <TextReveal as="h2" mode="word" class="manifesto__label">
                {p.label}
              </TextReveal>
              {t2(p.copy_es, p.copy_en, locale) ? (
                <p class="manifesto__copy">{t2(p.copy_es, p.copy_en, locale)}</p>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
) : null}

<style>
  .manifesto{
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* Subtle radial sage wash on the ink background — invisible up
       close, but it tints the eye when scrolling past. The natural
       palette feels present even though no bright surface is shown. */
    background:
      radial-gradient(80% 60% at 8% 10%,
        color-mix(in srgb, var(--olivar) 10%, transparent),
        transparent 70%),
      radial-gradient(70% 50% at 92% 90%,
        color-mix(in srgb, var(--clay) 7%, transparent),
        transparent 70%),
      var(--ink);
    color: var(--bone);
    padding: clamp(80px, 12vw, 180px) clamp(20px, 5vw, 80px);
    position: relative;
  }
  .manifesto__inner{ max-width: 1280px; margin: 0 auto; }
  .manifesto__kicker{
    /* Kicker now sage with a leading rule — reads as a chapter mark,
       not just a label. */
    color: var(--olivar);
    margin: 0 0 clamp(36px, 5vw, 72px);
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .manifesto__kicker::before{
    content: "";
    width: 28px;
    height: 1px;
    background: var(--olivar);
  }

  .manifesto__list{
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: clamp(36px, 5vw, 72px);
  }
  .manifesto__item{
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: clamp(20px, 3vw, 56px);
    align-items: baseline;
    padding-bottom: clamp(36px, 5vw, 72px);
    /* Sage hairline rule between pillars — picks up the natural palette
       and breaks the dead-monochrome feel. */
    border-bottom: 1px solid color-mix(in srgb, var(--olivar) 28%, transparent);
  }
  .manifesto__item:last-child{ border-bottom: 0; padding-bottom: 0; }

  .manifesto__num{
    /* Number is now a small architectural mark — sage on ink, with a
       paired tick under it so it reads like a chapter ordinal. */
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    color: var(--olivar);
    padding-top: 16px;
    position: relative;
    display: inline-block;
  }
  .manifesto__num::after{
    content: "";
    display: block;
    width: 22px;
    height: 1px;
    background: color-mix(in srgb, var(--olivar) 60%, transparent);
    margin-top: 8px;
  }
  .manifesto__body{ min-width: 0; }
  .manifesto__label{
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 80px);
    line-height: .98;
    letter-spacing: -0.025em;
    color: var(--bone);
    margin: 0;
  }
  .manifesto__copy{
    margin: clamp(14px, 2vw, 24px) 0 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.55;
    color: rgba(244,239,230,.72);
    max-width: 56ch;
  }

  @media (max-width: 720px){
    .manifesto__item{ grid-template-columns: 1fr; gap: 14px; }
    .manifesto__num{ padding: 0; }
  }
</style>

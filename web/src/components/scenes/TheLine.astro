---
import TextReveal from "../motion/TextReveal.astro";

interface Props {
  line?: string;
  attribution?: string;
}
const {
  line = "Cocinar y dibujar — la misma lengua.",
  attribution = "Daniel Nates",
} = Astro.props as Props;
---

<section class="theLine scene--ink" data-scene="ink">
  <div class="theLine__inner">
    <TextReveal as="p" mode="word" class="theLine__text">{line}</TextReveal>
    {attribution ? <p class="theLine__attr">{attribution}</p> : null}
  </div>
</section>

<style>
  .theLine{
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background:
      /* Subtle moss wash from the upper-left, like deep garden shadow.
         Invisible up close, but it tints scrolling past. */
      radial-gradient(60% 50% at 10% 0%,
        color-mix(in srgb, var(--moss) 22%, transparent),
        transparent 60%),
      #0B0C0A;
    color: var(--bone);
    padding: clamp(140px, 20vw, 280px) clamp(20px, 6vw, 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Sage hairlines top + bottom — frames the line as a quote pulled
       from a longer document. */
    border-top: 1px solid color-mix(in srgb, var(--olivar) 22%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--olivar) 22%, transparent);
  }
  .theLine__inner{ max-width: 1100px; margin: 0 auto; text-align: left; }
  .theLine__text{
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 7vw, 110px);
    line-height: .98;
    letter-spacing: -0.025em;
    word-spacing: .02em;
    color: var(--bone);
    margin: 0;
  }
  .theLine__attr{
    margin: clamp(28px, 3vw, 48px) 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    /* Attribution leans sage — small mark, but consistent with the
       chapter ordinals in the manifesto below. */
    color: var(--olivar);
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .theLine__attr::before{
    content: "";
    width: 22px;
    height: 1px;
    background: color-mix(in srgb, var(--olivar) 70%, transparent);
  }
</style>

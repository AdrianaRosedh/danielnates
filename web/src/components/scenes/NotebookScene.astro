---
/**
 * NotebookScene — the landing page's signature.
 *
 * A pinned ~400vh-tall section. Vertical scroll drives a horizontal
 * page-turn through 5 facing spreads. Each spread is left page +
 * right page:
 *   left  = a hand-drawn SVG line illustration that draws itself
 *           (stroke-dashoffset → 0) as the spread enters frame
 *   right = a single photograph + italic display caption + recto
 *           ordinal in the corner
 *
 * The thesis: Daniel cooks AND he draws. The same hand makes both.
 * This scene literally pairs one drawing with one project on every
 * spread. Animation Director picks up [data-notebook] and binds the
 * pinned scrollTrigger + per-spread containerAnimation triggers for
 * the SVG self-draw.
 *
 * Drawings here are placeholder line art — each is a single subject
 * suggested with a few strokes. They CAN be replaced by Daniel's
 * own drawings (any SVG with stroke paths) without touching motion.
 */

import type { Locale } from "../../lib/types";
import WebGLPlane from "../motion/WebGLPlane.astro";

interface Spread {
  recto: string;                   // "I" .. "V"
  caption: string;                 // italic display line, right page
  place: string;                   // small caps, right page foot
  href?: string | null;            // optional CTA on right page
  hrefLabel?: string;
  imageUrl?: string | null;        // right page photograph
  /** Single Spanish noun anchoring the left page (Huerto, Cazo, Maíz…). */
  markWord: string;
}

interface Props {
  title?: string;                  // "El Cuaderno" / "The Notebook"
  spreads?: Spread[];
  locale?: Locale;
}

const { title = "El Cuaderno", spreads = [], locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

/* Default editorial fallback — five spreads tracing Daniel's arc.
 * If the parent passes its own spreads array these are skipped.
 * Spanish nouns anchor the left page in both locales — these are
 * Daniel's words for these things. */
const defaultSpreads: Spread[] = [
  {
    recto: "I",
    markWord: "Huerto",
    imageUrl: "/media/hero/daniel-garden.jpg",
    caption: locale === "es" ? "El huerto manda. La carta cambia con la mañana." : "The garden leads. The menu changes with the morning.",
    place: "Olivea · Valle de Guadalupe",
    href: locale === "es" ? "/olivea" : "/en/olivea",
    hrefLabel: locale === "es" ? "Capítulo Olivea →" : "Chapter Olivea →",
  },
  {
    recto: "II",
    markWord: "Cazo",
    imageUrl: null,
    caption: locale === "es" ? "Fritanga poblana, en su forma más contemporánea." : "Poblano fritanga in its most contemporary form.",
    place: "Fritanguita · Roma Norte · CDMX",
    href: locale === "es" ? "/fritanguita" : "/en/fritanguita",
    hrefLabel: locale === "es" ? "Capítulo Fritanguita →" : "Chapter Fritanguita →",
  },
  {
    recto: "III",
    markWord: "Maíz",
    imageUrl: null,
    caption: locale === "es" ? "El primer maestro. Lo que aprendí ahí, todavía cocina lo que hago." : "The first teacher. What I learned there still cooks what I do.",
    place: "Maizal · Puebla · 2017–2024",
    href: locale === "es" ? "/maizal" : "/en/maizal",
    hrefLabel: locale === "es" ? "Capítulo Maizal →" : "Chapter Maizal →",
  },
  {
    recto: "IV",
    markWord: "Mano",
    imageUrl: null,
    caption: locale === "es" ? "La mano dibuja antes de cocinar. Composición, contraste, intención." : "The hand draws before it cooks. Composition, contrast, intent.",
    place: locale === "es" ? "Atelier · MMXXVI" : "Studio · MMXXVI",
    href: locale === "es" ? "/arte" : "/en/arte",
    hrefLabel: locale === "es" ? "Atelier →" : "Studio →",
  },
  {
    recto: "V",
    markWord: "Mesa",
    imageUrl: null,
    caption: locale === "es" ? "La mesa es el último cuadro." : "The table is the last painting.",
    place: locale === "es" ? "Daniel Nates · MMXXVI" : "Daniel Nates · MMXXVI",
  },
];

const items: Spread[] = spreads.length ? spreads : defaultSpreads;
const total = items.length;

/* The left page is pure display typography — a single Spanish noun
 * anchoring each spread (Huerto, Cazo, Maíz, Mano, Mesa). Editorial-
 * magazine grammar, not iconography. When Daniel uploads real artwork
 * we'll wire a sketchUrl prop that takes over. */
---

<section class="notebook scene--bone" data-scene="bone" data-notebook>

  {/* Pin chrome — title + counter sit at the top of the viewport
      and persist while the spreads slide horizontally. */}
  <header class="notebook__chrome" data-notebook-chrome>
    <div class="notebook__title">
      <span class="notebook__dot" aria-hidden="true"></span>
      <span>{title}</span>
    </div>
    <div class="notebook__counter">
      <span data-notebook-counter>I</span>
      <span class="notebook__counterSep">/</span>
      <span>{items[total - 1]?.recto ?? "V"}</span>
    </div>
  </header>

  {/* The track — flex row of N spreads, AnimationDirector drives
      its xPercent via scroll. */}
  <div class="notebook__viewport">
    <div class="notebook__track" data-notebook-track style={`--n: ${total};`}>
      {items.map((sp) => (
        <article class="spread" data-spread>

          {/* Left page — display typography. The single Spanish noun
              that anchors the spread sits in big italic display, with
              a small roman numeral and hairline rule above it. */}
          <div class="spread__page spread__page--left">
            <div class="spread__mark" data-mark>
              <p class="spread__markIndex" data-mark-index>{sp.recto}</p>
              <span class="spread__markRule" data-mark-rule aria-hidden="true"></span>
              <h3 class="spread__markWord" data-mark-word>{sp.markWord}</h3>
            </div>
          </div>

          {/* Center binding shadow */}
          <div class="spread__binding" aria-hidden="true"></div>

          {/* Right page — photograph + caption + recto */}
          <div class="spread__page spread__page--right">
            <div class="spread__media">
              {sp.imageUrl ? (
                <WebGLPlane
                  src={sp.imageUrl}
                  alt={sp.caption}
                  className="spread__plane"
                  intensity={0.055}
                />
              ) : (
                <div class="spread__plate" aria-hidden="true">
                  <span class="spread__plateGlyph">{sp.recto}</span>
                </div>
              )}
              <div class="spread__inner-rule" aria-hidden="true"></div>
            </div>
            <div class="spread__meta">
              <p class="spread__caption">{sp.caption}</p>
              <div class="spread__foot">
                <span class="spread__place">{sp.place}</span>
                {sp.href ? (
                  <a class="spread__cta" href={sp.href}>{sp.hrefLabel ?? "→"}</a>
                ) : null}
              </div>
            </div>
            <span class="spread__recto" aria-hidden="true">RECTO {sp.recto}</span>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section + pin chrome ─────────────────────────────────────── */
  .notebook{
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* The vertical runway = N * 100vh approximately. The Director
       will set the actual scroll distance via end: () => `+=…`. */
    height: 100vh;
    background:
      radial-gradient(60% 50% at 50% 0%,
        color-mix(in srgb, var(--paper) 80%, var(--bone)),
        var(--bone) 70%),
      var(--bone);
    color: var(--ink);
    overflow: hidden;
    /* When pinned this becomes the sticky surface; this is the
       "rest" position before pin engages. */
  }

  .notebook__chrome{
    position: absolute;
    top: clamp(40px, 5vw, 72px);
    left: clamp(20px, 4vw, 80px);
    right: clamp(20px, 4vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 3;
    pointer-events: none;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .notebook__title{ display: inline-flex; align-items: center; gap: 12px; }
  .notebook__dot{
    width: 8px; height: 8px; border-radius: 999px;
    background: var(--moss);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--moss) 14%, transparent);
  }
  .notebook__counter{
    display: inline-flex; align-items: baseline; gap: 6px;
    font-feature-settings: "tnum";
    font-family: var(--font-mono);
    color: var(--moss);
  }
  .notebook__counterSep{ color: color-mix(in srgb, var(--moss) 40%, transparent); }

  /* ── Viewport + track ─────────────────────────────────────────── */
  .notebook__viewport{
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Reserve top/bottom space for chrome */
    padding-top: clamp(120px, 14vh, 180px);
    padding-bottom: clamp(60px, 8vh, 100px);
  }
  .notebook__track{
    height: 100%;
    display: flex;
    align-items: stretch;
    will-change: transform;
  }

  /* ── A single spread (left + right page) ──────────────────────── */
  .spread{
    flex: 0 0 100vw;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 12px 1fr;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 80px);
    gap: 0;
  }

  .spread__page{
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(20px, 4vh, 56px) clamp(20px, 4vw, 56px);
    background:
      radial-gradient(80% 100% at 50% 0%,
        color-mix(in srgb, var(--paper) 50%, transparent),
        transparent 60%),
      var(--bone);
    position: relative;
  }

  /* ── Left page — display typography ───────────────────────────── */
  .spread__page--left{
    align-items: center;
    justify-content: center;
    color: var(--ink);
  }
  .spread__mark{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(20px, 2.6vw, 32px);
    max-width: 100%;
  }
  .spread__markIndex{
    margin: 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--moss);
    font-feature-settings: "tnum";
  }
  .spread__markRule{
    display: block;
    width: clamp(56px, 9vw, 110px);
    height: 1px;
    background: color-mix(in srgb, var(--moss) 60%, transparent);
  }
  .spread__markWord{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(96px, 16vw, 240px);
    line-height: 0.86;
    letter-spacing: -0.04em;
    color: var(--ink);
    /* Optical adjustment so accented characters (Maíz) breathe with
       the rest of the line. */
    word-break: keep-all;
    hyphens: none;
  }

  /* ── Center binding ───────────────────────────────────────────── */
  .spread__binding{
    width: 1px;
    height: 70%;
    background: linear-gradient(to bottom,
      transparent,
      color-mix(in srgb, var(--clay) 32%, transparent) 20%,
      color-mix(in srgb, var(--clay) 32%, transparent) 80%,
      transparent);
    margin: auto;
    box-shadow:
      4px 0 16px -8px rgba(14,15,12,.18),
      -4px 0 16px -8px rgba(14,15,12,.18);
  }

  /* ── Right page — photograph + caption ────────────────────────── */
  .spread__page--right{
    gap: clamp(18px, 3vw, 36px);
  }
  .spread__media{
    position: relative;
    width: 100%;
    max-width: clamp(280px, 38vw, 480px);
    aspect-ratio: 4 / 5;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--r-2);
    background: rgba(14,15,12,.04);
    box-shadow:
      0 30px 60px -16px rgba(14, 15, 12, .28),
      0 8px 22px -8px rgba(14, 15, 12, .18),
      0 0 0 1px color-mix(in srgb, var(--moss) 22%, rgba(14,15,12,.08));
  }
  .spread__media img{
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.04) contrast(1.05);
  }
  /* WebGL surface inherits the printed-photo presence — the shader
     handles the painterly grade; CSS sizes it within the mat. The
     scene's scroll is pinned, so we suppress scroll-driven chroma
     and let the mouse alone drive the interaction. */
  .spread__media .spread__plane{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
  .spread__media .spread__plane .gl__img{
    filter: saturate(1.04) contrast(1.05);
  }
  .spread__inner-rule{
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, var(--bone) 70%, transparent);
    pointer-events: none;
    border-radius: calc(var(--r-2) - 6px);
  }
  .spread__plate{
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(60% 60% at 50% 40%,
        color-mix(in srgb, var(--ink) 6%, transparent),
        transparent 70%);
  }
  .spread__plateGlyph{
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 132px);
    color: color-mix(in srgb, var(--ink) 18%, transparent);
    letter-spacing: -0.02em;
  }

  .spread__meta{
    width: 100%;
    max-width: clamp(280px, 38vw, 480px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .spread__caption{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    color: var(--ink);
    max-width: 32ch;
  }
  .spread__foot{
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-top: 1px solid color-mix(in srgb, var(--moss) 22%, rgba(14,15,12,.10));
    padding-top: 12px;
  }
  .spread__place{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }
  .spread__cta{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--moss);
    border-bottom: 1px solid color-mix(in srgb, var(--moss) 50%, transparent);
    padding-bottom: 1px;
    transition: color 400ms var(--ease-fluid), border-color 400ms var(--ease-fluid);
  }
  .spread__cta:hover{
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .spread__recto{
    position: absolute;
    bottom: clamp(12px, 2vh, 24px);
    right: clamp(20px, 3vw, 36px);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .26em;
    color: color-mix(in srgb, var(--moss) 60%, transparent);
  }

  /* Mobile: stack pages vertically — same content, no horizontal pin. */
  @media (max-width: 880px){
    .notebook{ height: auto; min-height: auto; }
    .notebook__viewport{ position: relative; height: auto; padding-top: clamp(80px, 12vh, 120px); padding-bottom: clamp(60px, 8vh, 100px); }
    .notebook__track{ flex-direction: column; height: auto; transform: none !important; }
    .spread{ flex: 0 0 auto; grid-template-columns: 1fr; height: auto; padding: clamp(40px, 8vw, 72px) clamp(20px, 5vw, 40px); }
    .spread__binding{ display: none; }
    .spread__page{ padding: clamp(20px, 4vw, 36px) 0; }
    .spread__page--left{ padding-bottom: clamp(36px, 6vw, 56px); }
  }

  /* Reduced-motion: identical to mobile (no pin/scroll lock). */
  @media (prefers-reduced-motion: reduce){
    .notebook{ height: auto; min-height: auto; }
    .notebook__viewport{ position: relative; height: auto; padding-top: clamp(80px, 12vh, 120px); padding-bottom: clamp(60px, 8vh, 100px); }
    .notebook__track{ flex-direction: column; height: auto; transform: none !important; }
    .spread{ flex: 0 0 auto; grid-template-columns: 1fr; height: auto; padding: clamp(40px, 8vw, 72px) clamp(20px, 5vw, 40px); }
    .spread__binding{ display: none; }
  }
</style>

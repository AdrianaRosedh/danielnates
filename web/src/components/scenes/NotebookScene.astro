72 132, 176 129, 178 125" stroke-width="0.7"/><path d="M40 134 C 50 130, 62 124, 72 119 C 76 117, 78 116, 80 117" stroke-width="1.5"/><path d="M40 134 L 41 137" stroke-width="1.2"/><path d="M44 132 L 45 130" stroke-width="0.9"/><path d="M50 128 L 49 125" stroke-width="0.9"/><path d="M55 125 L 57 122" stroke-width="0.9"/><path d="M60 122 L 59 119" stroke-width="0.9"/><path d="M64 120 L 66 117" stroke-width="0.9"/><path d="M68 117 L 67 114" stroke-width="0.9"/><path d="M72 115 L 74 112" stroke-width="0.9"/><path d="M76 113 L 75 110" stroke-width="0.9"/><path d="M48 130 C 47 127, 47 125, 49 124" stroke-width="0.7"/><path d="M52 127 C 54 124, 56 123, 58 124" stroke-width="0.7"/><path d="M56 124 C 55 121, 55 119, 57 118" stroke-width="0.7"/><path d="M62 121 C 64 119, 66 118, 68 119" stroke-width="0.7"/><path d="M66 118 C 65 116, 66 113, 67 112" stroke-width="0.7"/><path d="M70 116 C 72 114, 74 112, 76 113" stroke-width="0.7"/><path d="M74 113 C 73 110, 74 108, 75 107" stroke-width="0.7"/><path d="M88 152 C 100 156, 130 158, 156 156 C 170 155, 180 153, 184 152" stroke-width="0.7"/><path d="M92 154 C 102 156, 124 158, 144 157" stroke-width="0.7"/><path d="M100 156 C 110 157, 126 158, 138 158" stroke-width="0.7"/><path d="M114 158 L 130 159" stroke-width="0.7"/><path d="M152 154 L 162 153" stroke-width="0.7"/><path d="M160 152 L 172 151" stroke-width="0.7"/><path d="M40 142 C 48 144, 60 145, 70 144" stroke-width="0.7"/><path d="M44 145 L 56 146" stroke-width="0.7"/><path d="M50 147 L 62 147" stroke-width="0.7"/>`,

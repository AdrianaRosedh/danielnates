---
/**
 * NotebookScene — the landing page's signature.
 *
 * A pinned ~400vh-tall section. Vertical scroll drives a horizontal
 * page-turn through 5 facing spreads. Each spread is left page +
 * right page:
 *   left  = a hand-drawn SVG line illustration that draws itself
 *           (stroke-dashoffset → 0) as the spread enters frame
 *   right = a single photograph + italic display caption + recto
 *           ordinal in the corner
 *
 * The thesis: Daniel cooks AND he draws. The same hand makes both.
 * This scene literally pairs one drawing with one project on every
 * spread. Animation Director picks up [data-notebook] and binds the
 * pinned scrollTrigger + per-spread containerAnimation triggers for
 * the SVG self-draw.
 *
 * Drawings here are placeholder line art — each is a single subject
 * suggested with a few strokes. They CAN be replaced by Daniel's
 * own drawings (any SVG with stroke paths) without touching motion.
 */

import type { Locale } from "../../lib/types";
import SmartImage from "../content/SmartImage.astro";
import { MEDIA } from "../../lib/site";
import { ALL_SKETCHES, sketchDefs, sketchSvg, type SketchKind } from "../../lib/sketches";

interface Spread {
  recto: string;                   // "I" .. "V"
  caption: string;                 // italic display line, right page
  place: string;                   // small caps, right page foot
  href?: string | null;            // optional CTA on right page
  hrefLabel?: string;
  imageUrl?: string | null;        // right page photograph
  sketch: "leaf" | "cazo" | "milpa" | "mano" | "mesa";
}

interface Props {
  title?: string;                  // "El Cuaderno" / "The Notebook"
  spreads?: Spread[];
  locale?: Locale;
  /** Landing-copy lookup. When provided, each spread's markWord,
   *  caption and place prefer the DB value at notebook.<recto>.<key>
   *  before falling back to the hardcoded default. */
  copy?: Record<string, string>;
}

const { title = "El Cuaderno", spreads = [], locale: propLocale, copy = {} } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

const c = (key: string, fallback: string): string => copy[key] ?? fallback;

/* Default editorial fallback — five spreads tracing Daniel's arc.
 * If the parent passes its own spreads array these are skipped. The
 * markWord is now sourced from landing_copy where possible so each
 * spread's hero word is editable inline. */
/** Per-spread image lookup. A photo Daniel sets inline (EditOverlay
 *  "Cambiar foto") always wins; an empty value — how the
 *  20260507_notebook_images migration seeded II–V — falls back to the
 *  spread's default still (frames pulled from the site's own b&w
 *  garden footage). The numeral plate only shows with neither. */
const img = (recto: string, fallback: string | null = null): string | null => {
  const v = copy[`notebook.${recto}.image_url`]?.trim();
  return v ? v : fallback;
};

const defaultSpreads: Spread[] = [
  {
    recto: "I",
    sketch: "leaf",
    imageUrl: img("I", MEDIA.portrait),
    caption: c(`notebook.I.caption_${locale}`, locale === "es" ? "El huerto manda. La carta cambia con la mañana." : "The garden leads. The menu changes with the morning."),
    place: c(`notebook.I.place_${locale}`, "Olivea · Valle de Guadalupe"),
    href: locale === "es" ? "/olivea" : "/en/olivea",
    hrefLabel: locale === "es" ? "Capítulo Olivea →" : "Chapter Olivea →",
  },
  {
    recto: "II",
    sketch: "cazo",
    imageUrl: img("II", "/media/stills/membrillos.jpg"),
    caption: c(`notebook.II.caption_${locale}`, locale === "es" ? "Fritanga poblana, en su forma más contemporánea." : "Poblano fritanga in its most contemporary form."),
    place: c(`notebook.II.place_${locale}`, "Fritanguita · Roma Norte · CDMX"),
    href: locale === "es" ? "/fritanguita" : "/en/fritanguita",
    hrefLabel: locale === "es" ? "Capítulo Fritanguita →" : "Chapter Fritanguita →",
  },
  {
    recto: "III",
    sketch: "milpa",
    imageUrl: img("III", "/media/stills/hojas.jpg"),
    caption: c(`notebook.III.caption_${locale}`, locale === "es" ? "El primer maestro. Lo que aprendí ahí, todavía cocina lo que hago." : "The first teacher. What I learned there still cooks what I do."),
    place: c(`notebook.III.place_${locale}`, "Maizal · Puebla · 2017–2024"),
    href: locale === "es" ? "/maizal" : "/en/maizal",
    hrefLabel: locale === "es" ? "Capítulo Maizal →" : "Chapter Maizal →",
  },
  {
    recto: "IV",
    sketch: "mano",
    imageUrl: img("IV", "/media/stills/flores.jpg"),
    caption: c(`notebook.IV.caption_${locale}`, locale === "es" ? "La mano dibuja antes de cocinar. Composición, contraste, intención." : "The hand draws before it cooks. Composition, contrast, intent."),
    place: c(`notebook.IV.place_${locale}`, locale === "es" ? "Atelier · MMXXVI" : "Studio · MMXXVI"),
    href: locale === "es" ? "/arte" : "/en/arte",
    hrefLabel: locale === "es" ? "Atelier →" : "Studio →",
  },
  {
    recto: "V",
    sketch: "mesa",
    imageUrl: img("V", "/media/stills/hoja.jpg"),
    caption: c(`notebook.V.caption_${locale}`, locale === "es" ? "La mesa es el último cuadro." : "The table is the last painting."),
    place: c(`notebook.V.place_${locale}`, locale === "es" ? "Daniel Nates · MMXXVI" : "Daniel Nates · MMXXVI"),
  },
];

const allSpreads: Spread[] = spreads.length ? spreads : defaultSpreads;

/** Sort spreads by notebook.order (comma-separated recto list).
 *  Spreads referenced in the order list render in that order; any
 *  spreads missing from the list fall through to the end in their
 *  original sequence. The chrome counter at the top of the scene
 *  shows scroll position (I/V) — independent of which recto is
 *  visually first, so reorder is safe to do live. */
const orderRaw = (copy["notebook.order"] ?? allSpreads.map((s) => s.recto).join(",")).trim();
const orderList = orderRaw.split(",").map((s) => s.trim()).filter(Boolean);
const orderIndex = (recto: string) => {
  const i = orderList.indexOf(recto);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const items: Spread[] = [...allSpreads].sort((a, b) => orderIndex(a.recto) - orderIndex(b.recto));
const total = items.length;
/* The notebook.<recto>.markWord copy keys are seeded for an upcoming
 * typography variant of the left page; they now caption each study as
 * its figure label (Fig. II — Cazo), editable inline. */


/* Figure labels — a naturalist's plate caption under each study. The
   word is landing_copy notebook.<recto>.markWord (inline-editable);
   botanical names only where the subject is a plant. */
const MARK_DEFAULT: Record<string, string> = { I: "Huerto", II: "Cazo", III: "Maíz", IV: "Mano", V: "Mesa" };
const markWord = (recto: string) => c(`notebook.${recto}.markWord`, MARK_DEFAULT[recto] ?? "");
const LATIN: Partial<Record<SketchKind, string>> = { leaf: "Olea europaea", milpa: "Zea mays" };

---

<section class="notebook scene--bone" data-scene="bone" data-notebook>

  {/* Shared pen-wobble filter defs. Lives once per scene; every
      sketch references its own filter id for a distinct hand. The
      <svg> is zero-sized and aria-hidden — pure defs container. */}
  <svg class="notebook__defs" aria-hidden="true" focusable="false" width="0" height="0">
    <defs set:html={sketchDefs(ALL_SKETCHES, "nb")} />
  </svg>

  {/* Pin chrome — title + counter sit at the top of the viewport
      and persist while the spreads slide horizontally. */}
  <header class="notebook__chrome" data-notebook-chrome>
    <div class="notebook__title">
      <span class="notebook__dot" aria-hidden="true"></span>
      <span>{title}</span>
    </div>
    <div class="notebook__counter">
      <span data-notebook-counter>I</span>
      <span class="notebook__counterSep">/</span>
      <span>{items[total - 1]?.recto ?? "V"}</span>
    </div>
  </header>

  {/* The track — flex row of N spreads, AnimationDirector drives
      its xPercent via scroll. */}
  <div class="notebook__viewport">
    <div
      class="notebook__track"
      data-notebook-track
      data-edit-list-field="copy.notebook.order"
      style={`--n: ${total};`}
    >
      {items.map((sp) => (
        <article class="spread" data-spread data-edit-list-key={sp.recto}>

          {/* Left page — drawing */}
          <div class="spread__page spread__page--left">
            <div class="spread__sketchwrap" data-sketch set:html={sketchSvg(sp.sketch)} />
            <p class="spread__fig">
              <span class="spread__figNum">Fig. {sp.recto}</span>
              <span class="spread__figWord" data-edit-field={`copy.notebook.${sp.recto}.markWord`}>{markWord(sp.recto)}</span>
              {LATIN[sp.sketch] ? <span class="spread__figLatin">{LATIN[sp.sketch]}</span> : null}
            </p>
          </div>

          {/* Center binding shadow */}
          <div class="spread__binding" aria-hidden="true"></div>

          {/* Right page — photograph + caption + recto. spread__media
              is always tagged with data-edit-image-field so admins
              can attach a photo to a plate-glyph spread. */}
          <div class="spread__page spread__page--right">
            <div class="spread__media" data-edit-image-field={`copy.notebook.${sp.recto}.image_url`}>
              {sp.imageUrl ? (
                <SmartImage
                  src={sp.imageUrl}
                  alt={sp.caption}
                  class="spread__img"
                  widths={[480, 800]}
                  sizes="(min-width: 880px) 38vw, 90vw"
                />
              ) : (
                <div class="spread__plate" aria-hidden="true">
                  <span class="spread__plateGlyph">{sp.recto}</span>
                </div>
              )}
              <div class="spread__inner-rule" aria-hidden="true"></div>
            </div>
            <div class="spread__meta">
              <p class="spread__caption" data-edit-field={`copy.notebook.${sp.recto}.caption_${locale}`}>{sp.caption}</p>
              <div class="spread__foot">
                <span class="spread__place" data-edit-field={`copy.notebook.${sp.recto}.place_${locale}`}>{sp.place}</span>
                {sp.href ? (
                  <a class="spread__cta" href={sp.href}>{sp.hrefLabel ?? "→"}</a>
                ) : null}
              </div>
            </div>
            <span class="spread__recto" aria-hidden="true">RECTO {sp.recto}</span>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section + pin chrome ─────────────────────────────────────── */
  .notebook{
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    /* The vertical runway = N * 100vh approximately. The Director
       will set the actual scroll distance via end: () => `+=…`. */
    height: 100vh;
    background:
      radial-gradient(60% 50% at 50% 0%,
        color-mix(in srgb, var(--paper) 80%, var(--bone)),
        var(--bone) 70%),
      var(--bone);
    color: var(--ink);
    overflow: hidden;
    /* When pinned this becomes the sticky surface; this is the
       "rest" position before pin engages. */
  }

  .notebook__chrome{
    position: absolute;
    top: clamp(40px, 5vw, 72px);
    left: clamp(20px, 4vw, 80px);
    right: clamp(20px, 4vw, 80px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 3;
    pointer-events: none;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .notebook__title{ display: inline-flex; align-items: center; gap: 12px; }
  .notebook__dot{
    width: 8px; height: 8px; border-radius: 999px;
    background: var(--moss);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--moss) 14%, transparent);
  }
  .notebook__counter{
    display: inline-flex; align-items: baseline; gap: 6px;
    font-feature-settings: "tnum";
    font-family: var(--font-mono);
    color: var(--moss);
  }
  .notebook__counterSep{ color: color-mix(in srgb, var(--moss) 40%, transparent); }

  /* ── Viewport + track ─────────────────────────────────────────── */
  .notebook__viewport{
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* Reserve top/bottom space for chrome */
    padding-top: clamp(120px, 14vh, 180px);
    padding-bottom: clamp(60px, 8vh, 100px);
  }
  .notebook__track{
    height: 100%;
    display: flex;
    align-items: stretch;
    will-change: transform;
  }

  /* ── A single spread (left + right page) ──────────────────────── */
  .spread{
    flex: 0 0 100vw;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 12px 1fr;
    align-items: center;
    padding: 0 clamp(20px, 5vw, 80px);
    gap: 0;
  }

  .spread__page{
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(20px, 4vh, 56px) clamp(20px, 4vw, 56px);
    background:
      radial-gradient(80% 100% at 50% 0%,
        color-mix(in srgb, var(--paper) 50%, transparent),
        transparent 60%),
      var(--bone);
    position: relative;
  }

  /* ── Left page — drawing ──────────────────────────────────────── */
  .spread__page--left{
    align-items: center;
    color: var(--moss);
  }
  .spread__sketchwrap{
    width: clamp(180px, 30vw, 360px);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spread__sketchwrap :global(svg){
    width: 100%;
    height: 100%;
    color: var(--moss);
    overflow: visible;
  }
  /* The wash sits under the line like pigment under graphite. */
  .spread__sketchwrap :global([data-wash]){ mix-blend-mode: multiply; }

  /* Naturalist plate caption under each study. */
  .spread__fig{
    margin: clamp(14px, 2.4vh, 26px) 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 12px;
    color: color-mix(in srgb, var(--moss) 82%, transparent);
  }
  .spread__figNum{
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--moss) 60%, transparent);
  }
  .spread__figWord{
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1;
  }
  .spread__figLatin{
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    color: color-mix(in srgb, var(--moss) 55%, transparent);
  }
  /* The Director will set stroke-dasharray/offset to enable the
     self-draw. Per-path stroke-width is set inline in the SVG so
     individual lines carry pressure variance. */
  .spread__sketchwrap :global(svg path:not([data-wash])),
  .spread__sketchwrap :global(svg ellipse:not([data-wash])){
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Hide the defs container — it's just a definitions vehicle. */
  .notebook__defs{
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Center binding ───────────────────────────────────────────── */
  .spread__binding{
    width: 1px;
    height: 70%;
    background: linear-gradient(to bottom,
      transparent,
      color-mix(in srgb, var(--clay) 32%, transparent) 20%,
      color-mix(in srgb, var(--clay) 32%, transparent) 80%,
      transparent);
    margin: auto;
    box-shadow:
      4px 0 16px -8px rgba(14,15,12,.18),
      -4px 0 16px -8px rgba(14,15,12,.18);
  }

  /* ── Right page — photograph + caption ────────────────────────── */
  .spread__page--right{
    /* Plate width — capped by viewport HEIGHT too, so the 4:5 plate
       plus its caption always fit inside the pinned stage (on ~900px
       screens the caption used to sit under the progress ticks). */
    --plate-w: min(clamp(280px, 38vw, 480px), max(240px, calc((100svh - 400px) * .8)));
    gap: clamp(18px, 3vw, 36px);
  }
  .spread__media{
    position: relative;
    width: 100%;
    max-width: var(--plate-w);
    aspect-ratio: 4 / 5;
    margin: 0 auto;
    overflow: hidden;
    border-radius: var(--r-2);
    background: rgba(14,15,12,.04);
    box-shadow:
      0 30px 60px -16px rgba(14, 15, 12, .28),
      0 8px 22px -8px rgba(14, 15, 12, .18),
      0 0 0 1px color-mix(in srgb, var(--moss) 22%, rgba(14,15,12,.08));
  }
  .spread__media img{
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.04) contrast(1.05);
  }
  /* The photograph sits printed within the mat — no surface tricks. */
  .spread__media :global(img.spread__img){
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    filter: saturate(1.04) contrast(1.05);
  }
  .spread__inner-rule{
    position: absolute;
    inset: 6px;
    border: 1px solid color-mix(in srgb, var(--bone) 70%, transparent);
    pointer-events: none;
    border-radius: calc(var(--r-2) - 6px);
  }
  .spread__plate{
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(60% 60% at 50% 40%,
        color-mix(in srgb, var(--ink) 6%, transparent),
        transparent 70%);
  }
  .spread__plateGlyph{
    font-family: var(--font-display);
    font-size: clamp(64px, 9vw, 132px);
    color: color-mix(in srgb, var(--ink) 18%, transparent);
    letter-spacing: -0.02em;
  }

  .spread__meta{
    width: 100%;
    max-width: var(--plate-w);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .spread__caption{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    color: var(--ink);
    max-width: 32ch;
  }
  .spread__foot{
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-top: 1px solid color-mix(in srgb, var(--moss) 22%, rgba(14,15,12,.10));
    padding-top: 12px;
  }
  .spread__place{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }
  .spread__cta{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--moss);
    border-bottom: 1px solid color-mix(in srgb, var(--moss) 50%, transparent);
    padding-bottom: 1px;
    transition: color 400ms var(--ease-fluid), border-color 400ms var(--ease-fluid);
  }
  .spread__cta:hover{
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .spread__recto{
    position: absolute;
    bottom: clamp(12px, 2vh, 24px);
    right: clamp(20px, 3vw, 36px);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .26em;
    color: color-mix(in srgb, var(--moss) 60%, transparent);
  }

  /* Mobile: stack pages vertically — same content, no horizontal pin. */
  @media (max-width: 880px){
    .notebook{ height: auto; min-height: auto; }
    .notebook__viewport{ position: relative; height: auto; padding-top: clamp(80px, 12vh, 120px); padding-bottom: clamp(60px, 8vh, 100px); }
    .notebook__track{ flex-direction: column; height: auto; transform: none !important; }
    .spread{ flex: 0 0 auto; grid-template-columns: 1fr; height: auto; padding: clamp(40px, 8vw, 72px) clamp(20px, 5vw, 40px); }
    .spread__binding{ display: none; }
    .spread__page{ padding: clamp(20px, 4vw, 36px) 0; }
    .spread__page--left{ padding-bottom: clamp(36px, 6vw, 56px); }
  }

  /* Reduced-motion: identical to mobile (no pin/scroll lock). */
  @media (prefers-reduced-motion: reduce){
    .notebook{ height: auto; min-height: auto; }
    .notebook__viewport{ position: relative; height: auto; padding-top: clamp(80px, 12vh, 120px); padding-bottom: clamp(60px, 8vh, 100px); }
    .notebook__track{ flex-direction: column; height: auto; transform: none !important; }
    .spread{ flex: 0 0 auto; grid-template-columns: 1fr; height: auto; padding: clamp(40px, 8vw, 72px) clamp(20px, 5vw, 40px); }
    .spread__binding{ display: none; }
  }
</style>

---
import VoiceMark from "../motion/VoiceMark.astro";
import SmartImage from "../content/SmartImage.astro";
import type { Locale, VoiceTrack } from "../../lib/types";

interface Props {
  name?: string;
  signature?: string | null;
  /** Inline-edit binding for the signature line (e.g. "daniel.tagline_es"). */
  signatureField?: string | null;
  videoUrl?: string | null;
  posterUrl?: string | null;
  /** Inline-edit binding for the poster image URL. When set, the
   *  EditOverlay shows a "change photo" badge over the media in
   *  admin mode. */
  posterField?: string | null;
  meta?: string | null;
  index?: string | null;
  voice?: VoiceTrack | null;
  locale?: Locale;
}

const {
  name = "Daniel Nates",
  signature = null,
  signatureField = null,
  videoUrl = null,
  posterUrl = null,
  posterField = null,
  meta = "Querétaro · MMXXVI",
  index = "I / VII",
  voice = null,
  locale: propLocale,
} = Astro.props as Props;

const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

/* Monument type: the name breaks into stacked lines — first word,
 * then the rest — each revealed through its own mask. */
const parts = (name ?? "").trim().split(/\s+/).filter(Boolean);
const nameLines = parts.length > 1 ? [parts[0], parts.slice(1).join(" ")] : [name];
---

<section class="cold scene--ink" data-scene="ink" data-hero-scroll data-hero-intro>
  <div
    class="cold__media"
    data-hero-media
    data-edit-image-field={posterField ?? undefined}
    data-edit-badge="br"
    aria-hidden="true"
  >
    {videoUrl ? (
      <video
        data-hero-video
        muted playsinline loop preload="metadata"
        poster={posterUrl ?? undefined}
      >
        <source src={videoUrl} />
      </video>
    ) : posterUrl ? (
      <SmartImage
        src={posterUrl}
        alt=""
        eager
        widths={[800, 1200, 1800]}
        sizes="100vw"
      />
    ) : null}
    <div class="cold__scrim"></div>
  </div>

  {/* Hairline frame — film aperture motif */}
  <div class="cold__frame" aria-hidden="true">
    <span class="cold__rule cold__rule--top"></span>
    <span class="cold__rule cold__rule--bottom"></span>
  </div>

  {/* Corner metadata — three corners only; brand lives in the dock */}
  <div class="cold__corners" aria-hidden="true">
    {index ? <span class="cold__tr">{index}</span> : null}
    {meta ? <span class="cold__bl">{meta}</span> : null}
    <span class="cold__br">
      <span>Desliza</span>
      <span class="cold__chev">↓</span>
    </span>
  </div>

  {/* Voice — only if Daniel has uploaded an audio narration */}
  {voice ? (
    <VoiceMark
      voice={voice}
      locale={locale}
      variant="absolute"
      position="top-left"
      label={locale === "es" ? "Su voz" : "His voice"}
    />
  ) : null}

  {/* Title — monument type anchored to the lower-left. Each line
      rises through its own mask; the signature aligns with the
      second line's indent. */}
  <div class="cold__title" data-hero-inner>
    <p class="cold__eyebrow"><span>Capítulo 0</span></p>
    <h1 class="cold__name" aria-label={name}>
      {nameLines.map((line) => (
        <span class="cold__lineMask" aria-hidden="true">
          <span class="cold__lineInner">{line}</span>
        </span>
      ))}
    </h1>
    <p class="cold__sig" data-edit-field={signatureField ?? undefined}>{signature ?? "Técnica global. Territorio local."}</p>
  </div>
</section>

<style>
  .cold{
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ink);
    color: var(--bone);
    isolation: isolate;
  }

  /* Media — the photograph carries the scene. The grade keeps it
     honest (no heavy veil); only the lower band darkens so the
     monument type stays legible. */
  .cold__media{
    position: absolute; inset: 0;
    will-change: transform, filter, opacity;
    z-index: 0;
  }
  .cold__media :global(img),
  .cold__media video{
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .96;
    filter: saturate(1.02) contrast(1.05);
  }
  .cold__scrim{
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg,
        rgba(14,15,12,.55) 0%,
        rgba(14,15,12,.02) 26%,
        rgba(14,15,12,.02) 48%,
        rgba(14,15,12,.62) 78%,
        rgba(14,15,12,.94) 100%);
  }

  /* Hairline frame */
  .cold__frame{
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .cold__rule{
    position: absolute;
    left: clamp(20px, 4vw, 56px);
    right: clamp(20px, 4vw, 56px);
    height: 1px;
    background: rgba(244,239,230,.18);
  }
  .cold__rule--top{ top: clamp(76px, 9vh, 110px); }
  .cold__rule--bottom{ bottom: clamp(70px, 9vh, 110px); }

  /* Corner metadata */
  .cold__corners{
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 3;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(244,239,230,.72);
  }
  .cold__corners > *{
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .cold__tr{ top: clamp(28px, 4vh, 48px); right: clamp(20px, 4vw, 56px); font-variant-numeric: tabular-nums; }
  .cold__bl{ bottom: clamp(24px, 4vh, 44px); left: clamp(20px, 4vw, 56px); }
  .cold__br{ bottom: clamp(24px, 4vh, 44px); right: clamp(20px, 4vw, 56px); }
  .cold__chev{
    display: inline-block;
    animation: chev 3.4s cubic-bezier(0.4, 0, 0.2, 1) 1.6s infinite;
  }
  @keyframes chev{
    0%, 100% { transform: translateY(0); opacity: .7; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* Title — lower-left monument stack */
  .cold__title{
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding:
      0
      clamp(20px, 4vw, 56px)
      calc(clamp(70px, 9vh, 110px) + clamp(22px, 3vh, 36px));
    will-change: transform, opacity;
  }
  .cold__eyebrow{
    margin: 0 0 clamp(14px, 2vh, 24px);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: rgba(244,239,230,.72);
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .cold__eyebrow::before{
    content: "";
    width: clamp(28px, 4vw, 56px);
    height: 1px;
    background: rgba(244,239,230,.4);
  }

  .cold__name{
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(72px, 16.5vw, 300px);
    line-height: .9;
    letter-spacing: -0.03em;
    color: var(--bone);
  }
  /* Each line clips its own rise; padding protects descenders from
     the mask while the negative margin keeps leading optically tight. */
  .cold__lineMask{
    display: block;
    overflow: hidden;
    padding-bottom: .06em;
    margin-bottom: -.06em;
  }
  .cold__lineInner{
    display: inline-block;
    will-change: transform;
  }
  /* The second line steps right — type as architecture. */
  .cold__lineMask + .cold__lineMask .cold__lineInner{
    margin-left: clamp(36px, 11vw, 210px);
  }

  .cold__sig{
    margin: clamp(18px, 2.6vh, 30px) 0 0;
    margin-left: clamp(38px, 11.2vw, 214px);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(16px, 1.5vw, 22px);
    line-height: 1.45;
    color: rgba(244,239,230,.82);
    max-width: 40ch;
  }

  /* Intro pre-state — only when JS runs and motion is welcome. The
     director's hero timeline animates from exactly these values, so
     there is no flash between first paint and the first frame. */
  @media (prefers-reduced-motion: no-preference){
    :global(html.js) .cold__media{
      opacity: .55;
      transform: scale(1.1);
      filter: blur(16px);
    }
    :global(html.js) .cold__lineInner{ transform: translateY(112%); }
    :global(html.js) .cold__eyebrow,
    :global(html.js) .cold__sig,
    :global(html.js) .cold__corners,
    :global(html.js) .cold__frame{ opacity: 0; }
  }

  /* Small phones: the place line and the scroll cue collide — the
     place line wins, the cue goes. */
  @media (max-width: 480px){
    .cold__br{ display: none; }
  }

  @media (max-width: 720px){
    .cold__rule{ display: none; }
    .cold__bl, .cold__tr{ font-size: 10px; }
    .cold__name{ font-size: clamp(64px, 19vw, 120px); }
    .cold__lineMask + .cold__lineMask .cold__lineInner{ margin-left: clamp(20px, 9vw, 64px); }
    .cold__sig{ margin-left: 0; max-width: 34ch; }
    .cold__title{ padding-bottom: clamp(86px, 13vh, 120px); }
  }
  @media (prefers-reduced-motion: reduce){
    .cold__chev{ animation: none; }
  }
</style>

<script is:inline data-astro-rerun>
(function(){
  var v = document.querySelector('[data-hero-video]');
  if (!v) return;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var lite = navigator.connection && navigator.connection.saveData;
  if (reduce || lite) return;
  var io = new IntersectionObserver(function(es){
    var e = es[0]; if (!e) return;
    if (e.isIntersecting) v.play().catch(function(){});
    else v.pause();
  }, { threshold: .35 });
  io.observe(v);
})();
</script>

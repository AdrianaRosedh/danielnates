---
import TextReveal from "../motion/TextReveal.astro";
import VoiceMark from "../motion/VoiceMark.astro";
import WebGLPlane from "../motion/WebGLPlane.astro";
import type { Locale, VoiceTrack } from "../../lib/types";

interface Props {
  name?: string;
  signature?: string | null;
  videoUrl?: string | null;
  posterUrl?: string | null;
  meta?: string | null;
  index?: string | null;
  voice?: VoiceTrack | null;
  locale?: Locale;
}

const {
  name = "Daniel Nates",
  signature = null,
  videoUrl = null,
  posterUrl = null,
  meta = "Querétaro · MMXXVI",
  index = "I / VII",
  voice = null,
  locale: propLocale,
} = Astro.props as Props;

const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";
---

<section class="cold scene--ink" data-scene="ink" data-hero-scroll>
  <div class="cold__media" data-hero-media aria-hidden="true">
    {videoUrl ? (
      <video
        data-hero-video
        muted playsinline loop preload="metadata"
        poster={posterUrl ?? undefined}
      >
        <source src={videoUrl} />
      </video>
    ) : posterUrl ? (
      <WebGLPlane
        src={posterUrl}
        alt=""
        className="cold__plane"
        intensity={0.05}
        eager
      />
    ) : null}
    <div class="cold__scrim"></div>
    <div class="cold__warm" aria-hidden="true"></div>
  </div>

  {/* Hairline frame — film aperture motif */}
  <div class="cold__frame" aria-hidden="true">
    <span class="cold__rule cold__rule--top"></span>
    <span class="cold__rule cold__rule--bottom"></span>
  </div>

  {/* Corner metadata — three corners only; brand lives in the dock */}
  <div class="cold__corners" aria-hidden="true">
    {index ? <span class="cold__tr">{index}</span> : null}
    {meta ? <span class="cold__bl">{meta}</span> : null}
    <span class="cold__br">
      <span>Desliza</span>
      <span class="cold__chev">↓</span>
    </span>
  </div>

  {/* Voice — only if Daniel has uploaded an audio narration */}
  {voice ? (
    <VoiceMark
      voice={voice}
      locale={locale}
      variant="absolute"
      position="top-left"
      label={locale === "es" ? "Su voz" : "His voice"}
    />
  ) : null}

  {/* Title — single line, centered */}
  <div class="cold__title" data-hero-inner>
    <p class="cold__eyebrow"><span>Capítulo 0</span></p>
    <h1 class="cold__name">
      <TextReveal as="span" mode="letter" class="cold__nameText">{name}</TextReveal>
    </h1>
    <p class="cold__sig">{signature ?? "Técnica global. Territorio local."}</p>
  </div>
</section>

<style>
  .cold{
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    background: var(--ink);
    color: var(--bone);
    isolation: isolate;
  }

  /* Media */
  .cold__media{
    position: absolute; inset: 0;
    will-change: transform;
    z-index: 0;
  }
  .cold__media img,
  .cold__media video{
    width: 100%; height: 100%;
    object-fit: cover;
    /* Was .58 — too dim. The photo is THE asset; let it carry. The
       scrim below handles legibility for the title overlay. */
    opacity: .92;
    filter: saturate(1.02) contrast(1.06);
  }
  /* WebGL surface — same envelope as the still img it replaces.
     The shader handles its own grade; opacity matches for a seamless
     handoff when GL boots. */
  .cold__media .cold__plane{
    width: 100%;
    height: 100%;
  }
  .cold__media .cold__plane .gl__canvas{
    opacity: 0;
  }
  .cold__media .cold__plane[data-gl-active="1"] .gl__canvas{
    opacity: .96;
  }
  .cold__scrim{
    position: absolute; inset: 0;
    background:
      /* Stronger top + bottom darkening so the title and corner
         metadata stay legible even with the photo at full presence. */
      linear-gradient(180deg,
        rgba(14,15,12,.75) 0%,
        rgba(14,15,12,.05) 30%,
        rgba(14,15,12,.05) 55%,
        rgba(14,15,12,.92) 100%),
      /* Soft vignette around the title sweet spot. */
      radial-gradient(70% 50% at 50% 60%,
        rgba(14,15,12,0) 0%,
        rgba(14,15,12,.45) 100%);
  }
  /* Warm accents removed — kept the div for future use, hidden by default. */
  .cold__warm{ display: none; }

  /* Hairline frame */
  .cold__frame{
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .cold__rule{
    position: absolute;
    left: clamp(20px, 4vw, 56px);
    right: clamp(20px, 4vw, 56px);
    height: 1px;
    background: rgba(244,239,230,.18);
  }
  .cold__rule--top{ top: clamp(76px, 9vh, 110px); }
  .cold__rule--bottom{ bottom: clamp(70px, 9vh, 110px); }

  /* Corner metadata */
  .cold__corners{
    position: absolute; inset: 0;
    pointer-events: none;
    z-index: 3;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: rgba(244,239,230,.72);
  }
  .cold__corners > *{
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .cold__tr{ top: clamp(28px, 4vh, 48px); right: clamp(20px, 4vw, 56px); font-variant-numeric: tabular-nums; }
  .cold__bl{ bottom: clamp(24px, 4vh, 44px); left: clamp(20px, 4vw, 56px); }
  .cold__br{ bottom: clamp(24px, 4vh, 44px); right: clamp(20px, 4vw, 56px); }
  .cold__chev{
    display: inline-block;
    animation: chev 3.4s cubic-bezier(0.4, 0, 0.2, 1) 1.6s infinite;
  }
  @keyframes chev{
    0%, 100% { transform: translateY(0); opacity: .7; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* Title — center stack */
  .cold__title{
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(20px, 5vw, 80px);
    will-change: transform, opacity;
  }
  .cold__eyebrow{
    margin: 0 0 clamp(20px, 3vw, 36px);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: rgba(244,239,230,.7);
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .cold__eyebrow::before,
  .cold__eyebrow::after{
    content: "";
    width: clamp(28px, 4vw, 56px);
    height: 1px;
    background: rgba(244,239,230,.35);
  }

  .cold__name{
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(56px, 11vw, 156px);
    line-height: 1;
    letter-spacing: -0.025em;
    word-spacing: .02em;
    color: var(--bone);
    margin: 0;
    white-space: nowrap;        /* keep "Daniel Nates" on a single line */
  }
  /* Allow wrapping only on truly tiny viewports */
  @media (max-width: 420px){
    .cold__name{ white-space: normal; text-wrap: balance; }
  }

  .cold__sig{
    margin: clamp(28px, 3.4vw, 44px) 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(16px, 1.5vw, 22px);
    line-height: 1.45;
    color: rgba(244,239,230,.78);
    max-width: 36ch;
  }

  @media (max-width: 720px){
    .cold__rule{ display: none; }
    .cold__bl, .cold__tr{ font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce){
    .cold__chev{ animation: none; }
  }
</style>

<script is:inline>
{`
(function(){
  var v = document.querySelector('[data-hero-video]');
  if (!v) return;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var lite = navigator.connection && navigator.connection.saveData;
  if (reduce || lite) return;
  var io = new IntersectionObserver(function(es){
    var e = es[0]; if (!e) return;
    if (e.isIntersecting) v.play().catch(function(){});
    else v.pause();
  }, { threshold: .35 });
  io.observe(v);
})();
`}
</script>

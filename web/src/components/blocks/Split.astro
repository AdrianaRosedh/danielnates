---
import type { Locale, SplitBlock } from "../../lib/types";
import { t2, tb2 } from "../../lib/i18n";
import PortableText from "../content/PortableText.astro";

interface Props { block: SplitBlock; locale?: Locale }
const { block, locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

const orient = block.orientation ?? "media-left";
const heading = t2(block.heading_es, block.heading_en, locale);
const body = tb2(block.body_es, block.body_en, locale);
const src = block.image_url ?? null;
---

<section class={`split split--${orient} reveal`}>
  <div class="split__media">
    {block.videoUrl ? (
      <video data-block-video muted playsinline loop preload="metadata" poster={src ?? undefined}>
        <source src={block.videoUrl} />
      </video>
    ) : src ? (
      <img src={src} alt={heading} loading="lazy" decoding="async" />
    ) : null}
  </div>
  <div class="split__body">
    {block.eyebrow ? <p class="kicker">{block.eyebrow}</p> : null}
    {heading ? <h2 class="split__heading">{heading}</h2> : null}
    {body.length ? <PortableText value={body} /> : null}
  </div>
</section>

<style>
  .split{
    margin: 26px 0;
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 880px){
    .split{ grid-template-columns: 1fr 1fr; gap: 32px; }
    .split--media-right .split__media{ order: 2; }
  }
  .split__media img,
  .split__media video{
    width: 100%;
    height: auto;
    border-radius: var(--radius2);
    display: block;
    background: rgba(255,255,255,.04);
  }
  .split__heading{ margin: 6px 0 12px; font-size: clamp(22px, 3vw, 34px); letter-spacing: -.02em; line-height: 1.1; }
</style>

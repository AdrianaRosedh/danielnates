---
import type { ImageBlockData } from "../../lib/types";
import SmartImage from "../content/SmartImage.astro";

interface Props { block: ImageBlockData }
const { block } = Astro.props as Props;

const layout = block.layout ?? "inline";
const src = block.image_url ?? null;
const alt = block.alt ?? block.caption ?? "";
---

{src ? (
  <figure class={`imageBlock imageBlock--${layout} reveal`}>
    <SmartImage src={src} alt={alt} sizes="(min-width: 1240px) 1160px, 100vw" />
    {block.caption ? <figcaption>{block.caption}</figcaption> : null}
  </figure>
) : null}

<style>
  .imageBlock{ margin: 22px 0; }
  .imageBlock :global(img){ width: 100%; height: auto; display: block; border-radius: var(--radius2); }
  .imageBlock figcaption{
    margin-top: 10px; font-size: 12px; color: var(--muted2); letter-spacing: .04em;
  }
  .imageBlock--full :global(img){ border-radius: var(--radius); }
  .imageBlock--bleed{ margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
  .imageBlock--bleed :global(img){ border-radius: 0; }
</style>

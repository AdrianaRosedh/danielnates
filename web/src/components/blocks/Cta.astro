---
import type { CtaBlock } from "../../lib/types";

interface Props { block: CtaBlock }
const { block } = Astro.props as Props;
---

<div class="ctaBlock reveal-stagger">
  {block.label && block.href ? (
    <a class="cta cta--primary" href={block.href} target={block.href.startsWith("http") ? "_blank" : undefined} rel={block.href.startsWith("http") ? "noreferrer" : undefined}>
      {block.label}
    </a>
  ) : null}
  {block.secondaryLabel && block.secondaryHref ? (
    <a class="cta cta--secondary" href={block.secondaryHref} target={block.secondaryHref.startsWith("http") ? "_blank" : undefined} rel={block.secondaryHref.startsWith("http") ? "noreferrer" : undefined}>
      {block.secondaryLabel}
    </a>
  ) : null}
</div>

<style>
  .ctaBlock{ display: flex; gap: 10px; flex-wrap: wrap; margin: 22px 0; }
  .ctaBlock .cta{
    font-size: 13px; padding: 12px 16px; border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--brand-primary) 55%, rgba(255,255,255,.12));
    background: color-mix(in srgb, var(--brand-primary) 22%, rgba(255,255,255,.02));
    transition: background .2s, border-color .2s, transform .2s;
  }
  .ctaBlock .cta:hover{ background: color-mix(in srgb, var(--brand-primary) 32%, rgba(255,255,255,.04)); transform: translateY(-1px); }
  .ctaBlock .cta--secondary{
    background: rgba(255,255,255,.03);
    border-color: rgba(255,255,255,.14);
  }
</style>

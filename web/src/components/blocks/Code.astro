---
import type { CodeBlock } from "../../lib/types";

interface Props { block: CodeBlock }
const { block } = Astro.props as Props;
---

{block.code ? (
  <figure class="codeBlock reveal">
    <pre><code data-lang={block.language ?? "text"}>{block.code}</code></pre>
    {block.caption ? <figcaption>{block.caption}</figcaption> : null}
  </figure>
) : null}

<style>
  .codeBlock{ margin: 22px 0; }
  .codeBlock pre{
    margin: 0;
    padding: 18px 20px;
    border-radius: var(--radius2);
    background: rgba(0,0,0,.45);
    border: 1px solid rgba(255,255,255,.08);
    color: rgba(245,245,245,.92);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace;
    font-size: 13px;
    line-height: 1.55;
    overflow: auto;
  }
  .codeBlock code{ display: block; white-space: pre; }
  .codeBlock figcaption{ font-size: 12px; color: var(--muted2); margin-top: 8px; }
</style>

---
import type { QuoteBlock } from "../../lib/types";

interface Props { block: QuoteBlock }
const { block } = Astro.props as Props;
const tone = block.tone ?? "editorial";
---

{block.text ? (
  <blockquote class={`quoteBlock quoteBlock--${tone} reveal`}>
    <p>{block.text}</p>
    {block.attribution ? <cite>— {block.attribution}</cite> : null}
  </blockquote>
) : null}

<style>
  .quoteBlock{
    margin: 26px auto;
    padding: 18px 18px;
    border-left: 2px solid var(--brand-glow);
    background: rgba(255,255,255,.03);
    border-radius: 14px;
    max-width: 72ch;
  }
  .quoteBlock p{ margin: 0; line-height: 1.55; color: rgba(255,255,255,.86); }
  .quoteBlock cite{ display: block; margin-top: 10px; color: var(--muted2); font-style: normal; font-size: 12px; letter-spacing: .04em; }

  .quoteBlock--pull{
    border-left: 0;
    text-align: center;
    background: transparent;
    padding: 24px 8px;
    max-width: 28ch;
  }
  .quoteBlock--pull p{
    font-size: clamp(22px, 3.4vw, 38px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: rgba(255,255,255,.94);
  }
</style>

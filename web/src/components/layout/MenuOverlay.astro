---
import { aboutHref, dayHref, href, pressHref, projectsHref, switchLocale, t2, ui } from "../../lib/i18n";
import { getProjects } from "../../lib/queries";
import type { Locale, Person } from "../../lib/types";
import SmartImage from "../content/SmartImage.astro";
import { chapterMedia } from "../../lib/chapter-media";
import { MEDIA } from "../../lib/site";
import { sketchDefs, sketchSvg, type SketchKind } from "../../lib/sketches";

interface Props {
  locale?: Locale;
  daniel?: Person | null;
}

const { locale: localeProp, daniel = null } = Astro.props as Props;
const locale: Locale = localeProp ?? Astro.locals.locale ?? "es";

const otherLocale: Locale = locale === "es" ? "en" : "es";
const otherPath = switchLocale(Astro.url.pathname, otherLocale);

const primary = [
  { pv: "inicio", label: ui("home", locale), href: href("/", locale) },
  { pv: "sobre", label: locale === "es" ? "Sobre" : "About", href: aboutHref(locale) },
  { pv: "dia", label: locale === "es" ? "Día" : "Day", href: dayHref(locale) },
  { pv: "diario", label: locale === "es" ? "Diario" : "Journal", href: href("/diario", locale) },
  { pv: "arte", label: locale === "es" ? "Arte" : "Art", href: href("/arte", locale) },
  { pv: "proyectos", label: locale === "es" ? "Proyectos" : "Projects", href: projectsHref(locale) },
  { pv: "prensa", label: locale === "es" ? "Prensa" : "Press", href: pressHref(locale) },
  { pv: "contacto", label: locale === "es" ? "Contacto" : "Contact", href: href("/contacto", locale) },
];

/* Project shortcuts pull from the published projects in the DB so any
 * new project added in admin appears here automatically. The meta line
 * comes from each project's framing.meta_es/en (admin-editable). */
const dbProjects = await getProjects();
const projects = dbProjects.map((p) => ({
  pv: `p-${p.slug}`,
  slug: p.slug,
  poster: p.hero_image_url ?? chapterMedia(p.slug)?.poster ?? null,
  label: p.title,
  meta: t2(p.framing?.meta_es, p.framing?.meta_en, locale),
  href: href(`/${p.slug}`, locale),
}));

const email = daniel?.social?.email ?? null;
const igDaniel = daniel?.social?.instagram ?? null;
const ig1 = daniel?.social?.olivea_instagram ?? null;
const ig2 = daniel?.social?.fritanguita_instagram ?? null;

const here = Astro.url.pathname;
function isCurrent(path: string): boolean {
  if (path === here) return true;
  if (path !== "/" && path !== "/en" && here.startsWith(path)) return true;
  return false;
}

/* Preview panel — what each destination looks like, shown beside the
 * list on hover/focus (wide, hover-capable screens). Photographic
 * rooms get a photograph; written rooms get one of the notebook
 * figures. Defaults to the room you're in. */
type Preview =
  | { key: string; kind: "photo"; src: string; pos?: string; zoom?: number; cap: string }
  | { key: string; kind: "sketch"; sketch: SketchKind; cap: string };
const es = locale === "es";
const previews: Preview[] = [
  { key: "inicio", kind: "photo", src: MEDIA.portrait, pos: "60% 50%", cap: es ? "La película" : "The film" },
  { key: "sobre", kind: "photo", src: MEDIA.portrait, pos: "70% 34%", zoom: 1.35, cap: "Daniel Nates" },
  { key: "dia", kind: "sketch", sketch: "mesa", cap: es ? "Fig. — la mesa" : "Fig. — the table" },
  { key: "diario", kind: "sketch", sketch: "cazo", cap: es ? "Fig. — el cazo" : "Fig. — the pot" },
  { key: "arte", kind: "sketch", sketch: "leaf", cap: es ? "Fig. — olivo" : "Fig. — olive" },
  { key: "proyectos", kind: "photo", src: "/media/stills/olivea-poster.jpg", pos: "45% 50%", cap: es ? "Tres cocinas" : "Three kitchens" },
  { key: "prensa", kind: "sketch", sketch: "milpa", cap: es ? "Fig. — milpa" : "Fig. — milpa" },
  { key: "contacto", kind: "sketch", sketch: "mano", cap: es ? "Fig. — la mano" : "Fig. — the hand" },
  ...projects.filter((p) => p.poster).map((p) => ({ key: p.pv, kind: "photo" as const, src: p.poster!, pos: chapterMedia(p.slug)?.portraitX ? `${chapterMedia(p.slug)!.portraitX} 50%` : "50% 50%", cap: p.label })),
];
const previewSketches = [...new Set(previews.flatMap((p) => (p.kind === "sketch" ? [p.sketch] : [])))];
const currentPv =
  primary.find((i) => isCurrent(i.href) && i.pv !== "inicio")?.pv ??
  projects.find((p) => isCurrent(p.href))?.pv ??
  "inicio";
---

<div class="overlay" data-menu-overlay aria-hidden="true">
  <div class="overlay__bg" data-menu-bg></div>

  <div class="overlay__inner" role="dialog" aria-modal="true" aria-label={locale === "es" ? "Menú principal" : "Main menu"}>
    {/* Top bar — brand mark + close */}
    <div class="overlay__top">
      <a class="overlay__brand" href={locale === "es" ? "/" : "/en"}>
        <span class="overlay__dot" aria-hidden="true"></span>
        <span>Daniel Nates</span>
      </a>
      <button class="overlay__close" type="button" data-menu-close aria-label={locale === "es" ? "Cerrar" : "Close"}>
        <span class="overlay__closeText">{locale === "es" ? "Cerrar" : "Close"}</span>
        <span class="overlay__closeMark" aria-hidden="true"></span>
      </button>
    </div>

    {/* Primary nav */}
    <nav class="overlay__nav" aria-label="Primary">
      <ol>
        {primary.map((item, i) => (
          <li class={isCurrent(item.href) ? "is-current" : ""}>
            <a href={item.href} data-menu-link data-pv={item.pv}>
              <span class="overlay__num">{String(i + 1).padStart(2, "0")}</span>
              <span class="overlay__label">{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {/* Preview — crossfades to whatever you're pointing at. */}
    <aside class="overlay__preview" aria-hidden="true" data-menu-preview data-current={currentPv}>
      <svg class="overlay__pvDefs" width="0" height="0" focusable="false"><defs set:html={sketchDefs(previewSketches, "mn")} /></svg>
      {previews.map((p) => (
        <figure class:list={["overlay__pv", `overlay__pv--${p.kind}`, { "is-active": p.key === currentPv }]} data-pv-layer={p.key}>
          {p.kind === "photo" ? (
            <div class="overlay__pvPhoto" style={`--pos: ${p.pos ?? "50% 50%"}; --zoom: ${p.zoom ?? 1};`}>
              <SmartImage src={p.src} alt="" widths={[480, 800]} sizes="30vw" />
            </div>
          ) : (
            <div class="overlay__pvSketch" set:html={sketchSvg(p.sketch, "mn")} />
          )}
          <figcaption class="overlay__pvCap">{p.cap}</figcaption>
        </figure>
      ))}
    </aside>

    {/* Project shortcuts */}
    <div class="overlay__projects">
      <p class="overlay__group">{locale === "es" ? "Proyectos" : "Projects"}</p>
      <ul>
        {projects.map((p) => (
          <li class={isCurrent(p.href) ? "is-current" : ""}>
            <a href={p.href} data-menu-link data-pv={p.pv}>
              <span class="overlay__projLabel">{p.label}</span>
              <span class="overlay__projMeta">{p.meta}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Footer row */}
    <div class="overlay__foot">
      <div class="overlay__foot-col">
        <p class="overlay__group">{locale === "es" ? "Idioma" : "Language"}</p>
        <a class="overlay__footLink" href={otherPath}>
          {otherLocale === "en" ? "English" : "Español"} ↗
        </a>
      </div>
      {email ? (
        <div class="overlay__foot-col">
          <p class="overlay__group">{locale === "es" ? "Escribe" : "Write"}</p>
          <a class="overlay__footLink" href={`mailto:${email}`}>{email}</a>
        </div>
      ) : igDaniel ? (
        <div class="overlay__foot-col">
          <p class="overlay__group">Daniel</p>
          <a class="overlay__footLink" href={igDaniel} target="_blank" rel="noreferrer">Instagram ↗</a>
        </div>
      ) : null}
      <div class="overlay__foot-col">
        <p class="overlay__group">Olivea</p>
        {ig1 ? <a class="overlay__footLink" href={ig1} target="_blank" rel="noreferrer">Instagram ↗</a> : null}
      </div>
      <div class="overlay__foot-col">
        <p class="overlay__group">Fritanguita</p>
        {ig2 ? <a class="overlay__footLink" href={ig2} target="_blank" rel="noreferrer">Instagram ↗</a> : null}
      </div>
    </div>
  </div>
</div>

<style>
  .overlay{
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    visibility: hidden;
  }
  .overlay.is-open{
    pointer-events: auto;
    visibility: visible;
  }

  .overlay__bg{
    position: absolute; inset: 0;
    background: rgba(8, 9, 10, .94);
    backdrop-filter: blur(0px) saturate(100%);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    opacity: 0;
    transition:
      opacity 1100ms var(--ease-fluid),
      backdrop-filter 1300ms var(--ease-fluid),
      -webkit-backdrop-filter 1300ms var(--ease-fluid);
  }
  .overlay.is-open .overlay__bg{
    opacity: 1;
    backdrop-filter: blur(32px) saturate(140%);
    -webkit-backdrop-filter: blur(32px) saturate(140%);
  }

  .overlay__inner{
    position: relative;
    height: 100%;
    width: 100%;
    color: var(--bone);
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.4vw, 32px) clamp(20px, 5vw, 80px);
    /* Belt-and-suspenders: if anything ever overflows on a tiny
       viewport, the overlay scrolls instead of clipping. */
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 900ms var(--ease-fluid) 200ms,
      transform 1100ms var(--ease-fluid) 200ms;
  }
  .overlay.is-open .overlay__inner{
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .overlay__top{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(28px, 4vw, 56px);
    flex: 0 0 auto;
  }
  .overlay__brand{
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--bone);
    transition: opacity 600ms var(--ease-fluid);
  }
  .overlay__brand:hover{ opacity: .65; }
  .overlay__dot{
    width: 8px; height: 8px;
    border-radius: 999px;
    background: var(--bone);
    box-shadow: 0 0 0 3px rgba(244,239,230,.18);
  }

  .overlay__close{
    appearance: none;
    background: transparent;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--bone);
    transition: opacity 600ms var(--ease-fluid);
  }
  .overlay__close:hover{ opacity: .65; }
  .overlay__closeMark::before,
  .overlay__closeMark::after{
    transition: transform 700ms var(--ease-fluid);
  }
  .overlay__close:hover .overlay__closeMark::before{ transform: rotate(135deg); }
  .overlay__close:hover .overlay__closeMark::after{ transform: rotate(45deg); }
  .overlay__closeMark{
    position: relative;
    width: 16px; height: 16px;
  }
  .overlay__closeMark::before,
  .overlay__closeMark::after{
    content: "";
    position: absolute;
    top: 50%; left: 0;
    width: 100%; height: 1px;
    background: currentColor;
    transform-origin: center;
  }
  .overlay__closeMark::before{ transform: rotate(45deg); }
  .overlay__closeMark::after{ transform: rotate(-45deg); }

  /* Primary nav — big serif stack. Sized off both viewport WIDTH and
     HEIGHT so 8 items always fit alongside the projects + footer. */
  .overlay__nav{
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
  }
  .overlay__nav ol{
    list-style: none;
    margin: 0; padding: 0;
    display: flex; flex-direction: column;
    gap: clamp(2px, 0.3vh, 8px);
    width: 100%;
  }
  .overlay__nav li{
    overflow: hidden;
    transform: translateY(64px);
    opacity: 0;
    filter: blur(8px);
    transition:
      transform 1400ms var(--ease-fluid),
      opacity 1100ms var(--ease-fluid),
      filter 1100ms var(--ease-fluid);
  }
  .overlay.is-open .overlay__nav li{
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
  }
  .overlay.is-open .overlay__nav li:nth-child(1){ transition-delay: 280ms; }
  .overlay.is-open .overlay__nav li:nth-child(2){ transition-delay: 350ms; }
  .overlay.is-open .overlay__nav li:nth-child(3){ transition-delay: 420ms; }
  .overlay.is-open .overlay__nav li:nth-child(4){ transition-delay: 490ms; }
  .overlay.is-open .overlay__nav li:nth-child(5){ transition-delay: 560ms; }
  .overlay.is-open .overlay__nav li:nth-child(6){ transition-delay: 630ms; }
  .overlay.is-open .overlay__nav li:nth-child(7){ transition-delay: 700ms; }

  .overlay__nav a{
    display: inline-flex;
    align-items: baseline;
    gap: clamp(16px, 2vw, 32px);
    font-family: var(--font-display);
    /* min(width, height) so the 8-item stack always fits the viewport
       even when the window is short. ~5.5svh per line × 8 items keeps
       us under half the viewport for the nav alone. */
    font-size: clamp(40px, min(7.2vw, 5.6svh), 96px);
    line-height: .96;
    letter-spacing: -0.025em;
    color: var(--bone);
    transition: color 800ms var(--ease-fluid), opacity 800ms var(--ease-fluid);
  }
  .overlay__num{
    font-family: var(--font-mono);
    font-size: clamp(11px, 1.2vw, 14px);
    letter-spacing: .14em;
    color: rgba(244,239,230,.4);
    align-self: flex-start;
    padding-top: clamp(14px, 2vw, 24px);
    transition: color 800ms var(--ease-fluid);
  }
  .overlay__label{
    position: relative;
    display: inline-block;
    transform-origin: left center;
    transition: transform 900ms var(--ease-fluid);
  }
  .overlay__nav li.is-current .overlay__label{ font-style: italic; color: rgba(244,239,230,.96); }
  .overlay__nav li.is-current .overlay__num{ color: var(--ember, #D9421C); }
  .overlay__nav a:hover .overlay__label{ font-style: italic; transform: translateX(8px); }
  .overlay__nav a:hover .overlay__num{ color: var(--bone); }

  /* Projects */
  .overlay__projects{
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(18px, 2vw, 28px);
    border-top: 1px solid rgba(244,239,230,.10);
    flex: 0 0 auto;
  }
  .overlay__projects ul{
    list-style: none; margin: 12px 0 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 720px){
    .overlay__projects ul{ grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
  .overlay__projects a{
    display: flex; flex-direction: column; gap: 2px;
    color: var(--bone);
    transition: opacity 700ms var(--ease-fluid), transform 700ms var(--ease-fluid);
  }
  .overlay__projects a:hover{ opacity: .65; transform: translateY(-2px); }
  .overlay__projLabel{
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 26px);
    letter-spacing: -0.01em;
  }
  .overlay__projMeta{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(244,239,230,.5);
  }
  .overlay__projects li.is-current .overlay__projLabel{ font-style: italic; }

  .overlay__group{
    margin: 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(244,239,230,.45);
  }

  /* Footer */
  .overlay__foot{
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(16px, 2vw, 24px);
    border-top: 1px solid rgba(244,239,230,.10);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    flex: 0 0 auto;
  }
  @media (min-width: 720px){ .overlay__foot{ grid-template-columns: repeat(4, 1fr); } }
  .overlay__foot-col{ display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .overlay__footLink{
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(244,239,230,.88);
    word-break: break-word;
    transition: color 700ms var(--ease-fluid);
  }
  .overlay__footLink:hover{ color: var(--ember, #D9421C); }

  /* ── Preview panel (wide + hover-capable screens only) ── */
  .overlay__preview{ display: none; }
  .overlay__pvDefs{ position: absolute; width: 0; height: 0; }
  @media (min-width: 1100px) and (hover: hover){
    .overlay__preview{
      display: block;
      position: absolute;
      right: clamp(20px, 5vw, 80px);
      top: clamp(96px, 13svh, 140px);
      height: min(46svh, 520px);
      aspect-ratio: 4 / 5;
      pointer-events: none;
    }
  }
  .overlay__pv{
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.035);
    transition: opacity 700ms var(--ease-fluid), transform 1400ms var(--ease-fluid);
  }
  .overlay__pv.is-active{ opacity: 1; transform: none; }
  .overlay__pvPhoto{ position: absolute; inset: 0; overflow: hidden; }
  .overlay__pvPhoto :global(img){
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--pos, 50% 50%);
    filter: contrast(1.05) brightness(.88);
  }
  .overlay__pv--sketch{
    display: grid;
    place-items: center;
    border: 1px solid rgba(244,239,230,.10);
    background: radial-gradient(70% 60% at 50% 45%, rgba(244,239,230,.05), transparent 70%);
  }
  .overlay__pvSketch{ width: 76%; color: rgba(244,239,230,.86); }
  .overlay__pvSketch :global(svg){ display: block; width: 100%; height: auto; overflow: visible; }
  .overlay__pvSketch :global([data-wash]){ mix-blend-mode: screen; }
  .overlay__pvCap{
    position: absolute;
    left: 0;
    bottom: -30px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: rgba(244,239,230,.6);
  }

  @media (prefers-reduced-motion: reduce){
    .overlay__pv{ transition: opacity .2s; transform: none; }
    .overlay__bg, .overlay__inner, .overlay__nav li{
      transition: opacity .2s !important;
      transform: none !important;
    }
  }
</style>

<script>
  // Preview panel: follow the pointer/focus across menu links; fall
  // back to the current room when the pointer leaves the list.
  function bindPreview() {
    const panel = document.querySelector<HTMLElement>("[data-menu-preview]");
    if (!panel) return;
    const p = panel as HTMLElement & { __bound?: boolean };
    if (p.__bound) return;
    p.__bound = true;
    const layers = new Map<string, HTMLElement>();
    panel.querySelectorAll<HTMLElement>("[data-pv-layer]").forEach((l) => layers.set(l.dataset.pvLayer!, l));
    const show = (key?: string) => {
      const k = key && layers.has(key) ? key : panel.dataset.current ?? "inicio";
      layers.forEach((el, id) => el.classList.toggle("is-active", id === k));
    };
    document.querySelectorAll<HTMLAnchorElement>("[data-menu-overlay] a[data-pv]").forEach((a) => {
      a.addEventListener("pointerenter", () => show(a.dataset.pv));
      a.addEventListener("focus", () => show(a.dataset.pv));
    });
    // Revert only when leaving a whole list — per-link leave would
    // flash back to the current room in the gaps between items.
    document.querySelectorAll<HTMLElement>("[data-menu-overlay] .overlay__nav, [data-menu-overlay] .overlay__projects")
      .forEach((list) => list.addEventListener("pointerleave", () => show()));
  }
  bindPreview();
  document.addEventListener("astro:page-load", bindPreview);
</script>

---
/**
 * WebGLPlane — Lifts a still photograph into a living, breathing surface.
 *
 * Renders the image as a fragment-shaded plane with:
 *   - Mouse-driven displacement (the photo ripples around the cursor)
 *   - Scroll-driven chromatic aberration + brightness envelope
 *   - Subtle ambient noise so the image is never frozen
 *
 * Boots lazily on intersection. Falls back to a plain <img> when:
 *   - WebGL is unavailable
 *   - prefers-reduced-motion: reduce
 *   - navigator.connection.saveData (lite network)
 *
 * Use the wrapper class `gl` to size the surface; the canvas + img fill
 * 100% of it. Pass `className` to attach scene-specific CSS.
 */

interface Props {
  src: string;
  alt?: string;
  className?: string;
  /** Mouse displacement strength (0..0.2, default 0.04). */
  intensity?: number;
  /** Drive chromatic aberration from scroll progress (default true). */
  scrollChroma?: boolean;
  /** CSS aspect-ratio value (e.g. "4/5") — optional, host can also size. */
  ratio?: string;
  /** Eager loading + decoding for above-the-fold images. */
  eager?: boolean;
}

const {
  src,
  alt = "",
  className = "",
  intensity = 0.04,
  scrollChroma = true,
  ratio,
  eager = false,
} = Astro.props as Props;
---

<div
  class={`gl ${className}`}
  data-gl-plane
  data-gl-intensity={intensity}
  data-gl-scroll-chroma={scrollChroma ? "1" : "0"}
  style={ratio ? `aspect-ratio: ${ratio};` : undefined}
>
  <img
    class="gl__img"
    src={src}
    alt={alt}
    data-gl-img
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    crossorigin="anonymous"
  />
  <canvas class="gl__canvas" data-gl-canvas aria-hidden="true"></canvas>
</div>

<style is:global>
  .gl{
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }
  .gl__img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gl__canvas{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gl[data-gl-active="1"] .gl__img{ opacity: 0; }
  .gl[data-gl-active="1"] .gl__canvas{ opacity: 1; }
  /* On hover-capable devices the canvas accepts pointer events to feed
     the displacement shader. Touch devices keep it inert. */
  @media (hover: hover){
    .gl[data-gl-active="1"]{ cursor: crosshair; }
  }
</style>

<script>
  import { Renderer, Triangle, Program, Mesh, Texture } from "ogl";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const lite = ((navigator as unknown) as { connection?: { saveData?: boolean } })
    .connection?.saveData === true;

  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  }

  if (!reduce && !lite && hasWebGL()) {
    if (document.readyState === "complete") bootAll();
    else window.addEventListener("load", bootAll, { once: true });
    document.addEventListener("astro:page-load", bootAll);
  }

  function bootAll() {
    const planes = document.querySelectorAll<HTMLElement>(
      "[data-gl-plane]:not([data-gl-watch])",
    );
    if (!planes.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (
            e.isIntersecting &&
            !(e.target as HTMLElement & { __glBooted?: boolean }).__glBooted
          ) {
            (e.target as HTMLElement & { __glBooted?: boolean }).__glBooted = true;
            bootPlane(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: "200px 0px" },
    );

    planes.forEach((p) => {
      p.setAttribute("data-gl-watch", "1");
      io.observe(p);
    });
  }

  const VERT = /* glsl */ `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main(){
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  const FRAG = /* glsl */ `
    precision highp float;
    varying vec2 vUv;
    uniform sampler2D tMap;
    uniform vec2 uMouse;
    uniform float uTime;
    uniform float uScroll;
    uniform float uHover;
    uniform float uIntensity;
    uniform vec2 uImageRatio;
    uniform float uChromaOn;

    float hash(vec2 p){
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    void main(){
      // object-fit: cover semantics — keep image filling without stretch
      vec2 uv = (vUv - 0.5) * uImageRatio + 0.5;

      vec2 toMouse = uv - uMouse;
      float d = length(toMouse);

      // Magnifying-lens style ripple around the cursor.
      // exp falloff keeps the effect tight and physical.
      float lensFalloff = exp(-d * 7.0) * uHover;
      vec2 lens = -normalize(toMouse + vec2(0.00001)) * lensFalloff * uIntensity;

      // Quiet ambient drift — the photo is never quite frozen.
      vec2 ambient = vec2(
        sin(uv.y * 5.5 + uTime * 0.35),
        cos(uv.x * 5.5 + uTime * 0.28)
      ) * 0.0022;

      vec2 displaced = uv + lens + ambient;

      // Chromatic aberration — picks up with scroll past the section.
      float chroma = (uScroll * 0.010 + uHover * 0.006) * uChromaOn;
      vec2 cDir = normalize(toMouse + vec2(0.00001));

      float r = texture2D(tMap, displaced + cDir * chroma).r;
      float g = texture2D(tMap, displaced).g;
      float b = texture2D(tMap, displaced - cDir * chroma).b;
      float a = texture2D(tMap, displaced).a;

      vec3 col = vec3(r, g, b);

      // Painterly grain — keeps the surface alive at any scale.
      float grain = (hash(uv * 800.0 + uTime) - 0.5) * 0.025;
      col += grain;

      // Tasteful saturation + contrast lift to match the editorial look.
      float lum = dot(col, vec3(0.299, 0.587, 0.114));
      col = mix(vec3(lum), col, 1.06);
      col = (col - 0.5) * 1.04 + 0.5;

      // Vignette — gentle, breathes a touch on hover.
      float vig = smoothstep(1.15, 0.35, length(vUv - 0.5));
      col *= mix(0.94, 1.02, vig);

      // Brightness envelope — small dim-out as scroll passes the section,
      // keeps us in dialogue with the existing scroll fade choreography.
      float envelope = mix(1.0, 0.94, smoothstep(0.65, 1.0, uScroll));
      col *= envelope;

      gl_FragColor = vec4(col, a);
    }
  `;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function bootPlane(host: HTMLElement) {
    const img = host.querySelector<HTMLImageElement>("[data-gl-img]");
    const canvas = host.querySelector<HTMLCanvasElement>("[data-gl-canvas]");
    if (!img || !canvas) return;

    const intensity = parseFloat(host.dataset.glIntensity ?? "0.04");
    const chromaOn = host.dataset.glScrollChroma === "1" ? 1 : 0;

    let renderer: ReturnType<typeof makeRenderer>;
    try {
      renderer = makeRenderer(canvas);
    } catch {
      return; // GL context creation failed — leave img visible
    }
    const gl = renderer.gl;
    gl.clearColor(0, 0, 0, 0);

    const geometry = new Triangle(gl);

    const texture = new Texture(gl, {
      generateMipmaps: false,
      minFilter: gl.LINEAR,
      magFilter: gl.LINEAR,
    });

    const program = new Program(gl, {
      vertex: VERT,
      fragment: FRAG,
      uniforms: {
        tMap: { value: texture },
        uMouse: { value: [0.5, 0.5] },
        uTime: { value: 0 },
        uScroll: { value: 0 },
        uHover: { value: 0 },
        uIntensity: { value: intensity },
        uImageRatio: { value: [1, 1] },
        uChromaOn: { value: chromaOn },
      },
      transparent: true,
    });

    const mesh = new Mesh(gl, { geometry, program });

    function computeRatio() {
      if (!img!.naturalWidth || !img!.naturalHeight) return;
      const r = host.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const planeAspect = r.width / r.height;
      const imgAspect = img!.naturalWidth / img!.naturalHeight;
      if (planeAspect > imgAspect) {
        program.uniforms.uImageRatio.value = [1, imgAspect / planeAspect];
      } else {
        program.uniforms.uImageRatio.value = [planeAspect / imgAspect, 1];
      }
    }

    function attachTexture() {
      texture.image = img!;
      texture.needsUpdate = true;
      computeRatio();
      host.setAttribute("data-gl-active", "1");
    }
    if (img.complete && img.naturalWidth > 0) attachTexture();
    else img.addEventListener("load", attachTexture, { once: true });

    function resize() {
      const r = host.getBoundingClientRect();
      renderer.setSize(r.width, r.height);
      computeRatio();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(host);

    // Pointer state — both target and lerped current
    let mouseX = 0.5, mouseY = 0.5;
    let mouseTargetX = 0.5, mouseTargetY = 0.5;
    let hover = 0, hoverTarget = 0;

    const onMove = (e: PointerEvent) => {
      const r = host.getBoundingClientRect();
      mouseTargetX = (e.clientX - r.left) / r.width;
      mouseTargetY = 1 - (e.clientY - r.top) / r.height;
      hoverTarget = 1;
    };
    const onLeave = () => { hoverTarget = 0; };
    host.addEventListener("pointermove", onMove);
    host.addEventListener("pointerleave", onLeave);

    // Section-relative scroll progress: 0 when entering bottom of viewport,
    // 1 when fully past the top.
    let scrollProgress = 0;
    function readScroll() {
      const r = host.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = vh + r.height;
      const passed = vh - r.top;
      scrollProgress = Math.max(0, Math.min(1, passed / total));
    }
    readScroll();
    window.addEventListener("scroll", readScroll, { passive: true });
    window.addEventListener("resize", readScroll);

    // Only render while the plane is in or near the viewport.
    let inView = true;
    const visIO = new IntersectionObserver(
      ([entry]) => { inView = entry.isIntersecting; },
      { rootMargin: "100px 0px" },
    );
    visIO.observe(host);

    let raf = 0;
    const start = performance.now();
    function frame() {
      raf = requestAnimationFrame(frame);
      if (!inView) return;
      const t = (performance.now() - start) * 0.001;

      mouseX = lerp(mouseX, mouseTargetX, 0.07);
      mouseY = lerp(mouseY, mouseTargetY, 0.07);
      hover = lerp(hover, hoverTarget, 0.05);

      program.uniforms.uTime.value = t;
      program.uniforms.uMouse.value = [mouseX, mouseY];
      program.uniforms.uHover.value = hover;
      program.uniforms.uScroll.value = scrollProgress;

      renderer.render({ scene: mesh });
    }
    frame();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        ro.disconnect();
        visIO.disconnect();
        host.removeEventListener("pointermove", onMove);
        host.removeEventListener("pointerleave", onLeave);
        window.removeEventListener("scroll", readScroll);
        window.removeEventListener("resize", readScroll);
      },
      { once: true },
    );
  }

  function makeRenderer(canvas: HTMLCanvasElement) {
    return new Renderer({
      canvas,
      dpr: Math.min(window.devicePixelRatio, 2),
      alpha: true,
      premultipliedAlpha: false,
      antialias: true,
    });
  }
</script>

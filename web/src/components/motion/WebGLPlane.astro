---
/**
 * WebGLPlane — Painterly wet-print surface for photographs.
 *
 * Renders the image as a fragment-shaded plane with:
 *   - Brush-drag displacement around the cursor (the photo pulls in
 *     the direction of mouse motion, like dragging a wet brush across
 *     a freshly-printed plate)
 *   - Subtle ambient paper-fiber warp so the surface is never frozen
 *   - Painterly film grain + low-frequency paper texture overlay
 *   - Brightness envelope tied to scroll progress
 *
 * No chromatic aberration — this surface is hand-touched, not glitchy.
 *
 * Boots lazily on intersection. Falls back to a plain <img> when:
 *   - WebGL is unavailable
 *   - prefers-reduced-motion: reduce
 *   - navigator.connection.saveData (lite network)
 */

interface Props {
  src: string;
  alt?: string;
  className?: string;
  /** Brush-drag strength (0..0.2, default 0.05). */
  intensity?: number;
  /** CSS aspect-ratio value (e.g. "4/5") — optional, host can also size. */
  ratio?: string;
  /** Eager loading + decoding for above-the-fold images. */
  eager?: boolean;
}

const {
  src,
  alt = "",
  className = "",
  intensity = 0.05,
  ratio,
  eager = false,
} = Astro.props as Props;
---

<div
  class={`gl ${className}`}
  data-gl-plane
  data-gl-intensity={intensity}
  style={ratio ? `aspect-ratio: ${ratio};` : undefined}
>
  <img
    class="gl__img"
    src={src}
    alt={alt}
    data-gl-img
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    crossorigin="anonymous"
  />
  <canvas class="gl__canvas" data-gl-canvas aria-hidden="true"></canvas>
</div>

<style is:global>
  .gl{
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
  }
  .gl__img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gl__canvas{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gl[data-gl-active="1"] .gl__img{ opacity: 0; }
  .gl[data-gl-active="1"] .gl__canvas{ opacity: 1; }
</style>

<script>
  import { Renderer, Triangle, Program, Mesh, Texture } from "ogl";

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const lite = ((navigator as unknown) as { connection?: { saveData?: boolean } })
    .connection?.saveData === true;

  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  }

  if (!reduce && !lite && hasWebGL()) {
    if (document.readyState === "complete") bootAll();
    else window.addEventListener("load", bootAll, { once: true });
    document.addEventListener("astro:page-load", bootAll);
  }

  function bootAll() {
    const planes = document.querySelectorAll<HTMLElement>(
      "[data-gl-plane]:not([data-gl-watch])",
    );
    if (!planes.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (
            e.isIntersecting &&
            !(e.target as HTMLElement & { __glBooted?: boolean }).__glBooted
          ) {
            (e.target as HTMLElement & { __glBooted?: boolean }).__glBooted = true;
            bootPlane(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        });
      },
      { rootMargin: "200px 0px" },
    );

    planes.forEach((p) => {
      p.setAttribute("data-gl-watch", "1");
      io.observe(p);
    });
  }

  const VERT = /* glsl */ `
    attribute vec2 uv;
    attribute vec2 position;
    varying vec2 vUv;
    void main(){
      vUv = uv;
      gl_Position = vec4(position, 0.0, 1.0);
    }
  `;

  /* Painterly fragment shader.
   *
   * The image surface is treated like wet ink on absorbent paper:
   *  - The mouse pushes pigment in the direction of its motion (uVel)
   *  - A low-frequency paper-fiber field warps the photo at all times
   *  - A film-grain layer breathes on top
   *  - A subtle paper-texture overlay sits underneath the image grade
   *
   * No RGB channel separation. Single texture sample. The image stays
   * whole — only its substrate moves.
   */
  const FRAG = /* glsl */ `
    precision highp float;
    varying vec2 vUv;
    uniform sampler2D tMap;
    uniform vec2 uMouse;
    uniform vec2 uVel;
    uniform float uTime;
    uniform float uScroll;
    uniform float uHover;
    uniform float uIntensity;
    uniform vec2 uImageRatio;

    float hash(vec2 p){
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    /* Smooth value noise — for paper fibers and brush ambient */
    float vnoise(vec2 p){
      vec2 i = floor(p);
      vec2 f = fract(p);
      float a = hash(i);
      float b = hash(i + vec2(1.0, 0.0));
      float c = hash(i + vec2(0.0, 1.0));
      float d = hash(i + vec2(1.0, 1.0));
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    /* Cheap fractional-Brownian for paper texture */
    float fbm(vec2 p){
      float v = 0.0;
      float a = 0.5;
      for(int i = 0; i < 4; i++){
        v += a * vnoise(p);
        p *= 2.0;
        a *= 0.5;
      }
      return v;
    }

    void main(){
      // object-fit: cover semantics
      vec2 uv = (vUv - 0.5) * uImageRatio + 0.5;

      vec2 toMouse = uv - uMouse;
      float d = length(toMouse);

      /* Wet-brush drag — pixels around the cursor get pushed in the
         direction of the mouse's recent motion. exp falloff keeps the
         smear localized to where the brush is. */
      float brushFalloff = exp(-d * 5.5);
      vec2 brushDrag = uVel * brushFalloff * uIntensity * 6.0;

      /* Ambient paper-fiber warp — always present, very low amplitude.
         Keeps the photograph feeling alive even when the cursor is
         elsewhere. Two octaves of slow-moving fbm in perpendicular
         channels. */
      vec2 paperWarp = vec2(
        fbm(uv * 3.5 + uTime * 0.04),
        fbm(uv * 3.5 + vec2(100.0, 0.0) + uTime * 0.035)
      );
      paperWarp = (paperWarp - 0.5) * 0.006;

      vec2 displaced = uv + brushDrag + paperWarp;

      vec3 col = texture2D(tMap, displaced).rgb;
      float a = texture2D(tMap, displaced).a;

      /* Painterly film grain — organic, slightly larger than per-pixel.
         Animated so it twinkles like emulsion. */
      float grain = (vnoise(uv * 320.0 + uTime * 6.0) - 0.5) * 0.055;
      col += grain;

      /* Low-frequency paper texture — gives the image a printed-on
         substrate quality. Multiplicative, very gentle. */
      float paperTex = fbm(uv * 22.0) * 0.10 + 0.95;
      col *= paperTex;

      /* Editorial grade — slight saturation and contrast lift. */
      float lum = dot(col, vec3(0.299, 0.587, 0.114));
      col = mix(vec3(lum), col, 1.06);
      col = (col - 0.5) * 1.04 + 0.5;

      /* Vignette — gentle, breathes a touch on hover. */
      float vig = smoothstep(1.18, 0.30, length(vUv - 0.5));
      col *= mix(0.93, 1.02, vig);

      /* Hover lift — a hair brighter where the brush has touched. */
      col += brushFalloff * uHover * 0.04;

      /* Brightness envelope — slight dim-out as scroll passes the
         section, keeps dialogue with existing scroll fade. */
      float envelope = mix(1.0, 0.93, smoothstep(0.65, 1.0, uScroll));
      col *= envelope;

      gl_FragColor = vec4(col, a);
    }
  `;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function bootPlane(host: HTMLElement) {
    const img = host.querySelector<HTMLImageElement>("[data-gl-img]");
    const canvas = host.querySelector<HTMLCanvasElement>("[data-gl-canvas]");
    if (!img || !canvas) return;

    const intensity = parseFloat(host.dataset.glIntensity ?? "0.05");

    let renderer: ReturnType<typeof makeRenderer>;
    try {
      renderer = makeRenderer(canvas);
    } catch {
      return;
    }
    const gl = renderer.gl;
    gl.clearColor(0, 0, 0, 0);

    const geometry = new Triangle(gl);

    const texture = new Texture(gl, {
      generateMipmaps: false,
      minFilter: gl.LINEAR,
      magFilter: gl.LINEAR,
    });

    const program = new Program(gl, {
      vertex: VERT,
      fragment: FRAG,
      uniforms: {
        tMap: { value: texture },
        uMouse: { value: [0.5, 0.5] },
        uVel: { value: [0, 0] },
        uTime: { value: 0 },
        uScroll: { value: 0 },
        uHover: { value: 0 },
        uIntensity: { value: intensity },
        uImageRatio: { value: [1, 1] },
      },
      transparent: true,
    });

    const mesh = new Mesh(gl, { geometry, program });

    function computeRatio() {
      if (!img!.naturalWidth || !img!.naturalHeight) return;
      const r = host.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const planeAspect = r.width / r.height;
      const imgAspect = img!.naturalWidth / img!.naturalHeight;
      if (planeAspect > imgAspect) {
        program.uniforms.uImageRatio.value = [1, imgAspect / planeAspect];
      } else {
        program.uniforms.uImageRatio.value = [planeAspect / imgAspect, 1];
      }
    }

    function attachTexture() {
      texture.image = img!;
      texture.needsUpdate = true;
      computeRatio();
      host.setAttribute("data-gl-active", "1");
    }
    if (img.complete && img.naturalWidth > 0) attachTexture();
    else img.addEventListener("load", attachTexture, { once: true });

    function resize() {
      const r = host.getBoundingClientRect();
      renderer.setSize(r.width, r.height);
      computeRatio();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(host);

    /* Pointer state — track position AND velocity (for the brush drag).
       Velocity is computed from frame-to-frame target deltas, then
       lerped + decayed each frame so the smear settles when the mouse
       stops moving. */
    let mouseX = 0.5, mouseY = 0.5;
    let mouseTargetX = 0.5, mouseTargetY = 0.5;
    let lastTargetX = 0.5, lastTargetY = 0.5;
    let velX = 0, velY = 0;
    let velTargetX = 0, velTargetY = 0;
    let hover = 0, hoverTarget = 0;

    // Listen on the host (which receives pointer events on hover-capable
    // devices). Track widely on the document so the brush can follow
    // the cursor even when it momentarily passes over child overlays.
    const onMove = (e: PointerEvent) => {
      const r = host.getBoundingClientRect();
      // Clamp to plane bounds so we don't accidentally drag from offscreen
      const nx = (e.clientX - r.left) / r.width;
      const ny = 1 - (e.clientY - r.top) / r.height;
      if (nx < -0.05 || nx > 1.05 || ny < -0.05 || ny > 1.05) {
        hoverTarget = 0;
        return;
      }
      mouseTargetX = Math.max(0, Math.min(1, nx));
      mouseTargetY = Math.max(0, Math.min(1, ny));
      hoverTarget = 1;
    };
    const onLeave = () => { hoverTarget = 0; };
    host.addEventListener("pointermove", onMove);
    host.addEventListener("pointerleave", onLeave);
    // Catch broader page motion so the brush still tracks when the cursor
    // glides through overlapping UI (the title, etc).
    document.addEventListener("pointermove", onMove);

    let scrollProgress = 0;
    function readScroll() {
      const r = host.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = vh + r.height;
      const passed = vh - r.top;
      scrollProgress = Math.max(0, Math.min(1, passed / total));
    }
    readScroll();
    window.addEventListener("scroll", readScroll, { passive: true });
    window.addEventListener("resize", readScroll);

    let inView = true;
    const visIO = new IntersectionObserver(
      ([entry]) => { inView = entry.isIntersecting; },
      { rootMargin: "100px 0px" },
    );
    visIO.observe(host);

    let raf = 0;
    const start = performance.now();
    function frame() {
      raf = requestAnimationFrame(frame);
      if (!inView) return;
      const t = (performance.now() - start) * 0.001;

      // Compute raw frame-to-frame target velocity, then drive a decayed
      // displayed velocity. The brush "leans" with the cursor and
      // settles back when motion stops.
      const dx = mouseTargetX - lastTargetX;
      const dy = mouseTargetY - lastTargetY;
      lastTargetX = mouseTargetX;
      lastTargetY = mouseTargetY;
      velTargetX = velTargetX * 0.82 + dx * 0.6;
      velTargetY = velTargetY * 0.82 + dy * 0.6;
      velX = lerp(velX, velTargetX, 0.35);
      velY = lerp(velY, velTargetY, 0.35);

      mouseX = lerp(mouseX, mouseTargetX, 0.18);
      mouseY = lerp(mouseY, mouseTargetY, 0.18);
      hover = lerp(hover, hoverTarget, 0.06);

      program.uniforms.uTime.value = t;
      program.uniforms.uMouse.value = [mouseX, mouseY];
      program.uniforms.uVel.value = [velX, velY];
      program.uniforms.uHover.value = hover;
      program.uniforms.uScroll.value = scrollProgress;

      renderer.render({ scene: mesh });
    }
    frame();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        ro.disconnect();
        visIO.disconnect();
        host.removeEventListener("pointermove", onMove);
        host.removeEventListener("pointerleave", onLeave);
        document.removeEventListener("pointermove", onMove);
        window.removeEventListener("scroll", readScroll);
        window.removeEventListener("resize", readScroll);
      },
      { once: true },
    );
  }

  function makeRenderer(canvas: HTMLCanvasElement) {
    return new Renderer({
      canvas,
      dpr: Math.min(window.devicePixelRatio, 2),
      alpha: true,
      premultipliedAlpha: false,
      antialias: true,
    });
  }
</script>

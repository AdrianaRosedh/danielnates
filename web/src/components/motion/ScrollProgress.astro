---
/**
 * ScrollProgress — fixed-bottom film-reel scrollbar.
 *
 * A row of evenly-spaced hairline ticks across the full viewport width
 * with a single accent caret that tracks scroll position, plus a small
 * "(NN%)" label on the right. The bigger highlighted tick under the
 * caret is the only "moving" element — everything else is static.
 *
 * Inspired by maisonboursier.com's bottom ticker — gives the page a
 * cinematic / editorial-document feel without taking visual weight.
 *
 * No JS framework — vanilla. Listens to scroll and updates a CSS var
 * on the host (--p, 0..1). All visuals are derived from --p.
 */
---

<aside class="scrollprog" data-scrollprog aria-hidden="true">
  <div class="scrollprog__rail">
    <div class="scrollprog__ticks" aria-hidden="true"></div>
    <div class="scrollprog__caret" aria-hidden="true"></div>
  </div>
  <span class="scrollprog__label" data-scrollprog-label>(0%)</span>
</aside>

<style>
  .scrollprog{
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 12px clamp(20px, 4vw, 56px) 16px;
    pointer-events: none;
    color: rgba(239,230,212,.55);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .14em;
    /* expose scroll progress via a CSS var so animations are derived
       from a single source — the JS just writes --p, the CSS does
       the styling. */
    --p: 0;
  }

  .scrollprog__rail{
    position: relative;
    height: 14px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* The fine tick row — repeating-linear-gradient renders a subtle
     barcode of 1px hairlines, evenly spaced. Saves a million spans. */
  .scrollprog__ticks{
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to right,
      rgba(239,230,212,.18) 0 1px,
      transparent 1px 7px
    );
    /* Mid-rail emphasis — the ticks fade slightly toward edges so
       it feels less like a tape measure, more like a film strip. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2%, #000 98%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 2%, #000 98%, transparent);
  }

  /* The caret: a taller, accent-colored tick that sits at progress %.
     Translates horizontally based on --p. Glows slightly on the
     accent. */
  .scrollprog__caret{
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: var(--olivar);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--olivar) 14%, transparent);
    transform: translateX(calc(var(--p, 0) * 100vw - 1px));
    transition: transform 200ms var(--ease-fluid);
    will-change: transform;
  }

  .scrollprog__label{
    font-variant-numeric: tabular-nums;
    color: rgba(239,230,212,.55);
    font-size: 10px;
    letter-spacing: .14em;
    min-width: 6ch;
    text-align: right;
  }

  /* On bone scenes, swap the tints to dark. */
  body.dock-on-bone .scrollprog,
  body.dock-on-bone .scrollprog__label{ color: rgba(14,15,12,.55); }
  body.dock-on-bone .scrollprog__ticks{
    background-image: repeating-linear-gradient(
      to right,
      rgba(14,15,12,.20) 0 1px,
      transparent 1px 7px
    );
  }
  body.dock-on-bone .scrollprog__caret{
    background: var(--moss);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--moss) 14%, transparent);
  }

  /* Hide while the cinematic entrance is playing — feels less
     cluttered during the curtain. The director removes
     entranceActive when it's done. */
  html[data-entrance-active] .scrollprog{ opacity: 0; pointer-events: none; }

  /* Reduced motion users: keep visible, drop the transition. */
  @media (prefers-reduced-motion: reduce){
    .scrollprog__caret{ transition: none; }
  }
</style>

<script>
(() => {
  const root = document.querySelector<HTMLElement>("[data-scrollprog]");
  const label = document.querySelector<HTMLElement>("[data-scrollprog-label]");
  if (!root) return;

  let raf = 0;
  function update(){
    const doc = document.documentElement;
    const max = (doc.scrollHeight - window.innerHeight) || 1;
    const p = Math.min(1, Math.max(0, window.scrollY / max));
    root!.style.setProperty("--p", String(p));
    if (label) label.textContent = `(${Math.round(p * 100)}%)`;
    raf = 0;
  }
  function onScroll(){
    if (raf) return;
    raf = requestAnimationFrame(update);
  }

  update();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener("scroll", onScroll);
    window.removeEventListener("resize", onScroll);
  }, { once: true });
})();
</script>

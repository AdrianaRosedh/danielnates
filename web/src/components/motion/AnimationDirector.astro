---
/**
 * Single animation conductor for the whole site.
 *
 * Owns:
 *  - Lenis smooth scroll (synced with GSAP ticker)
 *  - GSAP + ScrollTrigger setup
 *  - Cinematic entrance timeline
 *  - Text reveal (per-letter / per-word, scroll-triggered)
 *  - Hero parallax + crossfade (scrubbed)
 *  - Page-load fade
 *  - Compatibility with Astro ClientRouter (re-init on astro:page-load)
 *
 * Components emit markup with data-* attributes. This file decides motion.
 */
---

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // House defaults — fluid, no snap. Matches CSS --ease-fluid.
  const FLUID = "cubic-bezier(0.16, 1, 0.3, 1)";
  gsap.defaults({ ease: FLUID, duration: 1.0 });

  declare global {
    interface Window {
      __lenis?: Lenis | null;
      __dnDirectorBooted?: boolean;
    }
  }

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── Lenis + GSAP ticker sync ─────────────────────────────────── */
  /* The ticker callback must be tracked and removed on teardown.
   * Leaving it registered after a ClientRouter swap means a destroyed
   * Lenis keeps getting raf()'d every frame — which breaks every
   * scrubbed ScrollTrigger (notebook page-turn, hero parallax) on the
   * next page until a hard refresh. */
  let lenisTickerCb: ((time: number) => void) | null = null;

  function bootLenis() {
    if (window.__lenis) return window.__lenis;
    if (window.innerWidth < 720) return null; // touch: native scroll
    const lenis = new Lenis({
      lerp: 0.09,
      duration: 1.1,
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.4,
    });
    window.__lenis = lenis;

    lenis.on("scroll", ScrollTrigger.update);

    lenisTickerCb = (time: number) => {
      lenis.raf(time * 1000);
    };
    gsap.ticker.add(lenisTickerCb);
    gsap.ticker.lagSmoothing(0);

    return lenis;
  }

  /* Scroll lock for the intro curtain. Only <html> is locked — putting
   * overflow:hidden on <body> too turns body into a clipping box one
   * viewport tall, and anything measuring the page in that window
   * (Lenis, ScrollTrigger) records "nothing to scroll". Lenis gets its
   * own stop/start so wheel input isn't queued up behind the curtain. */
  function lockScroll() {
    document.documentElement.style.overflow = "hidden";
    try { window.__lenis?.stop(); } catch {}
  }
  function unlockScroll() {
    const html = document.documentElement;
    html.style.overflow = "";
    document.body.style.overflow = "";
    try {
      window.__lenis?.start();
      window.__lenis?.resize(); // re-measure: the page may have grown under the curtain
    } catch {}
    ScrollTrigger.refresh();
  }
  // The pre-paint script in CinematicEntrance releases the curtain on
  // the first wheel/touch/key — it dispatches this so we re-measure.
  document.addEventListener("dn:entrance-released", unlockScroll);

  // Edit mode reflows pinned scenes into plain stacks (and back), so
  // every trigger position and Lenis' page height must be re-measured.
  new MutationObserver(() => {
    requestAnimationFrame(() => {
      try { window.__lenis?.resize(); } catch {}
      ScrollTrigger.refresh();
    });
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-edit-mode"] });

  function killLenis() {
    if (lenisTickerCb) {
      gsap.ticker.remove(lenisTickerCb);
      lenisTickerCb = null;
    }
    try { window.__lenis?.destroy(); } catch {}
    window.__lenis = null;
  }

  /* ── Helpers: split text into spans for stagger ───────────────── */
  function splitText(el: HTMLElement, mode: "word" | "letter") {
    if (el.dataset.splitDone === "1") return;
    const text = el.textContent ?? "";
    const escape = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    let html = "";
    if (mode === "letter") {
      // Letters are grouped per word in a nowrap span — adjacent
      // inline-blocks are break opportunities, so ungrouped letters
      // let a name wrap mid-word ("Daniel N / ates").
      html = text
        .split(/(\s+)/)
        .map((chunk) =>
          /^\s+$/.test(chunk) || !chunk
            ? chunk ? " " : ""
            : `<span class="tr__word">${Array.from(chunk)
                .map((c) => `<span class="tr__piece"><span class="tr__inner">${escape(c)}</span></span>`)
                .join("")}</span>`,
        )
        .join("");
    } else {
      const words = text.split(/\s+/).filter(Boolean);
      html = words
        .map(
          (w) =>
            `<span class="tr__piece"><span class="tr__inner">${escape(w)}</span></span>`,
        )
        .join(" ");
    }
    el.innerHTML = html;
    el.dataset.splitDone = "1";
  }

  /* ── Entrance timeline ────────────────────────────────────────── */
  function runEntrance(): Promise<void> {
    return new Promise((resolve) => {
      const el = document.querySelector<HTMLElement>("[data-entrance]");
      if (!el) return resolve();

      // Skip flag was set by inline pre-paint script
      if (document.documentElement.dataset.entranceSkip === "1") {
        try { el.remove(); } catch {}
        delete document.documentElement.dataset.entranceActive;
        return resolve();
      }

      // Lock scroll while curtain plays
      const html = document.documentElement;
      lockScroll();

      const dot = el.querySelector<HTMLElement>(".entrance__dot");
      const name = el.querySelector<HTMLElement>(".entrance__name");
      const rule = el.querySelector<HTMLElement>(".entrance__rule");
      const skip = el.querySelector<HTMLElement>(".entrance__skip");

      // Pre-state
      gsap.set([dot, name, skip], { autoAlpha: 0 });
      if (name) gsap.set(name, { y: 14, filter: "blur(8px)" });
      if (rule) gsap.set(rule, { width: 0 });

      const tl = gsap.timeline({
        defaults: { ease: FLUID },
        onComplete: () => {
          unlockScroll();
          delete html.dataset.entranceActive;
          document.dispatchEvent(new CustomEvent("dn:entrance-dismissed"));
          try { localStorage.setItem("dn_entered_v1", "1"); } catch {}
          try { el.remove(); } catch {}
          resolve();
        },
      });

      tl
        .to(dot, { autoAlpha: 1, scale: 1, duration: 1.1, transformOrigin: "50% 50%" }, 0.25)
        .to(name, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 1.4 }, 0.6)
        .to(rule, { width: "clamp(120px, 18vw, 220px)", duration: 1.2 }, 1.5)
        .to(skip, { autoAlpha: 1, duration: 0.8 }, 2.0)
        .to({}, { duration: 0.6 }) // hold longer for breath
        .to(el, {
          yPercent: -100,
          autoAlpha: 0,
          duration: 1.3,
          ease: "cubic-bezier(0.7, 0, 0.2, 1)", // glide in, glide out
        }, ">-0.1");

      // Skippable
      const dismiss = () => {
        if (tl.isActive()) tl.progress(1);
      };
      el.addEventListener("click", dismiss, { once: true });
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape" || e.key === " " || e.key === "Enter") dismiss();
      };
      document.addEventListener("keydown", onKey, { once: true });

      // Hard failsafe
      setTimeout(() => {
        if (tl.isActive() || el.isConnected) dismiss();
      }, 8000);
    });
  }

  /* ── Reveal animations ────────────────────────────────────────── */
  function setupReveals() {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal-text]");
    targets.forEach((el) => {
      const mode = (el.dataset.revealMode === "letter" ? "letter" : "word") as
        | "word"
        | "letter";
      splitText(el, mode);

      const inners = el.querySelectorAll<HTMLElement>(".tr__inner");
      if (!inners.length) return;

      gsap.set(inners, { yPercent: 110, autoAlpha: 0 });

      gsap.to(inners, {
        yPercent: 0,
        autoAlpha: 1,
        duration: 1.4,
        ease: FLUID,
        stagger: mode === "letter" ? 0.035 : 0.08,
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          once: true,
        },
      });
    });

    // Generic block reveal (fade + lift + blur out) — not scoped to text
    const blocks = document.querySelectorAll<HTMLElement>(
      ".reveal:not([data-reveal-text])",
    );
    // fromTo, not from: motion.css pre-hides these under html.js, and
    // from() would tween toward that hidden computed state (0 → 0).
    blocks.forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 28, filter: "blur(10px)" },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 1.3,
          ease: FLUID,
          clearProps: "filter",
          scrollTrigger: { trigger: el, start: "top 88%", once: true },
        },
      );
    });

    // Cascade reveal — direct children of a .reveal-stagger container
    // (cards in a grid, rows in a list, badges) lift in one after
    // another instead of as a single block.
    const staggers = document.querySelectorAll<HTMLElement>(
      ".reveal-stagger:not([data-reveal-text])",
    );
    staggers.forEach((el) => {
      const kids = Array.from(el.children) as HTMLElement[];
      if (!kids.length) return;
      gsap.fromTo(kids,
        { opacity: 0, y: 26, filter: "blur(8px)" },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 1.15,
          ease: FLUID,
          stagger: 0.09,
          clearProps: "filter",
          scrollTrigger: { trigger: el, start: "top 88%", once: true },
        },
      );
    });

    // Editorial body cascade — rendered Portable Text paragraphs on
    // detail pages lift in sequence, like a page settling onto a desk.
    document.querySelectorAll<HTMLElement>("[data-reveal-body]").forEach((host) => {
      const body = host.querySelector<HTMLElement>(".pt") ?? host;
      const kids = Array.from(body.children) as HTMLElement[];
      if (!kids.length) return;
      gsap.from(kids, {
        opacity: 0,
        y: 18,
        duration: 1.0,
        ease: FLUID,
        stagger: 0.06,
        scrollTrigger: { trigger: host, start: "top 85%", once: true },
      });
    });
  }

  /* ── Hero intro — the focusing shot ───────────────────────────── */
  /* The ColdOpen opens like a lens pulling focus: the photograph
   * arrives soft and oversized, settles sharp; the monument name
   * rises through line masks with a faint skew that irons out; the
   * chrome (eyebrow, signature, corners, hairlines) breathes in last.
   * Initial values mirror the CSS pre-state in ColdOpen.astro so
   * there is no flash before the first frame. */
  function setupHeroIntro(): (() => void) | null {
    const hero = document.querySelector<HTMLElement>("[data-hero-intro]");
    if (!hero || reduce) return null;

    const media = hero.querySelector<HTMLElement>("[data-hero-media]");
    const lines = hero.querySelectorAll<HTMLElement>(".cold__lineInner");
    const eyebrow = hero.querySelector<HTMLElement>(".cold__eyebrow");
    const sig = hero.querySelector<HTMLElement>(".cold__sig");
    const chrome = hero.querySelectorAll<HTMLElement>(".cold__corners, .cold__frame");

    const tl = gsap.timeline({ paused: true, defaults: { ease: FLUID } });

    if (media) {
      tl.fromTo(media,
        { autoAlpha: 0.55, scale: 1.1, filter: "blur(16px)" },
        { autoAlpha: 1, scale: 1, filter: "blur(0px)", duration: 2.1 },
        0,
      );
    }
    if (lines.length) {
      // y: 0 on both ends — GSAP reads the CSS pre-state
      // translateY(112%) as a px `y`, which yPercent alone never undoes.
      tl.fromTo(lines,
        { y: 0, yPercent: 112, skewY: 2.4 },
        { y: 0, yPercent: 0, skewY: 0, duration: 1.5, stagger: 0.14 },
        0.4,
      );
    }
    if (eyebrow) tl.fromTo(eyebrow, { autoAlpha: 0, y: 12 }, { autoAlpha: 1, y: 0, duration: 0.9 }, 0.95);
    if (sig) tl.fromTo(sig, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.9 }, 1.15);
    if (chrome.length) tl.fromTo(chrome, { autoAlpha: 0 }, { autoAlpha: 1, duration: 1.1 }, 1.3);

    return () => {
      tl.play();
      // Failsafe: if the ticker stalls (hidden tab, throttled rAF),
      // never leave the hero hidden — jump to the resting state.
      setTimeout(() => {
        if (tl.progress() < 0.05) tl.progress(1);
      }, 4000);
    };
  }

  /* ── Hero scroll choreography ─────────────────────────────────── */
  function setupHeroes() {
    const heroes = document.querySelectorAll<HTMLElement>("[data-hero-scroll]");
    heroes.forEach((hero) => {
      const media = hero.querySelector<HTMLElement>("[data-hero-media]");
      const inner = hero.querySelector<HTMLElement>("[data-hero-inner]");

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: 1.4, // higher scrub = more lag = silkier scroll-bound motion
        },
      });

      if (media) tl.to(media, { yPercent: 28, scale: 1.06, ease: "none" }, 0);
      if (inner) tl.to(inner, { yPercent: -36, autoAlpha: 0, ease: "none" }, 0);
    });
  }

  /* ── Prologue — three intertitles on a pinned stage ───────────── */
  /* The stage is CSS-sticky (see Prologue.astro); this scrubs the
   * beats across the section's runway. Thesis words light up as you
   * read, the confession rises letter by letter, the promise lights
   * up and a hairline drops toward the notebook. Scrubbed both ways,
   * so scrolling back un-reads the page. */
  function setupPrologue() {
    if (reduce) return;
    document.querySelectorAll<HTMLElement>("[data-prologue]").forEach((section) => {
      const beat = (n: number) =>
        section.querySelector<HTMLElement>(`[data-prologue-beat="${n}"]`);
      const b1 = beat(1), b2 = beat(2), b3 = beat(3);
      if (!b1 || !b2 || !b3) return;
      const w1 = b1.querySelectorAll<HTMLElement>(".pw");
      const l2 = b2.querySelectorAll<HTMLElement>(".pl");
      const w3 = b3.querySelectorAll<HTMLElement>(".pw");
      const mark = section.querySelector<HTMLElement>("[data-prologue-mark]");
      const count = section.querySelector<HTMLElement>("[data-prologue-count]");

      const DIM = 0.13;
      gsap.set([w1, w3], { opacity: DIM });
      gsap.set(l2, { opacity: 0, yPercent: 46, filter: "blur(10px)" });

      const tl = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.9,
          invalidateOnRefresh: true,
          onUpdate: (st) => {
            if (!count) return;
            const t = st.progress * tl.duration();
            count.textContent = t < 3.9 ? "I" : t < 7.3 ? "II" : "III";
          },
        },
      });

      // The room's glow drifts left → right across the three beats.
      tl.fromTo(section, { "--pg": 0 }, { "--pg": 1, duration: 11 } as gsap.TweenVars, 0);

      // I — the thesis, read along.
      tl.to(w1, { opacity: 1, duration: 0.5, stagger: { amount: 2.2 } }, 0.1);
      tl.to(b1, { autoAlpha: 0, yPercent: -14, filter: "blur(8px)", duration: 0.9, ease: "power1.in" }, 3.3);

      // II — the confession rises, holds, leaves.
      tl.set(b2, { opacity: 1 }, 3.9);
      tl.to(l2, { opacity: 1, yPercent: 0, filter: "blur(0px)", duration: 0.8, ease: "power2.out", stagger: { amount: 1.2 } }, 3.9);
      tl.to(b2, { autoAlpha: 0, yPercent: -10, filter: "blur(8px)", duration: 0.9, ease: "power1.in" }, 6.7);

      // III — the promise, then the hand-off hairline.
      tl.set(b3, { opacity: 1 }, 7.3);
      tl.fromTo(b3, { yPercent: 8 }, { yPercent: 0, duration: 1.2, ease: "power2.out" }, 7.3);
      tl.to(w3, { opacity: 1, duration: 0.5, stagger: { amount: 1.8 } }, 7.4);
      if (mark) tl.fromTo(mark, { scaleY: 0 }, { scaleY: 1, duration: 1.0, ease: "power2.out" }, 9.4);
      tl.to({}, { duration: 0.6 }, 10.4); // hold the last frame
    });
  }

  /* ── Notebook signature — pin + horizontal scroll + SVG self-draw  */
  /* The defining motion of the landing. A [data-notebook] section
   * pins for ~N viewports of vertical scroll while its inner
   * [data-notebook-track] translates horizontally through N spreads.
   * Each spread's SVG drawing self-draws (stroke-dashoffset → 0)
   * as it enters frame, and the recto counter updates on enter.
   *
   * Setup is RETRYABLE: the width check can read a transient value
   * right after a ClientRouter swap, which used to silently skip the
   * pin until a hard refresh. notebookLive tracks whether the scene
   * actually mounted so the settle pass / resize can try again. */
  let notebookLive = false;
  function setupNotebook() {
    if (notebookLive) return;
    const sections = document.querySelectorAll<HTMLElement>("[data-notebook]");
    if (!sections.length) return;
    if (window.innerWidth <= 880) return; // mobile uses native vertical stack
    if (reduce) return;
    notebookLive = true;

    sections.forEach((section) => {
      const track = section.querySelector<HTMLElement>("[data-notebook-track]");
      const counter = section.querySelector<HTMLElement>("[data-notebook-counter]");
      if (!track) return;

      const spreads = track.querySelectorAll<HTMLElement>("[data-spread]");
      const N = spreads.length;
      if (N < 2) return;

      // Horizontal page-turn pinned to the section.
      const pageTl = gsap.to(track, {
        xPercent: -100 * (N - 1),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          pin: true,
          scrub: 1.2,
          start: "top top",
          // ~3/4 of a viewport width of scroll per page turn — enough
          // for the draw + read, without the pin overstaying.
          end: () => `+=${Math.round(window.innerWidth * 0.75 * (N - 1))}`,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });

      // Per-spread: counter update + SVG self-draw, scoped to the
      // page-turn timeline via containerAnimation.
      spreads.forEach((spread, i) => {
        // Counter
        if (counter) {
          ScrollTrigger.create({
            trigger: spread,
            containerAnimation: pageTl,
            start: "left center",
            end: "right center",
            onEnter:     () => { counter.textContent = romanFor(i + 1); },
            onEnterBack: () => { counter.textContent = romanFor(i + 1); },
          });
        }

        // Sketch self-draw — scrubbed to the page turn, so the hand
        // draws exactly as fast as you turn the page (and un-draws if
        // you turn back). The stroke pacing inside the timeline keeps
        // it reading as a hand: long contours take longer, ticks are
        // quick. Spread 0 is already on stage when the pin starts, so
        // its draw maps to the approach + the first stretch of pin.
        const svgs = spread.querySelectorAll<SVGSVGElement>("[data-sketch] svg");
        svgs.forEach((svg) => {
          const tlDraw = buildSketchDraw(svg);
          if (!tlDraw) return;
          if (i === 0) {
            ScrollTrigger.create({
              trigger: section,
              start: "top 75%",
              end: () => `+=${Math.round(window.innerHeight * 0.75 + window.innerWidth * 0.5)}`,
              scrub: true,
              animation: tlDraw,
              invalidateOnRefresh: true,
            });
          } else {
            ScrollTrigger.create({
              trigger: spread,
              containerAnimation: pageTl,
              start: "left 82%",
              end: "left 22%",
              scrub: true,
              animation: tlDraw,
            });
          }
        });
      });
    });
  }

  /* ── Sketch self-draw — the hand at work ──────────────────────── */
  /* Builds a paused timeline that lays the strokes down sequentially
   * in composition order (contours → secondary forms → details),
   * each at constant pen speed — long contours take their time,
   * little ticks are quick — while a small ink dot rides the tip of
   * the active stroke. The timeline itself is driven by a scrubbed
   * ScrollTrigger (wired in setupNotebook for the pinned desktop
   * page-turn, in setupSketchDraws for the stacked mobile flow), so
   * the drawing progresses exactly with the visitor's scroll. */
  function buildSketchDraw(svg: SVGSVGElement): gsap.core.Timeline | null {
    const s = svg as SVGSVGElement & { __dnSketch?: boolean };
    if (s.__dnSketch) return null;
    s.__dnSketch = true;

    // The watercolour wash is a fill, not a stroke — it's faded in
    // after the line, never "drawn".
    const els = Array.from(
      svg.querySelectorAll<SVGGeometryElement>(
        "path:not([data-wash]), ellipse:not([data-wash]), circle, line",
      ),
    );
    const wash = svg.querySelector<SVGElement>("[data-wash]");
    const washTarget = wash ? parseFloat(wash.getAttribute("opacity") ?? "0.25") || 0.25 : 0;
    if (wash) wash.setAttribute("opacity", "0");
    type Stroke = { el: SVGGeometryElement; len: number; alpha: number };
    const strokes: Stroke[] = [];
    let total = 0;
    for (const el of els) {
      const len = el.getTotalLength?.() ?? 0;
      if (!len) continue;
      const alpha = parseFloat(el.getAttribute("opacity") ?? "1") || 1;
      el.style.strokeDasharray = String(len);
      el.style.strokeDashoffset = String(len);
      el.style.opacity = "0";
      strokes.push({ el, len, alpha });
      total += len;
    }
    if (!strokes.length) return null;

    // The pen — a small ink dot that rides the active stroke tip.
    const pen = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    pen.setAttribute("r", "2.2");
    pen.setAttribute("fill", "currentColor");
    pen.setAttribute("opacity", "0");
    try {
      const p0 = strokes[0].el.getPointAtLength(0);
      pen.setAttribute("cx", String(p0.x));
      pen.setAttribute("cy", String(p0.y));
    } catch {}
    svg.appendChild(pen);

    // Constant pen speed; whole drawings land between ~2.6s and ~4.2s.
    const dur = Math.min(4.2, Math.max(2.6, total / 1400));
    const speed = total / dur;

    const tl = gsap.timeline({ paused: true });
    tl.fromTo(pen, { attr: { opacity: 0 } }, { attr: { opacity: 0.85 }, duration: 0.12 }, 0);
    for (const stroke of strokes) {
      const d = Math.max(0.016, stroke.len / speed);
      const state = { p: 0 };
      tl.to(state, {
        p: 1,
        duration: d,
        ease: "none",
        onStart: () => {
          stroke.el.style.opacity = String(stroke.alpha); // ink arrives with the pen
        },
        onUpdate: () => {
          const drawn = stroke.len * state.p;
          stroke.el.style.strokeDashoffset = String(stroke.len - drawn);
          try {
            const pt = stroke.el.getPointAtLength(drawn);
            pen.setAttribute("cx", String(pt.x));
            pen.setAttribute("cy", String(pt.y));
          } catch {}
        },
      }, ">");
    }
    tl.to(pen, { attr: { opacity: 0 }, duration: 0.35 }, ">"); // the pen lifts
    // …and the wash goes down once most of the line is on the page.
    if (wash) {
      tl.fromTo(wash,
        { attr: { opacity: 0 } },
        { attr: { opacity: washTarget }, duration: dur * 0.4, ease: "power1.out" },
        dur * 0.62,
      );
    }
    return tl;
  }

  function setupSketchDraws() {
    // Desktop sketches are wired inside setupNotebook, scrubbed via
    // the pinned page-turn. This path covers the stacked mobile
    // layout (≤880px, no pin): each sketch draws as it travels up
    // the viewport — same scroll-driven feel, vertical axis.
    if (reduce) return; // sketches render fully drawn
    if (window.innerWidth > 880) return;
    document
      .querySelectorAll<SVGSVGElement>("[data-notebook] [data-sketch] svg")
      .forEach((svg) => {
        const tlDraw = buildSketchDraw(svg);
        if (!tlDraw) return;
        ScrollTrigger.create({
          trigger: svg,
          start: "top 88%",
          end: "top 30%",
          scrub: true,
          animation: tlDraw,
        });
      });
  }

  /* Standalone studies (<Sketch>) — draw as they travel up the
   * viewport, un-draw on the way back. */
  function setupStandaloneSketches() {
    if (reduce) return;
    document
      .querySelectorAll<SVGSVGElement>("[data-sketch-draw] .sketch__art svg")
      .forEach((svg) => {
        const tlDraw = buildSketchDraw(svg);
        if (!tlDraw) return;
        ScrollTrigger.create({
          trigger: svg,
          start: "top 85%",
          end: "bottom 40%",
          scrub: true,
          animation: tlDraw,
        });
      });
  }

  function romanFor(n: number): string {
    const r = ["I","II","III","IV","V","VI","VII","VIII","IX","X"];
    return r[n - 1] ?? String(n);
  }

  /* ── Service scene — clay → ember color bleed (the hot moment) ── */
  /* A pinned 200vh section whose background is built from color-mix
   * driven by --scene-p. As the viewer scrolls past, the room
   * visibly oxidizes from clay-tinted ink to ember-tinted ink — the
   * type stays still, the color does the emotional work. */
  function setupService() {
    const scenes = document.querySelectorAll<HTMLElement>("[data-service]");
    scenes.forEach((scene) => {
      gsap.fromTo(scene,
        { "--scene-p": 0 },
        {
          "--scene-p": 1,
          ease: "none",
          scrollTrigger: {
            trigger: scene,
            start: "top top",
            end: "bottom top",
            scrub: 1,
          },
        } as gsap.TweenVars,
      );
    });
  }

  /* ── Frame scenes — single-photo meditative moments ───────────── */
  /* Each [data-frame] is a 200vh tall scene with a sticky [data-frame-plate]
   * inside. The plate starts small and softly faded, scales up to 100% as
   * the section centers in the viewport, then fades while drifting another
   * few percent on the way out. Editorial-document feel borrowed from
   * maisonboursier.com — the photo holds the page. */
  function setupFrames() {
    const frames = document.querySelectorAll<HTMLElement>("[data-frame]");
    frames.forEach((frame) => {
      const plate = frame.querySelector<HTMLElement>("[data-frame-plate]");
      if (!plate) return;

      const tone = frame.dataset.frameTone ?? "bone";

      if (tone === "moss") {
        /* Inverse parallax — image enters BIG and settles back. The
         * world recedes around it. Pure photography rest. */
        gsap.fromTo(plate,
          { scale: 1.18, yPercent: -8, autoAlpha: 0.6 },
          {
            scale: 1.0,
            yPercent: 0,
            autoAlpha: 1,
            ease: "none",
            scrollTrigger: {
              trigger: frame,
              start: "top bottom",
              end: "center center",
              scrub: 1.4,
            },
          },
        );
        gsap.fromTo(plate,
          { scale: 1.0, autoAlpha: 1 },
          {
            scale: 0.96,
            autoAlpha: 0.35,
            ease: "none",
            scrollTrigger: {
              trigger: frame,
              start: "center center",
              end: "bottom top",
              scrub: 1.4,
            },
          },
        );
        return;
      }

      /* Default (bone) — small + soft → full → drift larger + fade. */
      gsap.fromTo(plate,
        { scale: 0.42, autoAlpha: 0.55 },
        {
          scale: 1.0,
          autoAlpha: 1,
          ease: "none",
          scrollTrigger: {
            trigger: frame,
            start: "top bottom",
            end: "center center",
            scrub: 1.4,
          },
        },
      );
      gsap.fromTo(plate,
        { scale: 1.0, autoAlpha: 1 },
        {
          scale: 1.06,
          autoAlpha: 0.4,
          ease: "none",
          scrollTrigger: {
            trigger: frame,
            start: "center center",
            end: "bottom top",
            scrub: 1.4,
          },
        },
      );
    });
  }

  /* ── Dock chrome flip (which scene is under it) ───────────────── */
  function setupDockChrome() {
    const scenes = document.querySelectorAll<HTMLElement>("[data-scene]");
    if (!scenes.length) return;

    scenes.forEach((scene) => {
      const target = scene.getAttribute("data-scene");
      ScrollTrigger.create({
        trigger: scene,
        start: "top 60px",
        end: "bottom 60px",
        onEnter: () => document.body.classList.toggle("dock-on-bone", target === "bone"),
        onEnterBack: () => document.body.classList.toggle("dock-on-bone", target === "bone"),
      });
    });
  }

  /* ── Anchor smooth-scroll via Lenis ───────────────────────────── */
  function anchorHandler(e: MouseEvent) {
    const a = (e.target as HTMLElement | null)?.closest?.('a[href^="#"]') as
      | HTMLAnchorElement
      | null;
    if (!a) return;
    const href = a.getAttribute("href");
    if (!href || href === "#") return;
    const t = document.querySelector(href);
    if (!t) return;
    e.preventDefault();
    if (window.__lenis) window.__lenis.scrollTo(t as HTMLElement, { offset: -16 });
    else (t as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    history.pushState(null, "", href);
  }
  function setupAnchors() {
    document.removeEventListener("click", anchorHandler);
    document.addEventListener("click", anchorHandler);
  }

  /* ── Voice orchestrator — single audio source, scroll-aware pause ── */
  function setupVoice() {
    const marks = Array.from(
      document.querySelectorAll<HTMLElement>("[data-voice]"),
    );
    if (!marks.length) return;

    let current: { mark: HTMLElement; audio: HTMLAudioElement } | null = null;

    const stopCurrent = () => {
      if (!current) return;
      try { current.audio.pause(); } catch {}
      current.mark.removeAttribute("data-playing");
      current = null;
    };

    marks.forEach((mark) => {
      const src = mark.getAttribute("data-voice-src");
      const btn = mark.querySelector<HTMLButtonElement>(".voice__btn");
      if (!src || !btn) return;

      const audio = new Audio();
      audio.preload = "metadata";
      audio.src = src;

      audio.addEventListener("ended", () => {
        if (current?.audio === audio) stopCurrent();
      });

      btn.addEventListener("click", () => {
        if (current?.audio === audio) {
          stopCurrent();
          return;
        }
        stopCurrent();
        current = { mark, audio };
        mark.setAttribute("data-playing", "1");
        audio.play().catch(() => stopCurrent());
      });

      // Auto-pause when this mark scrolls fully out of viewport
      ScrollTrigger.create({
        trigger: mark,
        start: "top bottom",
        end: "bottom top",
        onLeave: () => {
          if (current?.audio === audio) stopCurrent();
        },
        onLeaveBack: () => {
          if (current?.audio === audio) stopCurrent();
        },
      });
    });

    // Pause on full nav swap
    document.addEventListener(
      "astro:before-swap",
      () => stopCurrent(),
      { once: true },
    );
  }

  /* ── Per-card cursor spotlight (hover-capable only) ───────────── */
  function setupCardSpotlight() {
    if (!matchMedia("(hover: hover)").matches) return;
    const cards = document.querySelectorAll<HTMLElement>(
      ".projectCard, .articleRow, .artCard, .noteRow",
    );
    cards.forEach((card) => {
      const c = card as HTMLElement & { __dnSpot?: boolean };
      if (c.__dnSpot) return;
      c.__dnSpot = true;
      c.addEventListener(
        "pointermove",
        (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty("--mx", `${(e as PointerEvent).clientX - r.left}px`);
          c.style.setProperty("--my", `${(e as PointerEvent).clientY - r.top}px`);
        },
        { passive: true },
      );
    });
  }

  /* ── Boot ─────────────────────────────────────────────────────── */
  let onResizeRetry: (() => void) | null = null;

  async function init() {
    if (reduce) {
      const el = document.querySelector("[data-entrance]");
      if (el) try { (el as HTMLElement).remove(); } catch {}
      delete document.documentElement.dataset.entranceActive;
    }

    // Wire up reveals + scroll triggers BEFORE awaiting the entrance.
    // Otherwise when the curtain dismisses (either by timeline or by
    // user gesture), the page underneath shows TextReveal targets in
    // their initial autoAlpha:0 state for a frame — looks like FOUC.
    // The entrance covers the page during these calls, so the user
    // doesn't see them happening; by the time the curtain lifts, the
    // hero text is already revealed.
    const playHeroIntro = setupHeroIntro();
    setupReveals();
    setupHeroes();
    setupPrologue();
    setupNotebook();
    setupSketchDraws();
    setupStandaloneSketches();
    setupFrames();
    setupService();
    setupDockChrome();
    setupAnchors();
    setupCardSpotlight();
    setupVoice();
    setupMenu();
    ScrollTrigger.refresh();

    if (!reduce) {
      bootLenis();
      await runEntrance();
      // Refresh once more in case anything resized while the curtain
      // was showing (font load, image decode, etc.).
      ScrollTrigger.refresh();
    }

    // The opening shot plays once the entrance curtain is out of the
    // way (or immediately on inner navigations).
    playHeroIntro?.();

    // Layout keeps settling shortly after a swap (fonts, lazy image
    // decode, scroll restoration) — re-measure trigger positions once
    // things are stable, and give scenes that skipped on a transient
    // viewport reading a second chance to mount.
    setTimeout(() => {
      setupNotebook();
      ScrollTrigger.refresh();
    }, 450);

    // If the viewport was narrow (or read wrong) at boot and grows
    // past the breakpoint later, mount the notebook then.
    onResizeRetry = () => {
      if (!notebookLive && window.innerWidth > 880) {
        setupNotebook();
        ScrollTrigger.refresh();
      }
    };
    window.addEventListener("resize", onResizeRetry);
  }

  /* ── Menu overlay (open / close) ──────────────────────────────── */
  function setupMenu() {
    const overlay = document.querySelector<HTMLElement>("[data-menu-overlay]");
    const trigger = document.querySelector<HTMLElement>("[data-menu-trigger]");
    if (!overlay || !trigger) return;

    const open = () => {
      if (overlay.classList.contains("is-open")) return;
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.classList.add("menu-open");
      document.documentElement.style.overflow = "hidden";
      // pause Lenis if active
      try { window.__lenis?.stop?.(); } catch {}
    };

    const close = () => {
      if (!overlay.classList.contains("is-open")) return;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.classList.remove("menu-open");
      document.documentElement.style.overflow = "";
      try { window.__lenis?.start?.(); } catch {}
    };

    trigger.addEventListener("click", open);

    // Close on internal close button
    overlay.querySelectorAll("[data-menu-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    // Close on backdrop click
    overlay.querySelector("[data-menu-bg]")?.addEventListener("click", close);
    // Close after navigating to a menu link (let the link work first)
    overlay.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((a) => {
      a.addEventListener("click", () => setTimeout(close, 50));
    });

    // Keyboard: M (menu) or I (index — the brief's table of contents)
    // toggles, ESC closes. Never while typing — inputs, selects, and
    // contenteditable (inline editing: typing an "m" in a headline
    // used to pop the menu open) — or with a modifier held.
    const onKey = (e: KeyboardEvent) => {
      const t = e.target as HTMLElement | null;
      if (
        t instanceof HTMLInputElement ||
        t instanceof HTMLTextAreaElement ||
        t instanceof HTMLSelectElement ||
        t?.isContentEditable ||
        e.metaKey || e.ctrlKey || e.altKey
      ) return;
      if (e.key === "Escape") close();
      else if (e.key === "m" || e.key === "M" || e.key === "i" || e.key === "I") {
        if (!overlay.classList.contains("is-open")) open();
        else close();
      }
    };
    document.addEventListener("keydown", onKey);

    // Cleanup on swap
    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("keydown", onKey);
        document.body.classList.remove("menu-open");
        document.documentElement.style.overflow = "";
      },
      { once: true },
    );
  }

  function teardown() {
    try { ScrollTrigger.getAll().forEach((t) => t.kill()); } catch {}
    if (onResizeRetry) {
      window.removeEventListener("resize", onResizeRetry);
      onResizeRetry = null;
    }
    notebookLive = false;
    killLenis();
  }

  function boot() {
    if (window.__dnDirectorBooted) return;
    window.__dnDirectorBooted = true;
    init();
    document.addEventListener(
      "astro:before-swap",
      () => {
        teardown();
        window.__dnDirectorBooted = false;
      },
      { once: true },
    );
  }

  if (document.readyState === "complete") boot();
  else window.addEventListener("load", boot, { once: true });
  document.addEventListener("astro:page-load", boot);
</script>

<style is:global>
  /* Pieces are sized to host the inner span (which is the animated layer).
     overflow:hidden gives us the "letterbox" reveal where letters slide
     up from beneath their own line. */
  .tr__piece{
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: inherit;
    padding-bottom: 0.06em;   /* protect descenders from the clip */
  }
  .tr__word{ display: inline-block; white-space: nowrap; }
  .tr__inner{
    display: inline-block;
    will-change: transform, opacity;
  }
</style>

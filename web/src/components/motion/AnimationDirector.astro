---
/**
 * Single animation conductor for the whole site.
 *
 * Owns:
 *  - Lenis smooth scroll (synced with GSAP ticker)
 *  - GSAP + ScrollTrigger setup
 *  - Cinematic entrance timeline
 *  - Text reveal (per-letter / per-word, scroll-triggered)
 *  - Hero parallax + crossfade (scrubbed)
 *  - Page-load fade
 *  - Compatibility with Astro ClientRouter (re-init on astro:page-load)
 *
 * Components emit markup with data-* attributes. This file decides motion.
 */
---

<script>
  import Lenis from "lenis";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // House defaults — fluid, no snap. Matches CSS --ease-fluid.
  const FLUID = "cubic-bezier(0.16, 1, 0.3, 1)";
  gsap.defaults({ ease: FLUID, duration: 1.0 });

  declare global {
    interface Window {
      __lenis?: Lenis | null;
      __dnDirectorBooted?: boolean;
    }
  }

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ── Lenis + GSAP ticker sync ─────────────────────────────────── */
  function bootLenis() {
    if (window.__lenis) return window.__lenis;
    if (window.innerWidth < 720) return null; // touch: native scroll
    const lenis = new Lenis({
      lerp: 0.09,
      duration: 1.1,
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 1.4,
    });
    window.__lenis = lenis;

    lenis.on("scroll", ScrollTrigger.update);

    gsap.ticker.add((time: number) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0);

    return lenis;
  }

  function killLenis() {
    try { window.__lenis?.destroy(); } catch {}
    window.__lenis = null;
  }

  /* ── Helpers: split text into spans for stagger ───────────────── */
  function splitText(el: HTMLElement, mode: "word" | "letter") {
    if (el.dataset.splitDone === "1") return;
    const text = el.textContent ?? "";
    const escape = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    let html = "";
    if (mode === "letter") {
      const chars = Array.from(text);
      html = chars
        .map((c) =>
          c === " "
            ? " "
            : `<span class="tr__piece"><span class="tr__inner">${escape(c)}</span></span>`,
        )
        .join("");
    } else {
      const words = text.split(/\s+/).filter(Boolean);
      html = words
        .map(
          (w) =>
            `<span class="tr__piece"><span class="tr__inner">${escape(w)}</span></span>`,
        )
        .join(" ");
    }
    el.innerHTML = html;
    el.dataset.splitDone = "1";
  }

  /* ── Entrance timeline ────────────────────────────────────────── */
  function runEntrance(): Promise<void> {
    return new Promise((resolve) => {
      const el = document.querySelector<HTMLElement>("[data-entrance]");
      if (!el) return resolve();

      // Skip flag was set by inline pre-paint script
      if (document.documentElement.dataset.entranceSkip === "1") {
        try { el.remove(); } catch {}
        delete document.documentElement.dataset.entranceActive;
        return resolve();
      }

      // Lock scroll while curtain plays
      const html = document.documentElement;
      const body = document.body;
      html.style.overflow = "hidden";
      body.style.overflow = "hidden";

      const dot = el.querySelector<HTMLElement>(".entrance__dot");
      const name = el.querySelector<HTMLElement>(".entrance__name");
      const rule = el.querySelector<HTMLElement>(".entrance__rule");
      const skip = el.querySelector<HTMLElement>(".entrance__skip");

      // Pre-state
      gsap.set([dot, name, skip], { autoAlpha: 0 });
      if (name) gsap.set(name, { y: 14, filter: "blur(8px)" });
      if (rule) gsap.set(rule, { width: 0 });

      const tl = gsap.timeline({
        defaults: { ease: FLUID },
        onComplete: () => {
          html.style.overflow = "";
          body.style.overflow = "";
          delete html.dataset.entranceActive;
          document.dispatchEvent(new CustomEvent("dn:entrance-dismissed"));
          try { localStorage.setItem("dn_entered_v1", "1"); } catch {}
          try { el.remove(); } catch {}
          resolve();
        },
      });

      tl
        .to(dot, { autoAlpha: 1, scale: 1, duration: 1.1, transformOrigin: "50% 50%" }, 0.25)
        .to(name, { autoAlpha: 1, y: 0, filter: "blur(0px)", duration: 1.4 }, 0.6)
        .to(rule, { width: "clamp(120px, 18vw, 220px)", duration: 1.2 }, 1.5)
        .to(skip, { autoAlpha: 1, duration: 0.8 }, 2.0)
        .to({}, { duration: 0.6 }) // hold longer for breath
        .to(el, {
          yPercent: -100,
          autoAlpha: 0,
          duration: 1.3,
          ease: "cubic-bezier(0.7, 0, 0.2, 1)", // glide in, glide out
        }, ">-0.1");

      // Skippable
      const dismiss = () => {
        if (tl.isActive()) tl.progress(1);
      };
      el.addEventListener("click", dismiss, { once: true });
      const onKey = (e: KeyboardEvent) => {
        if (e.key === "Escape" || e.key === " " || e.key === "Enter") dismiss();
      };
      document.addEventListener("keydown", onKey, { once: true });

      // Hard failsafe
      setTimeout(() => {
        if (tl.isActive() || el.isConnected) dismiss();
      }, 8000);
    });
  }

  /* ── Reveal animations ────────────────────────────────────────── */
  function setupReveals() {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal-text]");
    targets.forEach((el) => {
      const mode = (el.dataset.revealMode === "letter" ? "letter" : "word") as
        | "word"
        | "letter";
      splitText(el, mode);

      const inners = el.querySelectorAll<HTMLElement>(".tr__inner");
      if (!inners.length) return;

      gsap.set(inners, { yPercent: 110, autoAlpha: 0 });

      gsap.to(inners, {
        yPercent: 0,
        autoAlpha: 1,
        duration: 1.4,
        ease: FLUID,
        stagger: mode === "letter" ? 0.035 : 0.08,
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
          once: true,
        },
      });
    });

    // Generic block reveal (fade + lift + blur out) — not scoped to text
    const blocks = document.querySelectorAll<HTMLElement>(
      ".reveal:not([data-reveal-text]), .reveal-stagger:not([data-reveal-text])",
    );
    blocks.forEach((el) => {
      gsap.from(el, {
        opacity: 0,
        y: 28,
        filter: "blur(10px)",
        duration: 1.3,
        ease: FLUID,
        scrollTrigger: { trigger: el, start: "top 88%", once: true },
      });
    });
  }

  /* ── Hero scroll choreography ─────────────────────────────────── */
  function setupHeroes() {
    const heroes = document.querySelectorAll<HTMLElement>("[data-hero-scroll]");
    heroes.forEach((hero) => {
      const media = hero.querySelector<HTMLElement>("[data-hero-media]");
      const inner = hero.querySelector<HTMLElement>("[data-hero-inner]");

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: 1.4, // higher scrub = more lag = silkier scroll-bound motion
        },
      });

      if (media) tl.to(media, { yPercent: 28, scale: 1.06, ease: "none" }, 0);
      if (inner) tl.to(inner, { yPercent: -36, autoAlpha: 0, ease: "none" }, 0);
    });
  }

  /* ── Notebook signature — pin + horizontal scroll + SVG self-draw  */
  /* The defining motion of the landing. A [data-notebook] section
   * pins for ~N viewports of vertical scroll while its inner
   * [data-notebook-track] translates horizontally through N spreads.
   * Each spread's SVG drawing self-draws (stroke-dashoffset → 0)
   * as it enters frame, and the recto counter updates on enter. */
  function setupNotebook() {
    const sections = document.querySelectorAll<HTMLElement>("[data-notebook]");
    if (!sections.length) return;
    if (matchMedia("(max-width: 880px)").matches) return; // mobile uses native vertical stack
    if (reduce) return;

    sections.forEach((section) => {
      const track = section.querySelector<HTMLElement>("[data-notebook-track]");
      const counter = section.querySelector<HTMLElement>("[data-notebook-counter]");
      if (!track) return;

      const spreads = track.querySelectorAll<HTMLElement>("[data-spread]");
      const N = spreads.length;
      if (N < 2) return;

      // Horizontal page-turn pinned to the section.
      const pageTl = gsap.to(track, {
        xPercent: -100 * (N - 1),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          pin: true,
          scrub: 1.2,
          start: "top top",
          // Distance to scroll = (N-1) viewport widths.
          end: () => `+=${window.innerWidth * (N - 1)}`,
          invalidateOnRefresh: true,
          anticipatePin: 1,
        },
      });

      // Per-spread: counter update + SVG self-draw, scoped to the
      // page-turn timeline via containerAnimation.
      spreads.forEach((spread, i) => {
        // Counter
        if (counter) {
          ScrollTrigger.create({
            trigger: spread,
            containerAnimation: pageTl,
            start: "left center",
            end: "right center",
            onEnter:     () => { counter.textContent = romanFor(i + 1); },
            onEnterBack: () => { counter.textContent = romanFor(i + 1); },
          });
        }

        // SVG self-draw on the left page (drawing).
        const svgs = spread.querySelectorAll<SVGSVGElement>("[data-sketch] svg");
        svgs.forEach((svg) => {
          const lines = svg.querySelectorAll<SVGPathElement | SVGEllipseElement>(
            "path, ellipse",
          );
          // Set initial dasharray/offset so they're invisible.
          lines.forEach((line) => {
            const len = (line as SVGGeometryElement).getTotalLength?.() ?? 0;
            if (!len) return;
            line.style.strokeDasharray = String(len);
            line.style.strokeDashoffset = String(len);
          });
          // Tween to drawn as the spread enters the centre.
          gsap.to(lines, {
            strokeDashoffset: 0,
            ease: "none",
            stagger: 0.08,
            scrollTrigger: {
              trigger: spread,
              containerAnimation: pageTl,
              start: "left right",
              end: "center center",
              scrub: true,
            },
          });
        });
      });
    });
  }

  function romanFor(n: number): string {
    const r = ["I","II","III","IV","V","VI","VII","VIII","IX","X"];
    return r[n - 1] ?? String(n);
  }

  /* ── Frame scenes — single-photo meditative moments ───────────── */
  /* Each [data-frame] is a 200vh tall scene with a sticky [data-frame-plate]
   * inside. The plate starts small and softly faded, scales up to 100% as
   * the section centers in the viewport, then fades while drifting another
   * few percent on the way out. Editorial-document feel borrowed from
   * maisonboursier.com — the photo holds the page. */
  function setupFrames() {
    const frames = document.querySelectorAll<HTMLElement>("[data-frame]");
    frames.forEach((frame) => {
      const plate = frame.querySelector<HTMLElement>("[data-frame-plate]");
      if (!plate) return;

      const tone = frame.dataset.frameTone ?? "bone";

      if (tone === "moss") {
        /* Inverse parallax — image enters BIG and settles back. The
         * world recedes around it. Pure photography rest. */
        gsap.fromTo(plate,
          { scale: 1.18, yPercent: -8, autoAlpha: 0.6 },
          {
            scale: 1.0,
            yPercent: 0,
            autoAlpha: 1,
            ease: "none",
            scrollTrigger: {
              trigger: frame,
              start: "top bottom",
              end: "center center",
              scrub: 1.4,
            },
          },
        );
        gsap.fromTo(plate,
          { scale: 1.0, autoAlpha: 1 },
          {
            scale: 0.96,
            autoAlpha: 0.35,
            ease: "none",
            scrollTrigger: {
              trigger: frame,
              start: "center center",
              end: "bottom top",
              scrub: 1.4,
            },
          },
        );
        return;
      }

      /* Default (bone) — small + soft → full → drift larger + fade. */
      gsap.fromTo(plate,
        { scale: 0.42, autoAlpha: 0.55 },
        {
          scale: 1.0,
          autoAlpha: 1,
          ease: "none",
          scrollTrigger: {
            trigger: frame,
            start: "top bottom",
            end: "center center",
            scrub: 1.4,
          },
        },
      );
      gsap.fromTo(plate,
        { scale: 1.0, autoAlpha: 1 },
        {
          scale: 1.06,
          autoAlpha: 0.4,
          ease: "none",
          scrollTrigger: {
            trigger: frame,
            start: "center center",
            end: "bottom top",
            scrub: 1.4,
          },
        },
      );
    });
  }

  /* ── Dock chrome flip (which scene is under it) ───────────────── */
  function setupDockChrome() {
    const scenes = document.querySelectorAll<HTMLElement>("[data-scene]");
    if (!scenes.length) return;

    scenes.forEach((scene) => {
      const target = scene.getAttribute("data-scene");
      ScrollTrigger.create({
        trigger: scene,
        start: "top 60px",
        end: "bottom 60px",
        onEnter: () => document.body.classList.toggle("dock-on-bone", target === "bone"),
        onEnterBack: () => document.body.classList.toggle("dock-on-bone", target === "bone"),
      });
    });
  }

  /* ── Anchor smooth-scroll via Lenis ───────────────────────────── */
  function anchorHandler(e: MouseEvent) {
    const a = (e.target as HTMLElement | null)?.closest?.('a[href^="#"]') as
      | HTMLAnchorElement
      | null;
    if (!a) return;
    const href = a.getAttribute("href");
    if (!href || href === "#") return;
    const t = document.querySelector(href);
    if (!t) return;
    e.preventDefault();
    if (window.__lenis) window.__lenis.scrollTo(t as HTMLElement, { offset: -16 });
    else (t as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    history.pushState(null, "", href);
  }
  function setupAnchors() {
    document.removeEventListener("click", anchorHandler);
    document.addEventListener("click", anchorHandler);
  }

  /* ── Voice orchestrator — single audio source, scroll-aware pause ── */
  function setupVoice() {
    const marks = Array.from(
      document.querySelectorAll<HTMLElement>("[data-voice]"),
    );
    if (!marks.length) return;

    let current: { mark: HTMLElement; audio: HTMLAudioElement } | null = null;

    const stopCurrent = () => {
      if (!current) return;
      try { current.audio.pause(); } catch {}
      current.mark.removeAttribute("data-playing");
      current = null;
    };

    marks.forEach((mark) => {
      const src = mark.getAttribute("data-voice-src");
      const btn = mark.querySelector<HTMLButtonElement>(".voice__btn");
      if (!src || !btn) return;

      const audio = new Audio();
      audio.preload = "metadata";
      audio.src = src;

      audio.addEventListener("ended", () => {
        if (current?.audio === audio) stopCurrent();
      });

      btn.addEventListener("click", () => {
        if (current?.audio === audio) {
          stopCurrent();
          return;
        }
        stopCurrent();
        current = { mark, audio };
        mark.setAttribute("data-playing", "1");
        audio.play().catch(() => stopCurrent());
      });

      // Auto-pause when this mark scrolls fully out of viewport
      ScrollTrigger.create({
        trigger: mark,
        start: "top bottom",
        end: "bottom top",
        onLeave: () => {
          if (current?.audio === audio) stopCurrent();
        },
        onLeaveBack: () => {
          if (current?.audio === audio) stopCurrent();
        },
      });
    });

    // Pause on full nav swap
    document.addEventListener(
      "astro:before-swap",
      () => stopCurrent(),
      { once: true },
    );
  }

  /* ── Per-card cursor spotlight (hover-capable only) ───────────── */
  function setupCardSpotlight() {
    if (!matchMedia("(hover: hover)").matches) return;
    const cards = document.querySelectorAll<HTMLElement>(
      ".projectCard, .articleRow, .artCard, .noteRow",
    );
    cards.forEach((card) => {
      const c = card as HTMLElement & { __dnSpot?: boolean };
      if (c.__dnSpot) return;
      c.__dnSpot = true;
      c.addEventListener(
        "pointermove",
        (e) => {
          const r = c.getBoundingClientRect();
          c.style.setProperty("--mx", `${(e as PointerEvent).clientX - r.left}px`);
          c.style.setProperty("--my", `${(e as PointerEvent).clientY - r.top}px`);
        },
        { passive: true },
      );
    });
  }

  /* ── Boot ─────────────────────────────────────────────────────── */
  async function init() {
    if (reduce) {
      const el = document.querySelector("[data-entrance]");
      if (el) try { (el as HTMLElement).remove(); } catch {}
      delete document.documentElement.dataset.entranceActive;
    }

    // Wire up reveals + scroll triggers BEFORE awaiting the entrance.
    // Otherwise when the curtain dismisses (either by timeline or by
    // user gesture), the page underneath shows TextReveal targets in
    // their initial autoAlpha:0 state for a frame — looks like FOUC.
    // The entrance covers the page during these calls, so the user
    // doesn't see them happening; by the time the curtain lifts, the
    // hero text is already revealed.
    setupReveals();
    setupHeroes();
    setupNotebook();
    setupFrames();
    setupDockChrome();
    setupAnchors();
    setupCardSpotlight();
    setupVoice();
    setupMenu();
    ScrollTrigger.refresh();

    if (!reduce) {
      bootLenis();
      await runEntrance();
      // Refresh once more in case anything resized while the curtain
      // was showing (font load, image decode, etc.).
      ScrollTrigger.refresh();
    }
  }

  /* ── Menu overlay (open / close) ──────────────────────────────── */
  function setupMenu() {
    const overlay = document.querySelector<HTMLElement>("[data-menu-overlay]");
    const trigger = document.querySelector<HTMLElement>("[data-menu-trigger]");
    if (!overlay || !trigger) return;

    const open = () => {
      if (overlay.classList.contains("is-open")) return;
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.classList.add("menu-open");
      document.documentElement.style.overflow = "hidden";
      // pause Lenis if active
      try { window.__lenis?.stop?.(); } catch {}
    };

    const close = () => {
      if (!overlay.classList.contains("is-open")) return;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.classList.remove("menu-open");
      document.documentElement.style.overflow = "";
      try { window.__lenis?.start?.(); } catch {}
    };

    trigger.addEventListener("click", open);

    // Close on internal close button
    overlay.querySelectorAll("[data-menu-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    // Close on backdrop click
    overlay.querySelector("[data-menu-bg]")?.addEventListener("click", close);
    // Close after navigating to a menu link (let the link work first)
    overlay.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((a) => {
      a.addEventListener("click", () => setTimeout(close, 50));
    });

    // Keyboard: M to open, ESC to close
    const onKey = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === "Escape") close();
      else if (e.key === "m" || e.key === "M") {
        if (!overlay.classList.contains("is-open")) open();
        else close();
      }
    };
    document.addEventListener("keydown", onKey);

    // Cleanup on swap
    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("keydown", onKey);
        document.body.classList.remove("menu-open");
        document.documentElement.style.overflow = "";
      },
      { once: true },
    );
  }

  function teardown() {
    try { ScrollTrigger.getAll().forEach((t) => t.kill()); } catch {}
    killLenis();
  }

  function boot() {
    if (window.__dnDirectorBooted) return;
    window.__dnDirectorBooted = true;
    init();
    document.addEventListener(
      "astro:before-swap",
      () => {
        teardown();
        window.__dnDirectorBooted = false;
      },
      { once: true },
    );
  }

  if (document.readyState === "complete") boot();
  else window.addEventListener("load", boot, { once: true });
  document.addEventListener("astro:page-load", boot);
</script>

<style is:global>
  /* Pieces are sized to host the inner span (which is the animated layer).
     overflow:hidden gives us the "letterbox" reveal where letters slide
     up from beneath their own line. */
  .tr__piece{
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    line-height: inherit;
    padding-bottom: 0.06em;   /* protect descenders from the clip */
  }
  .tr__inner{
    display: inline-block;
    will-change: transform, opacity;
  }
</style>

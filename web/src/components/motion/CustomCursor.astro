---
/**
 * CustomCursor — two-layer cursor with mix-blend-mode: difference.
 * Performant: single rAF loop, two GPU transforms, zero layout thrash.
 *
 *   • Dot (6px) — follows pointer 1:1
 *   • Ring (38px) — lerps behind, scales up over interactive elements
 *
 * Hidden on touch devices and prefers-reduced-motion. Falls back to
 * native cursor if JS fails (CSS hides only when js class is present).
 */
---

<div class="cursor" data-cursor aria-hidden="true">
  <span class="cursor__ring" data-cursor-ring></span>
  <span class="cursor__dot" data-cursor-dot></span>
</div>

<style>
  /* When JS booted, hide the system cursor so the custom one takes over. */
  html.js.cursor-on, html.js.cursor-on *{ cursor: none !important; }

  .cursor{
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;
    mix-blend-mode: difference;
    visibility: hidden;
  }
  html.js.cursor-on .cursor{ visibility: visible; }

  .cursor__dot,
  .cursor__ring{
    position: fixed;
    top: 0; left: 0;
    border-radius: 999px;
    will-change: transform;
    pointer-events: none;
  }
  .cursor__dot{
    width: 6px; height: 6px;
    background: #ffffff;
    margin: -3px 0 0 -3px;
  }
  .cursor__ring{
    width: 38px; height: 38px;
    border: 1px solid rgba(255,255,255,.7);
    margin: -19px 0 0 -19px;
    transition:
      width 700ms cubic-bezier(0.16, 1, 0.3, 1),
      height 700ms cubic-bezier(0.16, 1, 0.3, 1),
      margin 700ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 700ms cubic-bezier(0.16, 1, 0.3, 1),
      background 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Grow over links + interactive */
  .cursor.is-grow .cursor__ring{
    width: 72px; height: 72px;
    margin: -36px 0 0 -36px;
    border-color: rgba(255,255,255,.9);
    background: rgba(255,255,255,.06);
  }

  /* Shrink + invert when hovering text inputs */
  .cursor.is-text .cursor__dot{ opacity: 0; }
  .cursor.is-text .cursor__ring{
    width: 2px; height: 24px;
    margin: -12px 0 0 -1px;
    border-radius: 2px;
    background: rgba(255,255,255,.9);
    border-color: transparent;
  }

  /* Hide entirely on touch + reduced motion */
  @media (hover: none){
    html.js.cursor-on, html.js.cursor-on *{ cursor: auto !important; }
    .cursor{ display: none; }
  }
  @media (prefers-reduced-motion: reduce){
    .cursor__ring{ transition: none; }
  }
</style>

<script>
  function init() {
    if (matchMedia("(hover: none)").matches) return;

    const cursor = document.querySelector<HTMLElement>("[data-cursor]");
    const dot = document.querySelector<HTMLElement>("[data-cursor-dot]");
    const ring = document.querySelector<HTMLElement>("[data-cursor-ring]");
    if (!cursor || !dot || !ring) return;

    document.documentElement.classList.add("cursor-on");

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;
    let visible = false;

    const move = (e: PointerEvent) => {
      mx = e.clientX;
      my = e.clientY;
      if (!visible) {
        visible = true;
        rx = mx; ry = my;
      }
    };
    const leave = () => { visible = false; cursor.style.opacity = "0"; };
    const enter = () => { cursor.style.opacity = "1"; };

    window.addEventListener("pointermove", move, { passive: true });
    document.addEventListener("pointerleave", leave);
    document.addEventListener("pointerenter", enter);

    let raf = 0;
    const tick = () => {
      // Ring lerps behind for that "trailing" feel
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
      // Dot follows exactly — no lerp, feels precise
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    // Grow over interactive elements
    const onOver = (e: Event) => {
      const t = (e.target as HTMLElement | null)?.closest?.(
        "a, button, [data-cursor-grow], [role=button], input[type=submit]",
      );
      cursor.classList.toggle("is-grow", !!t);

      const text = (e.target as HTMLElement | null)?.closest?.(
        "input[type=text], input[type=email], textarea, [contenteditable]",
      );
      cursor.classList.toggle("is-text", !!text);
    };
    document.addEventListener("pointerover", onOver, { passive: true });

    // Cleanup on Astro nav swap
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(raf);
        window.removeEventListener("pointermove", move);
        document.removeEventListener("pointerleave", leave);
        document.removeEventListener("pointerenter", enter);
        document.removeEventListener("pointerover", onOver);
        document.documentElement.classList.remove("cursor-on");
      },
      { once: true },
    );
  }

  if (document.readyState === "complete") init();
  else window.addEventListener("load", init, { once: true });
  document.addEventListener("astro:page-load", init);
</script>

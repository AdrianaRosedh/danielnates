---
/**
 * ChapterCurtain — director-style page transitions for the three
 * project chapters. When the visitor clicks a link to /olivea,
 * /fritanguita, or /maizal (or their /en/ variants) anywhere on the
 * site, this curtain rises from below, holds the chapter name in
 * big italic display, then hands off to Astro's ClientRouter for
 * the actual navigation. After the swap, it lifts upward to reveal
 * the new page.
 *
 * Persisted across page swaps via transition:persist so the rising
 * timeline survives the navigation.
 *
 * Sits in BaseLayout next to the cursor + menu.
 */

import type { Locale } from "../../lib/types";

interface Props { locale?: Locale; }
const { locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";
---

<div
  class="chapterCurtain"
  data-chapter-curtain
  data-locale={locale}
  aria-hidden="true"
  transition:persist
  transition:name="chapter-curtain"
>
  <div class="chapterCurtain__bg" data-curtain-bg></div>
  <div class="chapterCurtain__inner" data-curtain-inner>
    <p class="chapterCurtain__index" data-curtain-index></p>
    <span class="chapterCurtain__rule" aria-hidden="true"></span>
    <h2 class="chapterCurtain__name" data-curtain-name></h2>
    <p class="chapterCurtain__meta" data-curtain-meta></p>
  </div>
</div>

<style>
  .chapterCurtain{
    position: fixed;
    inset: 0;
    z-index: 998;
    pointer-events: none;
    visibility: hidden;
  }
  .chapterCurtain.is-active{ visibility: visible; }

  /* Backdrop — wipes in from below, exits upward. The "film reel"
     direction: content always moves up, never down. */
  .chapterCurtain__bg{
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 50%,
        color-mix(in srgb, var(--olivar) 6%, var(--ink)),
        var(--ink) 70%),
      var(--ink);
    transform: translateY(100%);
    transition: transform 820ms cubic-bezier(0.7, 0, 0.2, 1);
  }
  .chapterCurtain.is-rising .chapterCurtain__bg{ transform: translateY(0); }
  .chapterCurtain.is-falling .chapterCurtain__bg{ transform: translateY(-100%); }

  /* Inner type stack */
  .chapterCurtain__inner{
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 clamp(20px, 6vw, 80px);
    color: var(--bone);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) 250ms,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1) 250ms;
  }
  .chapterCurtain.is-rising .chapterCurtain__inner{
    opacity: 1;
    transform: translateY(0);
  }
  .chapterCurtain.is-falling .chapterCurtain__inner{
    opacity: 0;
    transform: translateY(-12px);
    transition-delay: 0ms;
    transition-duration: 400ms;
  }

  .chapterCurtain__index{
    margin: 0 0 clamp(18px, 2.4vw, 30px);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: rgba(244,239,230,.55);
    font-feature-settings: "tnum";
  }
  .chapterCurtain__rule{
    display: block;
    width: clamp(64px, 10vw, 132px);
    height: 1px;
    background: color-mix(in srgb, var(--olivar) 70%, transparent);
    margin: 0 auto clamp(30px, 4vw, 52px);
  }
  .chapterCurtain__name{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(56px, 11vw, 156px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: var(--bone);
  }
  .chapterCurtain__meta{
    margin: clamp(28px, 3vw, 44px) 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: rgba(244,239,230,.50);
  }

  @media (prefers-reduced-motion: reduce){
    .chapterCurtain__bg,
    .chapterCurtain__inner{ transition: none; }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  type CurtainCopy = { idx: string; name: string; meta: string };
  type Loc = "es" | "en";

  /* Source of truth for chapter framing. The page-side framings dict
     lives in [slug].astro for the page hero — this curtain shows the
     opening title card, kept short and editorial. */
  const CHAPTERS: Record<string, Record<Loc, CurtainCopy>> = {
    olivea: {
      es: { idx: "Capítulo I",  name: "Olivea",      meta: "Valle de Guadalupe" },
      en: { idx: "Chapter I",   name: "Olivea",      meta: "Valle de Guadalupe" },
    },
    fritanguita: {
      es: { idx: "Capítulo II", name: "Fritanguita", meta: "Roma Norte · CDMX" },
      en: { idx: "Chapter II",  name: "Fritanguita", meta: "Roma Norte · CDMX" },
    },
    maizal: {
      es: { idx: "Capítulo III", name: "Maizal", meta: "Puebla · 2017–2024" },
      en: { idx: "Chapter III",  name: "Maizal", meta: "Puebla · 2017–2024" },
    },
  };

  function chapterFromHref(href: string): { slug: string; locale: Loc } | null {
    try {
      const url = new URL(href, window.location.origin);
      if (url.origin !== window.location.origin) return null;
      const path = url.pathname.replace(/\/+$/, "");
      const en = path.match(/^\/en\/([^\/]+)$/);
      const es = path.match(/^\/([^\/]+)$/);
      const slug = en ? en[1] : es ? es[1] : null;
      const locale: Loc = en ? "en" : "es";
      if (!slug || !CHAPTERS[slug]) return null;
      return { slug, locale };
    } catch {
      return null;
    }
  }

  declare global {
    interface Window { __chapterCurtainBooted?: boolean; }
  }

  function boot() {
    if (window.__chapterCurtainBooted) return;
    window.__chapterCurtainBooted = true;

    let pending = false;

    function refs() {
      const root = document.querySelector<HTMLElement>("[data-chapter-curtain]");
      return {
        root,
        index: root?.querySelector<HTMLElement>("[data-curtain-index]") ?? null,
        name:  root?.querySelector<HTMLElement>("[data-curtain-name]")  ?? null,
        meta:  root?.querySelector<HTMLElement>("[data-curtain-meta]")  ?? null,
      };
    }

    async function showAndNavigate(href: string, slug: string, locale: Loc) {
      if (pending) return;
      pending = true;

      const { root, index, name, meta } = refs();
      if (!root || !index || !name || !meta) {
        window.location.href = href;
        pending = false;
        return;
      }

      const data = CHAPTERS[slug][locale];
      index.textContent = data.idx;
      name.textContent  = data.name;
      meta.textContent  = data.meta;

      root.classList.add("is-active");
      root.classList.remove("is-falling");
      // Force layout so the rising transform actually animates.
      void root.offsetWidth;
      root.classList.add("is-rising");

      // Hold the title card. The bg wipes up over ~820ms; hold a beat
      // longer so the type lands and reads.
      await wait(950);

      try {
        await navigate(href);
      } catch {
        window.location.href = href;
        return;
      }

      // The new page is now in the DOM behind the curtain. Settle.
      await wait(220);

      // Re-grab refs in case persist didn't bind (defensive).
      const after = refs();
      if (after.root) {
        after.root.classList.remove("is-rising");
        after.root.classList.add("is-falling");
      }

      await wait(880);

      if (after.root) {
        after.root.classList.remove("is-active", "is-falling");
      }
      pending = false;
    }

    function onClick(e: MouseEvent) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (e.button !== 0) return;
      const a = (e.target as HTMLElement | null)?.closest?.("a[href]") as
        | HTMLAnchorElement
        | null;
      if (!a) return;
      if (a.target === "_blank" || a.hasAttribute("download")) return;

      const chapter = chapterFromHref(a.href);
      if (!chapter) return;

      // Don't curtain a click to the page you're already on.
      if (a.href === window.location.href) return;

      e.preventDefault();
      e.stopPropagation();
      showAndNavigate(a.href, chapter.slug, chapter.locale);
    }

    // Capture-phase so we beat ClientRouter's own click handler.
    document.addEventListener("click", onClick, { capture: true });
  }

  function wait(ms: number) { return new Promise((r) => setTimeout(r, ms)); }

  if (document.readyState === "complete") boot();
  else window.addEventListener("load", boot, { once: true });
  // ClientRouter re-fires page-load on every swap — boot is idempotent.
  document.addEventListener("astro:page-load", boot);
</script>

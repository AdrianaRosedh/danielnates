---
/**
 * CinematicEntrance — markup only. Animation is owned by AnimationDirector.
 * The pre-paint inline script decides skip vs show before first frame.
 */
interface Props {
  name?: string;
  enabled?: boolean;
}
const { name = "Daniel Nates", enabled = true } = Astro.props as Props;
if (!enabled) return null;
---

<div class="entrance" data-entrance aria-hidden="true">
  <div class="entrance__inner">
    <span class="entrance__dot"></span>
    <h2 class="entrance__name">{name}</h2>
    <span class="entrance__rule"></span>
    <p class="entrance__skip">Click para entrar</p>
  </div>
</div>

<style>
  .entrance{
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--ink, #0E0F0C);
    color: var(--bone, #F4EFE6);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    will-change: transform, opacity;
    overflow: hidden;
    box-shadow: inset 0 0 200px rgba(0,0,0,.5);
  }
  .entrance__inner{
    display: flex; flex-direction: column; align-items: center;
    gap: 18px; padding: 0 24px;
  }
  .entrance__dot{
    width: 9px; height: 9px; border-radius: 999px;
    background: var(--bone, #F4EFE6);
    opacity: 0; transform: scale(.7);
  }
  .entrance__name{
    margin: 0;
    font-family: var(--font-display, "Instrument Serif", serif);
    font-weight: 400;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1;
    letter-spacing: -0.025em;
    word-spacing: .04em;
    color: var(--bone, #F4EFE6);
    opacity: 0;
  }
  .entrance__rule{
    display: block; height: 1px; width: 0;
    background: rgba(244,239,230,.55);
    margin-top: 4px;
  }
  .entrance__skip{
    margin: 22px 0 0;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: rgba(244,239,230,.45);
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce){ .entrance{ display: none; } }
</style>

{/* Pre-paint: decide skip vs show before the first frame, plus
    escape hatches so the user is never trapped if the timeline
    fails to run for any reason. */}
<script is:inline>
  (function(){
    try {
      var url = new URL(location.href);
      var force = url.searchParams.get('intro') === '1';
      var seen = localStorage.getItem('dn_entered_v1') === '1';
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if ((!force && seen) || reduce) {
        document.documentElement.dataset.entranceSkip = '1';
        var s = document.createElement('style');
        s.textContent = '[data-entrance]{display:none !important}';
        document.head.appendChild(s);
        return;
      }

      document.documentElement.dataset.entranceActive = '1';
      document.documentElement.style.overflow = 'hidden';

      var dismissed = false;
      function release(){
        if (dismissed) return;
        dismissed = true;
        document.documentElement.style.overflow = '';
        document.documentElement.style.removeProperty('overflow');
        document.body && (document.body.style.overflow = '');
        delete document.documentElement.dataset.entranceActive;
        // Tell AnimationDirector to take its skip path — otherwise it
        // would find [data-entrance] still in the DOM (we fade it for
        // 380ms) and re-lock scroll for its 4.6s timeline.
        document.documentElement.dataset.entranceSkip = '1';
        var el = document.querySelector('[data-entrance]');
        if (el) {
          el.style.transition = 'opacity 320ms ease, transform 320ms ease';
          el.style.opacity = '0';
          el.style.transform = 'translateY(-12px)';
          setTimeout(function(){ try { el.remove(); } catch(_){} }, 380);
        }
        try { localStorage.setItem('dn_entered_v1', '1'); } catch(_) {}
        window.removeEventListener('wheel', release, { passive: true });
        window.removeEventListener('touchmove', release, { passive: true });
        window.removeEventListener('touchstart', release, { passive: true });
        window.removeEventListener('keydown', release);
        window.removeEventListener('click', release);
      }

      // Any user gesture dismisses the curtain immediately.
      window.addEventListener('wheel', release, { passive: true });
      window.addEventListener('touchmove', release, { passive: true });
      window.addEventListener('touchstart', release, { passive: true });
      window.addEventListener('keydown', release);
      window.addEventListener('click', release);

      // Hard failsafe: never trap the user, even if AnimationDirector
      // never runs (import error, slow JS, anything).
      setTimeout(release, 6000);
    } catch (_) {
      try { document.documentElement.style.overflow = ''; } catch (_) {}
    }
  })();
</script>

---
import type { Locale, Project } from "../../lib/types";
import { href, t, ui } from "../../lib/i18n";

interface Props {
  projects?: Project[];
  locale?: Locale;
}

const { projects = [], locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";
---

<section class="section">
  {projects.length ? (
    <div class="grid reveal-stagger">
      {projects.map((p) => (
        <article
          class="projectCard"
          transition:name={`proj-${p?.slug?.current ?? "x"}`}
        >
          <div class="projectLeft">
            <h3
              class="projectTitle"
              transition:name={`proj-title-${p?.slug?.current ?? "x"}`}
            >
              {p?.title ?? "Proyecto"}
            </h3>

            <p class="projectText">{t(p?.summary, locale)}</p>

            <div class="badges">
              <span class="badge">
                {p?.status === "primary"
                  ? ui("primaryProject", locale)
                  : p?.status === "secondary"
                  ? ui("secondaryProject", locale)
                  : ui("pastProject", locale)}
              </span>

              {p?.slug?.current === "olivea" && <span class="badge">{ui("centralProject", locale)}</span>}
              {p?.slug?.current === "fritanguita" && <span class="badge">{ui("fastRhythm", locale)}</span>}
              {p?.slug?.current === "maizal" && <span class="badge">{ui("archive", locale)}</span>}
            </div>
          </div>

          {p?.slug?.current ? (
            <a class="cta" href={href(`/${p.slug.current}`, locale)}>{ui("explore", locale)}</a>
          ) : null}
        </article>
      ))}
    </div>
  ) : (
    <p class="sub">{ui("noProjects", locale)}</p>
  )}
</section>

---
import type { Locale, Project } from "../../lib/types";
import { href, t2, ui } from "../../lib/i18n";

interface Props {
  projects?: Project[];
  locale?: Locale;
}

const { projects = [], locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";
---

<section class="section">
  {projects.length ? (
    <div class="grid reveal-stagger">
      {projects.map((p) => (
        <article class="projectCard" transition:name={`proj-${p.slug}`}>
          <div class="projectLeft">
            <h3 class="projectTitle" transition:name={`proj-title-${p.slug}`}>
              {p.title}
            </h3>
            <p class="projectText">{t2(p.summary_es, p.summary_en, locale)}</p>
            <div class="badges">
              <span class="badge">
                {p.status === "primary"
                  ? ui("primaryProject", locale)
                  : p.status === "secondary"
                  ? ui("secondaryProject", locale)
                  : ui("pastProject", locale)}
              </span>
              {p.slug === "olivea" && <span class="badge">{ui("centralProject", locale)}</span>}
              {p.slug === "fritanguita" && <span class="badge">{ui("fastRhythm", locale)}</span>}
              {p.slug === "maizal" && <span class="badge">{ui("archive", locale)}</span>}
            </div>
          </div>
          <a class="cta" href={href(`/${p.slug}`, locale)}>{ui("explore", locale)}</a>
        </article>
      ))}
    </div>
  ) : (
    <p class="sub">{ui("noProjects", locale)}</p>
  )}
</section>

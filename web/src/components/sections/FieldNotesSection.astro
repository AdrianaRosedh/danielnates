---
import type { FieldNote, Locale } from "../../lib/types";
import { ui } from "../../lib/i18n";

interface Props {
  notes?: FieldNote[];
  locale?: Locale;
}

const { notes = [], locale: propLocale } = Astro.props as Props;
const locale: Locale = propLocale ?? Astro.locals.locale ?? "es";

const categoryLabel: Record<string, Record<Locale, string>> = {
  ingredient: { es: "Ingrediente", en: "Ingredient" },
  territory: { es: "Territorio", en: "Territory" },
  technique: { es: "Técnica", en: "Technique" },
  influence: { es: "Influencia", en: "Influence" },
};
---

<section class="section">
  {notes.length ? (
    <div class="noteList">
      {notes.slice(0, 6).map((n) => (
        <div class="noteRow">
          <div style="min-width:0;">
            <p class="noteTitle">{n?.title ?? "Nota"}</p>
            {n?.externalLink ? (
              <p class="sub" style="margin-top:6px;font-size:12px;">
                <a href={n.externalLink} target="_blank" rel="noreferrer">{ui("readMore", locale)}</a>
              </p>
            ) : null}
          </div>
          <p class="noteMeta">{n?.category ? categoryLabel[n.category]?.[locale] ?? n.category : "—"}</p>
        </div>
      ))}
    </div>
  ) : (
    <p class="sub">{ui("noEntries", locale)}</p>
  )}
</section>

---
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import PortableText from "../components/content/PortableText.astro";
import NextChapter from "../components/content/NextChapter.astro";
import SmartImage from "../components/content/SmartImage.astro";

import { getDaniel, getPressKit, getPressMentions } from "../lib/queries";
import { dateFormat, href, t2, tb2 } from "../lib/i18n";
import { MEDIA } from "../lib/site";
import type { Locale, PressMention, PressRecognition } from "../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const [daniel, kit, dbMentions] = await Promise.all([getDaniel(), getPressKit(), getPressMentions()]);

/* ── Real, researched defaults so this page is presentable from day 1 ── */
const defaultBioOneLine = locale === "es"
  ? "Cocinero mexicano. Olivea Farm to Table en Valle de Guadalupe (Estrella Michelin + Estrella Verde). Socio de Fritanguita en CDMX. Dibujante."
  : "Mexican chef. Olivea Farm to Table in Valle de Guadalupe (Michelin Star + Green Star). Partner at Fritanguita in CDMX. Draughtsman.";

const defaultBioShort = locale === "es"
  ? "Daniel Nates es chef de Olivea Farm to Table (Valle de Guadalupe), galardonado con Estrella Michelin y Estrella Verde Michelin. Es socio fundador de Fritanguita, una fritanga poblana en Roma Norte, CDMX. Antes dirigió ocho años Maizal en Puebla. Finalista regional Latinoamérica de S.Pellegrino Young Chef 2016 con su platillo Quiltamal — premio al Mensaje Más Inspirador. Reconocido por Food & Wine en Español como uno de los 19 mejores chefs nuevos de México."
  : "Daniel Nates is chef of Olivea Farm to Table (Valle de Guadalupe), awarded a Michelin Star and Michelin Green Star. He is co-founder of Fritanguita, a poblano fritanga stand in Roma Norte, Mexico City. Before that he led Maizal in Puebla for eight years. Latin America regional finalist of S.Pellegrino Young Chef 2016 with his dish Quiltamal — winner of the Most Inspiring Message award. Named by Food & Wine en Español as one of Mexico's 19 best new chefs.";

const defaultRecognitions: PressRecognition[] = [
  {
    year: "2025",
    label: locale === "es" ? "Estrella Michelin · Estrella Verde Michelin" : "Michelin Star · Michelin Green Star",
    org: "Olivea Farm to Table · Guía Michelin México",
    url: "https://guide.michelin.com/us/en/baja-california/ensenada_2059847/restaurant/olivea-farm-to-table",
  },
  {
    year: "2024",
    label: locale === "es" ? "Inclusión Guía Michelin" : "Michelin Guide listing",
    org: "Olivea Farm to Table",
  },
  {
    year: "2016",
    label: locale === "es" ? "S.Pellegrino Young Chef · Latinoamérica · Mensaje Más Inspirador" : "S.Pellegrino Young Chef · Latin America · Most Inspiring Message",
    org: "S.Pellegrino · Quiltamal",
    url: "https://www.sanpellegrinoyoungchefacademy.com/academy-stories/latin-america-winner",
  },
  {
    year: "2018",
    label: locale === "es" ? "19 Mejores Chefs Nuevos de México" : "Best New Chefs Mexico — 19",
    org: "Food & Wine en Español",
  },
];

const defaultMentions: PressMention[] = [
  {
    outlet: "Michelin Guide",
    title: "Olivea Farm to Table — Ensenada / Baja California",
    url: "https://guide.michelin.com/us/en/baja-california/ensenada_2059847/restaurant/olivea-farm-to-table",
    language: "en",
  },
  {
    outlet: "El Financiero",
    title: "Fritanguita: el puesto callejero en CDMX de chefs de Shark Tank y S.Pellegrino",
    url: "https://www.elfinanciero.com.mx/food-and-drink/2025/12/19/asi-es-fritanguita-puesto-en-cdmx-de-los-chefs-daniel-nates-y-santiago-munoz/",
    date: "2025-12-19",
    language: "es",
  },
  {
    outlet: "Yahoo Noticias",
    title: "Daniel Nates llega a Olivea, el restaurante Michelin donde el huerto lo define todo",
    url: "https://es-us.noticias.yahoo.com/daniel-nates-llega-olivea-restaurante-150500146.html",
    language: "es",
  },
  {
    outlet: "Guía OCA",
    title: "Daniel Nates: el chef como artista",
    url: "https://puebla.guiaoca.mx/es/contenido/daniel-nates-el-chef-como-artista/",
    language: "es",
  },
  {
    outlet: "Food and Pleasure",
    title: "Por qué un restaurante mexicano tiene una estrella verde Michelin",
    url: "https://foodandpleasure.com/olivea-farm-to-table-valle-guadalupe/",
    language: "es",
  },
];

const bioOneLine = t2(kit?.bio_one_line_es, kit?.bio_one_line_en, locale) || defaultBioOneLine;
const bioShort = t2(kit?.bio_short_es, kit?.bio_short_en, locale) || defaultBioShort;
const bioLong = tb2(kit?.bio_long_es, kit?.bio_long_en, locale);
const recognitions = kit?.recognitions?.length ? kit.recognitions : defaultRecognitions;

/* Inline-edit field paths. The short bio uses the popover modal; the
 * long bio is PortableText and is edited in place with the rich
 * toolbar (formatting and links survive the round-trip). */
const bioOneLineField = `press_kit.bio_one_line_${locale}`;
const bioShortField   = `press_kit.bio_short_${locale}`;
const bioLongField    = `press_kit.bio_long_${locale}`;
const pressEmailField = "press_kit.press_email";
/* Mentions live in the press_mentions table (admin: /admin/press). Fall back
 * to the researched defaults when the table is empty so the page is presentable
 * from day one. */
const mentions: PressMention[] = dbMentions.length ? dbMentions : defaultMentions;
const photos = kit?.photos ?? [];
const pressEmail = kit?.press_email || daniel?.social?.email || null;
const pressPdfUrl = kit?.press_pdf_url ?? null;

const headline = locale === "es" ? "Prensa." : "Press.";
const es = locale === "es";
/* Until a press photo set is uploaded, offer the garden portrait — the
 * full-resolution original (7008 × 4672) ships in /public. */
const pressPhotos = photos.length
  ? photos
  : [{
      url: MEDIA.portrait,
      caption: es ? "Daniel Nates en el huerto de Olivea, Valle de Guadalupe." : "Daniel Nates in the Olivea garden, Valle de Guadalupe.",
      credit: null as string | null,
      meta: MEDIA.portraitMeta,
    }];

const lede = locale === "es"
  ? "Bio, fotografías de alta resolución, reconocimientos y menciones recientes. Para entrevistas, escribe directo."
  : "Bio, hi-res photographs, recognitions and recent mentions. For interviews, write directly.";

---

<BaseLayout
  title={`${locale === "es" ? "Prensa" : "Press"} — Daniel Nates`}
  description={bioOneLine}
  locale={locale}
  createContext={{ entity: "press_mention", label: locale === "es" ? "Nueva mención" : "New mention" }}
  og={{
    title: locale === "es" ? "Prensa" : "Press",
    kicker: "Daniel Nates",
    sig: bioOneLine,
    brand: "daniel",
    meta: locale === "es" ? "Kit de prensa" : "Press kit",
  }}
>
  <div class="shell">
    <TopDock locale={locale} />

    <div class="press ui-paper scene--bone" data-scene="bone">
      <header class="press__head">
        <p class="press__kicker ui-label">{es ? "Prensa" : "Press"}</p>
        <h1 class="press__title" data-reveal-text data-reveal-mode="letter" aria-label={headline}>{headline}</h1>
        <p class="press__lede reveal">{lede}</p>
        <nav class="press__jump reveal" aria-label={es ? "En esta página" : "On this page"}>
          <a class="ui-pill ui-pill--sm" href="#bio">Bio</a>
          <a class="ui-pill ui-pill--sm" href="#fotos">{es ? "Fotografías" : "Photographs"}</a>
          <a class="ui-pill ui-pill--sm" href="#reconocimientos">{es ? "Reconocimientos" : "Recognitions"}</a>
          <a class="ui-pill ui-pill--sm" href="#menciones">{es ? "Menciones" : "Mentions"}</a>
          <a class="ui-pill ui-pill--sm" href="#contacto-prensa">{es ? "Contacto" : "Contact"}</a>
        </nav>
      </header>

      {/* Bio — three lengths, each one click from the clipboard. */}
      <section class="press__sec" id="bio">
        <h2 class="press__secTitle ui-label">Bio</h2>
        <div class="press__bioRow reveal">
          <div class="press__bioMeta">
            <p class="ui-label">{es ? "Una línea" : "One line"}</p>
            <button class="press__copy ui-pill ui-pill--sm" type="button" data-copy="#bio-one">{es ? "Copiar" : "Copy"}</button>
          </div>
          <p class="press__one" id="bio-one" data-edit-field={bioOneLineField}>{bioOneLine}</p>
        </div>
        <div class="press__bioRow reveal">
          <div class="press__bioMeta">
            <p class="ui-label">{es ? "Párrafo" : "Paragraph"}</p>
            <button class="press__copy ui-pill ui-pill--sm" type="button" data-copy="#bio-short">{es ? "Copiar" : "Copy"}</button>
          </div>
          <p
            class="press__short"
            id="bio-short"
            data-edit-field={bioShortField}
            data-edit-multi="1"
            data-edit-source={bioShort}
          >{bioShort}</p>
        </div>
        <div class="press__bioRow reveal">
          <div class="press__bioMeta">
            <p class="ui-label">{es ? "Larga" : "Long"}</p>
            {bioLong.length ? <button class="press__copy ui-pill ui-pill--sm" type="button" data-copy="#bio-long">{es ? "Copiar" : "Copy"}</button> : null}
          </div>
          {bioLong.length ? (
            <div id="bio-long" data-edit-field={bioLongField} data-edit-portable="1">
              <PortableText value={bioLong} />
            </div>
          ) : (
            <div
              data-edit-field={bioLongField}
              data-edit-portable="1"
              data-edit-empty="1"
              class="press__short"
              style="color: var(--text-3); font-style: italic;"
            >
              {es ? "(añade la bio larga)" : "(add the long bio)"}
            </div>
          )}
        </div>
      </section>

      {/* Photographs — downloadable originals. */}
      <section class="press__sec" id="fotos">
        <h2 class="press__secTitle ui-label">{es ? "Fotografías" : "Photographs"}</h2>
        <div class="press__photos reveal-stagger">
          {pressPhotos.map((p) => p.url ? (
            <figure class="press__photo">
              <div class="press__photoImg">
                <SmartImage src={p.url} alt={p.caption ?? ""} widths={[800, 1200]} sizes="(min-width: 880px) 60vw, 100vw" />
              </div>
              <figcaption>
                {p.caption ? <span class="press__photoCap">{p.caption}</span> : null}
                {"meta" in p && p.meta ? <span class="press__photoMeta">{p.meta}</span> : null}
                {p.credit ? <span class="press__photoMeta">© {p.credit}</span> : null}
                <a class="press__download ui-pill ui-pill--solid ui-pill--sm" href={p.url} download>
                  {es ? "Descargar original" : "Download original"} <span aria-hidden="true">↓</span>
                </a>
              </figcaption>
            </figure>
          ) : null)}
        </div>
      </section>

      {/* Recognitions and mentions, side by side. */}
      <div class="press__two">
        {recognitions.length ? (
          <section class="press__sec" id="reconocimientos">
            <h2 class="press__secTitle ui-label">{es ? "Reconocimientos" : "Recognitions"}</h2>
            <ol class="press__recList">
              {recognitions.map((r) => (
                <li class="press__rec reveal">
                  <span class="press__recYear">{r.year}</span>
                  <div>
                    <p class="press__recLabel">
                      {r.url ? <a href={r.url} target="_blank" rel="noreferrer">{r.label}</a> : r.label}
                    </p>
                    {r.org ? <p class="press__recOrg">{r.org}</p> : null}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {mentions.length ? (
          <section class="press__sec" id="menciones">
            <h2 class="press__secTitle ui-label">{es ? "Menciones" : "Mentions"}</h2>
            <ul class="press__mentions">
              {mentions.map((m) => (
                <li class="press__mention reveal" id={m.id ? `mention-${m.id}` : undefined}>
                  <a href={m.url} target="_blank" rel="noreferrer">
                    <span class="press__outlet" data-edit-field={m.id ? `press_mention.${m.id}.outlet` : undefined}>{m.outlet}</span>
                    {m.title ? (
                      <span class="press__mentionTitle" data-edit-field={m.id ? `press_mention.${m.id}.title` : undefined}>{m.title}</span>
                    ) : m.id ? (
                      <span class="press__mentionTitle" data-edit-field={`press_mention.${m.id}.title`} style="color: var(--text-3); font-style: italic;">
                        {es ? "(añadir título)" : "(add title)"}
                      </span>
                    ) : null}
                    <span class="press__mentionMeta">
                      {m.date ? dateFormat(m.date, locale) : null}
                      {m.date && m.language ? " · " : null}
                      {m.language ? m.language.toUpperCase() : null}
                      <span aria-hidden="true"> ↗</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null}
      </div>

      {/* Contact — always a way through. */}
      <section class="press__sec press__contact" id="contacto-prensa">
        <h2 class="press__secTitle ui-label">{es ? "Contacto de prensa" : "Press contact"}</h2>
        <p class="press__contactLine">{es ? "Entrevistas, fotografía, visitas a la cocina." : "Interviews, photography, kitchen visits."}</p>
        <div class="press__contactRow">
          {pressEmail ? (
            <a class="ui-pill ui-pill--solid" href={`mailto:${pressEmail}?subject=${encodeURIComponent("Prensa — Daniel Nates")}`} data-edit-field={pressEmailField}>{pressEmail}</a>
          ) : (
            <a class="ui-pill ui-pill--solid" href={`${href("/contacto", locale)}?tema=prensa`}>{es ? "Escribir a prensa" : "Write to press"} <span aria-hidden="true">→</span></a>
          )}
          {pressPdfUrl ? (
            <a class="ui-pill" href={pressPdfUrl} target="_blank" rel="noreferrer">{es ? "Kit completo (PDF)" : "Full kit (PDF)"} <span aria-hidden="true">↓</span></a>
          ) : null}
          {!pressEmail && Astro.locals.isAdmin ? (
            <span class="press__adminHint" data-edit-field={pressEmailField}>{es ? "(añadir email de prensa)" : "(add press email)"}</span>
          ) : null}
        </div>
      </section>
    </div>

    <NextChapter current="prensa" locale={locale} />
  </div>
</BaseLayout>

<style>
  .press > *{ max-width: 1240px; margin-inline: auto; }

  .press__title{
    margin: clamp(16px, 2.6vh, 28px) 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(80px, 13vw, 240px);
    line-height: .84;
    letter-spacing: -0.05em;
  }
  .press__lede{
    margin: clamp(22px, 3.4vh, 36px) 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(21px, 1.8vw, 30px);
    line-height: 1.3;
    color: var(--text-2);
  }
  .press__jump{
    margin-top: clamp(32px, 5vh, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .press__sec{
    margin-top: clamp(80px, 13vh, 150px);
    padding-top: clamp(20px, 3vh, 30px);
    border-top: 1px solid var(--line);
    scroll-margin-top: 110px;
  }
  .press__secTitle{ margin-bottom: clamp(28px, 4vh, 44px); }

  /* Bio rows */
  .press__bioRow{
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(20px, 4vw, 72px);
    padding: clamp(24px, 3.4vh, 36px) 0;
    border-top: 1px solid var(--line);
  }
  .press__bioRow:first-of-type{ border-top: 0; padding-top: 0; }
  .press__bioMeta{ display: grid; gap: 12px; align-content: start; justify-items: start; }
  .press__download{ margin-top: 8px; }
  .press__copy[data-copied]{ background: var(--olivar); border-color: var(--olivar); color: var(--bone); }
  .press__one{
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.8vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .press__short{
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.45vw, 24px);
    line-height: 1.45;
    color: color-mix(in srgb, var(--text) 88%, transparent);
  }

  /* Photographs */
  .press__photos{ display: grid; gap: clamp(28px, 4vw, 56px); }
  .press__photo{
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: end;
  }
  .press__photoImg{ aspect-ratio: 3 / 2; overflow: hidden; background: var(--bone-2, #E6DCC6); }
  .press__photoImg :global(img){ width: 100%; height: 100%; object-fit: cover; display: block; }
  .press__photo figcaption{ display: grid; gap: 10px; justify-items: start; }
  .press__photoCap{
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(19px, 1.5vw, 24px);
    line-height: 1.3;
  }
  .press__photoMeta{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* Recognitions + mentions */
  .press__two{
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 112px);
  }
  .press__recList, .press__mentions{ list-style: none; margin: 0; padding: 0; }
  .press__rec{
    display: grid;
    grid-template-columns: 4.2em 1fr;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .press__recYear{
    font-family: var(--font-display);
    font-size: clamp(26px, 2.2vw, 36px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .press__recLabel{
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.4vw, 23px);
    line-height: 1.2;
  }
  .press__recLabel a{ color: inherit; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .18em; text-decoration-color: var(--line-2); }
  .press__recOrg{
    margin: 6px 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .press__mention{ border-top: 1px solid var(--line); }
  .press__mention a{
    display: grid;
    gap: 6px;
    padding: 18px 0;
    color: var(--text);
    text-decoration: none;
    transition: padding-left 600ms var(--ease-fluid);
  }
  .press__mention a:hover{ padding-left: 8px; }
  .press__outlet{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .press__mentionTitle{
    font-family: var(--font-display);
    font-size: clamp(20px, 1.6vw, 27px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .press__mentionMeta{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* Contact */
  .press__contactLine{
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(36px, 4.6vw, 80px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .press__contactRow{ margin-top: clamp(28px, 4vh, 44px); display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .press__adminHint{ font-style: italic; color: var(--text-3); font-size: 14px; }

  @media (max-width: 880px){
    .press__bioRow, .press__photo, .press__two{ grid-template-columns: 1fr; }
    .press__bioMeta{ grid-auto-flow: column; justify-content: space-between; align-items: center; width: 100%; }
  }
</style>

<script>
  // One-click copy for the bio lengths.
  function bindCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      const b = btn as HTMLButtonElement & { __copy?: boolean };
      if (b.__copy) return;
      b.__copy = true;
      const label = b.textContent ?? "";
      b.addEventListener("click", async () => {
        const target = document.querySelector<HTMLElement>(b.dataset.copy ?? "");
        if (!target) return;
        try {
          await navigator.clipboard.writeText(target.innerText.trim());
          b.dataset.copied = "1";
          b.textContent = document.documentElement.lang === "en" ? "Copied ✓" : "Copiado ✓";
          setTimeout(() => { delete b.dataset.copied; b.textContent = label; }, 1800);
        } catch {}
      });
    });
  }
  bindCopy();
  document.addEventListener("astro:page-load", bindCopy);
</script>

---
// On-demand, so missing slugs can Astro.rewrite() here with a real 404.
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import Sketch from "../components/content/Sketch.astro";
import { href, ui } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

// Only /404 itself is Astro's special not-found route; /en/404 (and any
// rewrite to it) is an ordinary page — set the status explicitly.
Astro.response.status = 404;
---

<BaseLayout title={`${ui("404Title", locale)} — Daniel Nates`} locale={locale}>
  <div class="shell">
    <TopDock locale={locale} />
    <section class="nf">
      <Sketch kind="cazo" tone="ink" class="nf__sketch" />
      <p class="nf__kicker ui-label">404</p>
      <h1 class="nf__title">{ui("404Title", locale)}</h1>
      <p class="nf__body">{ui("404Body", locale)}</p>
      <a class="nf__home ui-pill" href={href("/", locale)}>{ui("backHome", locale)} <span aria-hidden="true">→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .nf{
    min-height: calc(100svh - 240px);
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    padding: clamp(40px, 8vh, 96px) 20px;
  }
  :global(.nf__sketch){ width: min(260px, 60vw); margin-bottom: clamp(20px, 4vh, 40px); }
  .nf__title{
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(52px, 8vw, 132px);
    line-height: .9;
    letter-spacing: -0.04em;
  }
  .nf__body{
    margin: 18px 0 0;
    max-width: 40ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.5vw, 24px);
    color: var(--text-2);
  }
  .nf__home{ margin-top: clamp(26px, 4vh, 40px); }
</style>

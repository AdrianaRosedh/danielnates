---
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import ColdOpen from "../components/scenes/ColdOpen.astro";
import NotebookScene from "../components/scenes/NotebookScene.astro";
import FrameScene from "../components/scenes/FrameScene.astro";
import ServiceScene from "../components/scenes/ServiceScene.astro";
import LedgerBrief from "../components/scenes/LedgerBrief.astro";
import Closing from "../components/scenes/Closing.astro";

import { getDaniel } from "../lib/queries";
import { t2 } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

/* Landing page composition — six chapters, six scenes.
 *
 *   0 · Aparición    — ColdOpen        (ink, garden photo at full presence)
 *   I · El Cuaderno  — NotebookScene   (CREAM, horizontal page-turn signature)
 *  II · El Huerto    — FrameScene moss (moss-tinted ink, inverse parallax rest)
 * III · El Servicio  — ServiceScene    (clay → ember scrub'd color bleed, pulled quote)
 *  IV · La Mesa      — LedgerBrief     (CREAM, ledger of what's open right now)
 *   V · Coda         — Closing         (mist → ink gradient, the film ends)
 *
 * Color rhythm: ink → CREAM → moss-ink → clay-ember → CREAM → mist-ink.
 * Six distinctly-coloured rooms — the all-black problem solved
 * structurally, not cosmetically.
 *
 * Manifesto, three ChapterHeros, MagazineSpread, AtelierPreview and
 * TheLine all live on dedicated pages, not the landing — the landing
 * makes ONE argument: the same hand cooks and draws. The Notebook IS
 * that argument; everything else supports it. */

const daniel = await getDaniel();

const heroName = daniel?.name ?? "Daniel Nates";
const heroLine = t2(daniel?.tagline_es, daniel?.tagline_en, locale) || (locale === "es"
  ? "Cocinar y dibujar — la misma lengua."
  : "To cook and to draw — the same language.");
const heroSig = t2(daniel?.subline_es, daniel?.subline_en, locale) || (locale === "es"
  ? "Cocinero en Olivea · Socio en Fritanguita · Dibujante."
  : "Chef at Olivea · Partner at Fritanguita · Draughtsman.");
const heroMeta = locale === "es"
  ? "Valle de Guadalupe · CDMX · MMXXVI"
  : "Valle de Guadalupe · Mexico City · MMXXVI";
---

<BaseLayout
  title={`${heroName} — ${heroLine}`}
  description={heroSig ?? heroLine}
  locale={locale}
  og={{
    title: heroName,
    kicker: locale === "es" ? "Capítulo 0" : "Chapter 0",
    sig: heroLine,
    brand: "daniel",
    meta: heroMeta,
  }}
>
  <TopDock locale={locale} />

  {/* 0 · Aparición — arrival. The garden photograph at full presence,
      the name, one signature line. No menu, no list, no metadata. */}
  <ColdOpen
    name={heroName}
    signature={heroSig}
    meta={heroMeta}
    posterUrl="/media/hero/daniel-garden.jpg"
    voice={daniel?.voice ?? null}
    locale={locale}
  />

  {/* I · El Cuaderno — the signature. Five spreads turn horizontally
      as you scroll vertically. Each spread = a hand-drawn line on the
      left + a project on the right. The same hand that cooks draws
      first; that thesis IS the page. */}
  <NotebookScene
    title={locale === "es" ? "El Cuaderno" : "The Notebook"}
    locale={locale}
  />

  {/* II · El Huerto — pure photography rest. Moss-tinted ink. The
      garden image enters BIG (scale 1.18) and slowly settles back —
      inverse parallax. The world recedes. */}
  <FrameScene
    src="/media/hero/daniel-garden.jpg"
    alt={heroName}
    tone="moss"
    index="II"
    caption={locale === "es"
      ? "Cuando la cocina escucha al campo primero."
      : "When the kitchen listens to the field first."}
    place="Olivea · Valle de Guadalupe · MMXXVI"
    ratio="16/9"
    locale={locale}
  />

  {/* III · El Servicio — the hot moment. Pinned 200vh. The room
      visibly oxidizes from clay-tinted ink to ember-tinted ink as
      you scroll past. The pulled quote stays still; color does the
      emotional work. The ONLY place ember appears as more than a
      hairline. */}
  <ServiceScene
    index="III"
    locale={locale}
  />

  {/* IV · La Mesa — practical. Cream surface, ledger of three rows
      (Olivea / Fritanguita / Maizal) with current state + CTA.
      Brand-color marks reveal on hover. Returns the eye to cream
      after the heat. */}
  <LedgerBrief
    index="IV"
    locale={locale}
  />

  {/* V · Coda — closing. Mist→ink gradient, the only place the
      mountain blue-gray of the photo gets used. Closes the natural-
      palette loop. */}
  <Closing locale={locale} daniel={daniel} />

</BaseLayout>

---
export const prerender = false;

import EmptyState from "../components/content/EmptyState.astro";
import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import SmartImage from "../components/content/SmartImage.astro";
import NextChapter from "../components/content/NextChapter.astro";
import { getSupabase, getSupabaseServer } from "../lib/supabase";
import { dateFormat } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";
const isAdmin = Astro.locals.isAdmin === true;

interface Brief {
  id: string;
  date: string;
  image_url: string | null;
  line_es: string | null;
  line_en: string | null;
  place: string | null;
  published: boolean;
}

/* Admins fetch via authenticated client and see drafts (with a pill);
 * everyone else hits anon + published-only. */
const supabase = isAdmin ? getSupabaseServer(Astro.cookies) : getSupabase();
let briefs: Brief[] = [];
if (supabase) {
  let q = supabase
    .from("daily_briefs")
    .select("id, date, image_url, line_es, line_en, place, published")
    .order("date", { ascending: false })
    .limit(120);
  if (!isAdmin) q = q.eq("published", true);
  const { data } = await q;
  briefs = (data ?? []) as Brief[];
}

const headline = locale === "es" ? "Un día, una nota." : "One day, one note.";
const lede = locale === "es"
  ? "Una imagen y una línea, casi cada día. Lo que la cocina, el huerto o el cuaderno me dejaron."
  : "One image and one line, almost every day. What the kitchen, the garden, or the sketchbook left me.";

const localizedLine = (b: Brief) =>
  locale === "es" ? (b.line_es ?? b.line_en ?? "") : (b.line_en ?? b.line_es ?? "");
---

<BaseLayout
  title={`${locale === "es" ? "Día" : "Day"} — Daniel Nates`}
  description={lede}
  locale={locale}
  createContext={{ entity: "daily", label: "Nuevo brief" }}
  og={{
    title: locale === "es" ? "Día" : "Day",
    kicker: locale === "es" ? "Brief diario" : "Daily brief",
    sig: lede,
    brand: "daniel",
    meta: locale === "es" ? `${briefs.length} entradas` : `${briefs.length} entries`,
  }}
>
  <TopDock locale={locale} />

  <div class="shell">
    <section class="section reveal">
      <p class="kicker">{locale === "es" ? "Brief diario" : "Daily brief"}</p>
      <h1 class="h1" style="margin-bottom: 18px;">{headline}</h1>
      <p class="lede" style="max-width: 60ch;">{lede}</p>
    </section>

    {briefs.length ? (
      <section class="section">
        <ol class="dia__grid reveal-stagger">
          {briefs.map((b) => {
            const line = localizedLine(b);
            return (
              <li class="dia__cell" id={`brief-${b.id}`}>
                <article class="dia__card">
                  <div class="dia__cover" data-edit-image-field={`daily.${b.id}.image_url`}>
                    {b.image_url ? (
                      <SmartImage
                        src={b.image_url}
                        alt={line || b.date}
                        widths={[480, 800]}
                        sizes="(min-width: 880px) 33vw, 100vw"
                      />
                    ) : (
                      <div class="dia__noimg" aria-hidden="true"></div>
                    )}
                    {isAdmin && !b.published ? (
                      <span class="dia__draftPill">Borrador</span>
                    ) : null}
                  </div>
                  <div class="dia__body">
                    <p class="dia__date">{dateFormat(b.date, locale)}</p>
                    {line ? (
                      <p class="dia__line" data-edit-field={`daily.${b.id}.line_${locale}`}>{line}</p>
                    ) : (
                      <p class="dia__line" data-edit-field={`daily.${b.id}.line_${locale}`}></p>
                    )}
                    {b.place ? (
                      <p class="dia__place" data-edit-field={`daily.${b.id}.place`}>{b.place}</p>
                    ) : (
                      <p class="dia__place" data-edit-field={`daily.${b.id}.place`}></p>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      </section>
    ) : (
      <EmptyState
        sketch="mesa"
        line={locale === "es" ? "La primera nota está por escribirse." : "The first note is still to be written."}
        note={locale === "es" ? "Una imagen y una línea, cada día, desde la cocina." : "One image and one line, every day, from the kitchen."}
        adminHint="Activa Editar y pulsa “+ Nuevo brief” para publicar la primera."
      />
    )}

    <NextChapter current="dia" locale={locale} />
  </div>
</BaseLayout>

<style>
  .dia__grid{
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 720px){ .dia__grid{ grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px){ .dia__grid{ grid-template-columns: repeat(3, 1fr); } }

  .dia__cell{ min-width: 0; }
  .dia__card{
    display: flex; flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    overflow: hidden;
    background: color-mix(in srgb, var(--text) 2%, transparent);
    transition: border-color 600ms var(--ease-fluid), transform 600ms var(--ease-fluid);
  }
  .dia__card:hover{
    border-color: color-mix(in srgb, var(--text) 18%, transparent);
    transform: translateY(-2px);
    --img-scale: 1.045;
  }
  .dia__cover{ display: block; width: 100%; aspect-ratio: 4/5; position: relative; overflow: hidden; }
  .dia__draftPill{
    position: absolute;
    top: 8px; left: 8px;
    background: rgba(217, 66, 28, .9);
    color: #F4EFE6;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 999px;
    pointer-events: none;
  }
  .dia__card :global(img),
  .dia__noimg{
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
    background: rgba(244,239,230,.04);
  }
  .dia__body{ padding: 14px 16px 18px; }
  .dia__date{
    margin: 0 0 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .dia__line{
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.35;
    color: var(--text);
    max-width: 36ch;
  }
  .dia__place{
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
</style>

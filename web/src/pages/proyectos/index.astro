---
export const prerender = false;

import EmptyState from "../../components/content/EmptyState.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import NextChapter from "../../components/content/NextChapter.astro";
import { chapterMedia } from "../../lib/chapter-media";
import SmartImage from "../../components/content/SmartImage.astro";
import { getProjects } from "../../lib/queries";
import { getSupabaseServer } from "../../lib/supabase";
import { href, t2, ui } from "../../lib/i18n";
import type { Locale, Project, ProjectStatus } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";
const isAdmin = Astro.locals.isAdmin === true;

/* Admins see drafts (with a pill) on top of published projects. */
let projects: Project[] = [];
if (isAdmin) {
  const sb = getSupabaseServer(Astro.cookies);
  if (sb) {
    const { data } = await sb
      .from("projects")
      .select("id, slug, title, status, summary_es, summary_en, hero_image_url, hero_video_url, body_es, body_en, blocks, links, voice, framing, published, created_at, updated_at")
      .order("status", { ascending: true })
      .order("updated_at", { ascending: false });
    projects = (data ?? []) as Project[];
  }
} else {
  projects = await getProjects();
}

const headline = locale === "es" ? "Lugares donde está mi cocina." : "Places where my cooking lives.";
const lede = locale === "es"
  ? "Olivea en el valle. Fritanguita en la ciudad. Lo que vino antes y lo que sigue."
  : "Olivea in the valley. Fritanguita in the city. What came before and what comes next.";

function statusLabel(status: ProjectStatus | null): string {
  if (status === "primary") return ui("primaryProject", locale);
  if (status === "secondary") return ui("secondaryProject", locale);
  if (status === "past") return ui("pastProject", locale);
  return "";
}

function summaryFor(p: Project): string {
  return t2(p.summary_es, p.summary_en, locale);
}
---

<BaseLayout
  title={`${ui("projects", locale)} — Daniel Nates`}
  description={lede}
  locale={locale}
  createContext={{ entity: "project", label: "Nuevo proyecto" }}
>
  <div class="shell">
    <TopDock locale={locale} />

    <section class="section reveal">
      <p class="kicker">{ui("projects", locale)}</p>
      <h1 class="h1" style="margin-bottom:12px;">{headline}</h1>
      <p class="lede" style="margin-top: 14px;">{lede}</p>
    </section>

    {projects.length ? (
      <section class="section">
        <ol class="chapters">
          {projects.map((p, i) => {
            const poster = p.hero_image_url ?? chapterMedia(p.slug)?.poster ?? null;
            return (
              <li class="chapters__item reveal" data-side={i % 2 ? "right" : "left"}>
                <a class="chapters__row" href={href(`/${p.slug}`, locale)} data-status={p.status ?? "secondary"}>
                  <span
                    class="chapters__cover"
                    data-edit-image-field={`project.${p.slug}.hero_image_url`}
                    transition:name={`proj-${p.slug}`}
                  >
                    {poster ? (
                      <SmartImage src={poster} alt={p.title} widths={[800, 1200]} sizes="(min-width: 880px) 48vw, 100vw" />
                    ) : null}
                    {isAdmin && !p.published ? <span class="chapters__draft">Borrador</span> : null}
                  </span>
                  <span class="chapters__text">
                    <span class="chapters__num">{String(i + 1).padStart(2, "0")} · {statusLabel(p.status)}</span>
                    <span class="chapters__title" data-edit-field={`project.${p.slug}.title`} transition:name={`proj-title-${p.slug}`}>{p.title}</span>
                    <span class="chapters__summary" data-edit-field={`project.${p.slug}.summary_${locale}`}>{summaryFor(p) ?? ""}</span>
                    <span class="chapters__go">{locale === "es" ? "Abrir capítulo" : "Open chapter"} <span aria-hidden="true">→</span></span>
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ) : (
      <EmptyState
        line={locale === "es" ? "Los capítulos se están escribiendo." : "The chapters are being written."}
        adminHint="Activa Editar y pulsa “+ Nuevo proyecto”."
      />
    )}

    <NextChapter current="proyectos" locale={locale} />
  </div>
</BaseLayout>

<style>
  /* Chapters as spreads — a still and a monument title, alternating
     sides down the page. The still shares a view-transition name with
     the chapter hero, so it grows into the hero on click. */
  .chapters{
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(72px, 12vh, 160px);
  }
  .chapters__row{
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: end;
    gap: clamp(24px, 4vw, 72px);
    color: var(--text);
    text-decoration: none;
  }
  .chapters__item[data-side="right"] .chapters__row{ grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
  .chapters__item[data-side="right"] .chapters__cover{ order: 2; }

  .chapters__cover{
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  .chapters__cover :global(img){
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.05) brightness(.9);
    transition: transform 1400ms var(--ease-fluid), filter 1400ms var(--ease-fluid);
  }
  .chapters__row:hover .chapters__cover :global(img){ transform: scale(1.04); filter: contrast(1.08) brightness(1); }
  .chapters__draft{
    position: absolute;
    top: 12px; left: 12px;
    padding: 4px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ember) 88%, transparent);
    color: var(--bone);
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .chapters__text{ display: grid; gap: clamp(12px, 2vh, 20px); padding-bottom: 6px; }
  .chapters__num{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .26em;
    text-transform: uppercase;
    font-feature-settings: "tnum";
    color: var(--text-3);
  }
  .chapters__title{
    font-family: var(--font-display);
    font-size: clamp(56px, 8vw, 144px);
    line-height: .88;
    letter-spacing: -0.045em;
  }
  .chapters__summary{
    max-width: 38ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.4vw, 23px);
    line-height: 1.38;
    color: var(--text-2);
  }
  .chapters__summary:empty{ display: none; }
  .chapters__go{
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .chapters__go span{ display: inline-block; transition: transform 700ms var(--ease-fluid); }
  .chapters__row:hover .chapters__go span{ transform: translateX(6px); }

  @media (max-width: 880px){
    .chapters__row,
    .chapters__item[data-side="right"] .chapters__row{ grid-template-columns: 1fr; }
    .chapters__item[data-side="right"] .chapters__cover{ order: 0; }
  }
</style>

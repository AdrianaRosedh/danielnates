---
export const prerender = false;
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { getSupabaseServer } from "../../../lib/supabase";
import { txFor, type AdminLang } from "../../../lib/admin-i18n";

const supabase = getSupabaseServer(Astro.cookies);
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);

let rows: Array<{
  id: string;
  title: string;
  date: string;
  category: string | null;
  external_link: string | null;
  published: boolean;
}> = [];

if (supabase) {
  const { data } = await supabase
    .from("field_notes")
    .select("id, title, date, category, external_link, published")
    .order("date", { ascending: false })
    .limit(200);
  rows = (data ?? []) as typeof rows;
}

function fmt(d: string) {
  try { return new Date(d + "T00:00:00").toLocaleDateString(lang === "en" ? "en-US" : "es-ES", { day: "numeric", month: "short", year: "numeric" }); }
  catch { return d; }
}

const CATEGORY_LABEL: Record<string, string> = lang === "en"
  ? { ingredient: "Ingredient", territory: "Territory", technique: "Technique", influence: "Influence" }
  : { ingredient: "Ingrediente", territory: "Territorio", technique: "Técnica",  influence: "Influencia" };
---

<AdminLayout title="Field Notes · Admin" active="field_notes">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">{t("Contenido", "Content")}</p>
      <h1 class="admin__title">Field Notes</h1>
      <p class="admin__lede" style="margin-top: 8px; max-width: 60ch; color: var(--text-2); font-family: var(--font-display); font-size: 16px; line-height: 1.5;">
        {t(
          "Apuntes rápidos del cuaderno — ingredientes, territorios, técnicas, influencias.",
          "Quick notes from the sketchbook — ingredients, territories, techniques, influences."
        )}
      </p>
    </div>
    <a class="admin__btn admin__btn--primary" href="/admin/field-notes/new">+ {t("Nueva nota", "New note")}</a>
  </header>

  {rows.length ? (
    <section class="cardgrid" style="margin-top: 32px;">
      {rows.map((n) => (
        <a class="card" href={`/admin/field-notes/${n.id}`}>
          <div class="card__media card__media--placeholder" style="aspect-ratio: 16 / 9;">
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-style: italic; font-size: 36px; color: rgba(244,239,230,.22); letter-spacing: -0.01em; padding: 24px; text-align: center;">
              {n.category ? CATEGORY_LABEL[n.category] ?? n.category : t("Nota", "Note")}
            </div>
            <span class={`card__pill${n.published ? " card__pill--published" : ""}`}>
              {n.published ? t("Publicado", "Published") : t("Borrador", "Draft")}
            </span>
          </div>
          <div class="card__body">
            <p class="card__kicker">{fmt(n.date)}{n.external_link ? ` · ${t("enlace", "link")} ↗` : ""}</p>
            <h3 class="card__title">{n.title}</h3>
            <p class="card__foot">
              <span>{t("Editar", "Edit")}</span>
              <span aria-hidden="true">→</span>
            </p>
          </div>
        </a>
      ))}
      <a class="card card--add" href="/admin/field-notes/new">
        <span class="card--add__plus">+</span>
        <span class="card--add__label">{t("Nueva nota", "New note")}</span>
      </a>
    </section>
  ) : (
    <div class="empty" style="margin-top: 32px;">
      <span class="empty__mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 2 H13 V14 L10.5 12 L8 14 L5.5 12 L3 14 Z"/>
        </svg>
      </span>
      <h3 class="empty__title">{t("Aún no hay notas", "No notes yet")}</h3>
      <p class="empty__sub">{t(
        "Cada nota lleva título, fecha, una categoría (ingrediente, territorio, técnica, influencia) y cuerpo bilingüe.",
        "Each note has a title, date, a category (ingredient, territory, technique, influence) and bilingual body."
      )}</p>
      <a class="admin__btn admin__btn--primary" href="/admin/field-notes/new" style="margin-top: 8px;">+ {t("Crear la primera", "Create the first")}</a>
    </div>
  )}
</AdminLayout>

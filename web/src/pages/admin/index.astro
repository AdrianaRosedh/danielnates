---
export const prerender = false;
import AdminLayout from "../../components/admin/AdminLayout.astro";
import { getSupabaseFromRequest } from "../../lib/supabase";
import { txFor, type AdminLang } from "../../lib/admin-i18n";

const supabase = getSupabaseFromRequest(Astro.cookies);
const scope = Astro.locals.adminScope ?? "all";
const isFullAdmin = scope === "all";
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);

interface Tile {
  href: string;
  label: string;
  hint: string;
  count: number;
  cover?: string | null;
  /* For visually empty content types we use a typographic plate. */
  glyph?: string;
  scope: "all" | "scoped";
}

async function count(table: string): Promise<number> {
  if (!supabase) return 0;
  const { count } = await supabase.from(table).select("*", { count: "exact", head: true });
  return count ?? 0;
}

async function latestCover(table: string, col: string, extra?: { eq?: [string, string] }): Promise<string | null> {
  if (!supabase) return null;
  let q = supabase.from(table).select(`${col}`).not(col, "is", null).order("created_at", { ascending: false }).limit(1);
  if (extra?.eq) q = q.eq(extra.eq[0], extra.eq[1]);
  const { data } = await q.maybeSingle();
  return ((data as Record<string, unknown> | null)?.[col] as string | null) ?? null;
}

async function projectCount(): Promise<number> {
  if (!supabase) return 0;
  let q = supabase.from("projects").select("*", { count: "exact", head: true });
  if (!isFullAdmin) q = q.eq("slug", scope);
  const { count } = await q;
  return count ?? 0;
}
async function projectCover(): Promise<string | null> {
  if (!supabase) return null;
  let q = supabase.from("projects").select("hero_image_url").not("hero_image_url", "is", null).order("updated_at", { ascending: false }).limit(1);
  if (!isFullAdmin) q = q.eq("slug", scope);
  const { data } = await q.maybeSingle();
  return ((data as { hero_image_url: string | null } | null)?.hero_image_url) ?? null;
}

const tiles: Tile[] = isFullAdmin ? [
  { href: "/admin/daily",       label: t("Día · brief", "Day · brief"),     hint: t("Una imagen, una línea — hoy.", "One image, one line — today."),       count: await count("daily_briefs"),     cover: await latestCover("daily_briefs", "image_url"), scope: "all" },
  { href: "/admin/articles",    label: t("Artículos", "Articles"),          hint: t("Notas, ensayos, lecturas.", "Notes, essays, readings."),               count: await count("articles"),         cover: await latestCover("articles", "cover_url"),     scope: "all" },
  { href: "/admin/art",         label: t("Arte", "Art"),                    hint: t("Lo que la mano hace cuando no cocina.", "What the hand does when it isn't cooking."), count: await count("art_pieces"),       cover: await latestCover("art_pieces", "cover_url"),   scope: "all" },
  { href: "/admin/projects",    label: t("Proyectos", "Projects"),          hint: t("Olivea, Fritanguita, Maizal.", "Olivea, Fritanguita, Maizal."),         count: await projectCount(),            cover: await projectCover(),                            scope: "all" },
  { href: "/admin/field-notes", label: "Field Notes",                       hint: t("Apuntes rápidos del cuaderno.", "Quick notes from the sketchbook."),    count: await count("field_notes"),      glyph: "FN", scope: "all" },
  { href: "/admin/press",       label: t("Press menciones", "Press mentions"), hint: t("Lo que escriben sobre Daniel.", "What people write about Daniel."), count: await count("press_mentions"),   glyph: "PR", scope: "all" },
  { href: "/admin/messages",    label: t("Mensajes", "Messages"),           hint: t("Contacto recibido.", "Contact received."),                              count: await count("contact_messages"), glyph: "✉",  scope: "all" },
] : [
  { href: "/admin/projects",    label: t("Tu página", "Your page"),         hint: t(`Editar la página de ${scope}.`, `Edit the ${scope} page.`),            count: await projectCount(),            cover: await projectCover(),                            scope: "scoped" },
];

const headline = isFullAdmin
  ? t("Todo lo que aparece en danielnates.com vive aquí.", "Everything that appears on danielnates.com lives here.")
  : t(`Bienvenido. Tu acceso edita la página de ${scope}.`, `Welcome. Your access edits the ${scope} page.`);
---

<AdminLayout title="Admin · Dashboard" active="dashboard">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">{isFullAdmin ? "Daniel Nates" : t("Equipo", "Team")}</p>
      <h1 class="admin__title">Dashboard</h1>
      <p class="admin__lede" style="margin-top: 8px; max-width: 60ch; color: var(--text-2); font-family: var(--font-display); font-size: 16px; line-height: 1.5;">
        {headline}
      </p>
    </div>
    {isFullAdmin ? (
      <a class="admin__btn admin__btn--primary" href="/admin/daily/new">+ {t("Brief de hoy", "Today's brief")}</a>
    ) : null}
  </header>

  <section class="cardgrid" style="margin-top: 32px;">
    {tiles.map((tile) => (
      <a class="card" href={tile.href} aria-label={`${tile.label} — ${tile.count}`}>
        <div class={`card__media${tile.cover ? "" : " card__media--placeholder"}`}>
          {tile.cover ? (
            <img src={tile.cover} alt="" loading="lazy" />
          ) : (
            <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-size: 64px; color: rgba(244,239,230,.18); letter-spacing: -0.04em;">
              {tile.glyph ?? tile.label.charAt(0)}
            </div>
          )}
        </div>
        <div class="card__body">
          <p class="card__kicker">{tile.count} {lang === "es" ? (tile.count === 1 ? "elemento" : "elementos") : (tile.count === 1 ? "item" : "items")}</p>
          <h3 class="card__title">{tile.label}</h3>
          <p class="card__meta">{tile.hint}</p>
          <p class="card__foot">
            <span>{t("Abrir", "Open")}</span>
            <span aria-hidden="true">→</span>
          </p>
        </div>
      </a>
    ))}
  </section>
</AdminLayout>

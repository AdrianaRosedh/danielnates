---
export const prerender = false;
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { getSupabaseServer } from "../../../lib/supabase";
import { txFor, type AdminLang } from "../../../lib/admin-i18n";

const supabase = getSupabaseServer(Astro.cookies);
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);

let rows: Array<{
  id: string;
  slug: string;
  title: string;
  cover_url: string | null;
  year: number | null;
  medium: string | null;
  dimensions: string | null;
  published: boolean;
}> = [];

if (supabase) {
  const { data } = await supabase
    .from("art_pieces")
    .select("id, slug, title, cover_url, year, medium, dimensions, published")
    .order("year", { ascending: false, nullsFirst: false })
    .order("created_at", { ascending: false })
    .limit(200);
  rows = (data ?? []) as typeof rows;
}
---

<AdminLayout title={t("Arte · Admin", "Art · Admin")} active="art">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">{t("Contenido", "Content")}</p>
      <h1 class="admin__title">{t("Arte", "Art")}</h1>
      <p class="admin__lede" style="margin-top: 8px; max-width: 60ch; color: var(--text-2); font-family: var(--font-display); font-size: 16px; line-height: 1.5;">
        {t(
          "Lo que la mano hace cuando no está cocinando. Cada pieza tiene su propia página.",
          "What the hand does when it isn't cooking. Each piece has its own page."
        )}
      </p>
    </div>
    <a class="admin__btn admin__btn--primary" href="/admin/art/new">+ {t("Nueva pieza", "New piece")}</a>
  </header>

  {rows.length ? (
    <section class="cardgrid" style="margin-top: 32px;">
      {rows.map((p) => (
        <a class="card" href={`/admin/art/${p.id}`}>
          <div class={`card__media card__media--art${p.cover_url ? "" : " card__media--placeholder"}`}>
            {p.cover_url ? (
              <img src={p.cover_url} alt={p.title} loading="lazy" />
            ) : (
              <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-size: 80px; color: rgba(244,239,230,.18); letter-spacing: -0.04em;">
                {p.title.charAt(0)}
              </div>
            )}
            <span class={`card__pill${p.published ? " card__pill--published" : ""}`}>
              {p.published ? t("Publicado", "Published") : t("Borrador", "Draft")}
            </span>
          </div>
          <div class="card__body">
            <p class="card__kicker">{p.year ?? "—"}{p.medium ? ` · ${p.medium}` : ""}</p>
            <h3 class="card__title">{p.title}</h3>
            {p.dimensions ? <p class="card__meta">{p.dimensions}</p> : null}
            <p class="card__foot">
              <span>{t("Editar", "Edit")}</span>
              <span aria-hidden="true">→</span>
            </p>
          </div>
        </a>
      ))}
      <a class="card card--add" href="/admin/art/new">
        <span class="card--add__plus">+</span>
        <span class="card--add__label">{t("Nueva pieza", "New piece")}</span>
      </a>
    </section>
  ) : (
    <div class="empty" style="margin-top: 32px;">
      <span class="empty__mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="2.5" width="11" height="11" rx="1"/><line x1="2.5" y1="11" x2="13.5" y2="11"/><circle cx="5.5" cy="6" r="1"/>
        </svg>
      </span>
      <h3 class="empty__title">{t("Aún no hay piezas", "No pieces yet")}</h3>
      <p class="empty__sub">{t(
        "Cada pieza acepta una imagen, año, medio, dimensiones y un statement bilingüe. Crea la primera para empezar.",
        "Each piece takes an image, year, medium, dimensions and a bilingual statement. Create the first to begin."
      )}</p>
      <a class="admin__btn admin__btn--primary" href="/admin/art/new" style="margin-top: 8px;">+ {t("Crear la primera", "Create the first")}</a>
    </div>
  )}
</AdminLayout>

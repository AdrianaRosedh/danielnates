---
export const prerender = false;
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { getSupabaseServer } from "../../../lib/supabase";
import { txFor, type AdminLang } from "../../../lib/admin-i18n";

const supabase = getSupabaseServer(Astro.cookies);
const scope = Astro.locals.adminScope ?? "all";
const isFullAdmin = scope === "all";
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);

let rows: Array<{
  id: string;
  slug: string;
  title: string;
  status: string | null;
  hero_image_url: string | null;
  summary_es: string | null;
  summary_en: string | null;
  published: boolean;
  updated_at: string;
}> = [];

if (supabase) {
  let q = supabase
    .from("projects")
    .select("id, slug, title, status, hero_image_url, summary_es, summary_en, published, updated_at")
    .order("updated_at", { ascending: false })
    .limit(200);
  if (!isFullAdmin) q = q.eq("slug", scope);
  const { data } = await q;
  rows = (data ?? []) as typeof rows;
}

function statusLabel(s: string | null) {
  switch (s) {
    case "primary":   return t("Principal", "Primary");
    case "secondary": return t("Secundario", "Secondary");
    case "past":      return t("Pasado", "Past");
    default:          return "—";
  }
}
---

<AdminLayout title={t("Proyectos · Admin", "Projects · Admin")} active="projects">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">{isFullAdmin ? t("Contenido", "Content") : t("Tu página", "Your page")}</p>
      <h1 class="admin__title">{isFullAdmin ? t("Proyectos", "Projects") : t("Editar página", "Edit page")}</h1>
      {isFullAdmin ? (
        <p class="admin__lede" style="margin-top: 8px; max-width: 60ch; color: var(--text-2); font-family: var(--font-display); font-size: 16px; line-height: 1.5;">
          {t(
            "Cada proyecto se muestra como una página propia. Para editar el orden de los bloques, abrir cualquier tarjeta.",
            "Each project shows as its own page. To edit the block order, open any card."
          )}
        </p>
      ) : null}
    </div>
    {isFullAdmin ? (
      <a class="admin__btn admin__btn--primary" href="/admin/projects/new">+ {t("Nuevo proyecto", "New project")}</a>
    ) : null}
  </header>

  {rows.length ? (
    <section class="cardgrid" style="margin-top: 32px;">
      {rows.map((p) => (
        <a class="card" href={`/admin/projects/${p.id}`}>
          <div class={`card__media${p.hero_image_url ? "" : " card__media--placeholder"}`}>
            {p.hero_image_url ? (
              <img src={p.hero_image_url} alt={p.title} loading="lazy" />
            ) : (
              <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-size: 80px; color: rgba(244,239,230,.18); letter-spacing: -0.04em;">
                {p.title.charAt(0)}
              </div>
            )}
            <span class={`card__pill${p.published ? " card__pill--published" : ""}`}>
              {p.published ? t("Publicado", "Published") : t("Borrador", "Draft")}
            </span>
          </div>
          <div class="card__body">
            <p class="card__kicker">/{p.slug} · {statusLabel(p.status)}</p>
            <h3 class="card__title">{p.title}</h3>
            {(p.summary_es ?? p.summary_en) ? (
              <p class="card__meta">{lang === "en" ? (p.summary_en ?? p.summary_es) : (p.summary_es ?? p.summary_en)}</p>
            ) : null}
            <p class="card__foot">
              <span>{t("Editar", "Edit")}</span>
              <span>{new Date(p.updated_at).toLocaleDateString(lang === "en" ? "en-US" : "es-ES", { day: "numeric", month: "short" })}</span>
            </p>
          </div>
        </a>
      ))}
      {isFullAdmin ? (
        <a class="card card--add" href="/admin/projects/new">
          <span class="card--add__plus">+</span>
          <span class="card--add__label">{t("Nuevo proyecto", "New project")}</span>
        </a>
      ) : null}
    </section>
  ) : (
    <div class="empty" style="margin-top: 32px;">
      <span class="empty__mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="3" width="11" height="3" rx="0.5"/><rect x="2.5" y="7" width="11" height="3" rx="0.5"/><rect x="2.5" y="11" width="11" height="2.5" rx="0.5"/>
        </svg>
      </span>
      <h3 class="empty__title">{isFullAdmin ? t("Aún no hay proyectos", "No projects yet") : t("Tu proyecto aún no existe", "Your project doesn't exist yet")}</h3>
      <p class="empty__sub">
        {isFullAdmin
          ? t(
              "Olivea, Fritanguita y Maizal vienen sembrados — si no los ves, revisa que la migración se haya aplicado a este Supabase.",
              "Olivea, Fritanguita and Maizal are seeded — if you don't see them, verify the migration was applied to this Supabase."
            )
          : t(`Pídele a un admin con acceso completo que cree el proyecto "${scope}".`, `Ask a full admin to create the "${scope}" project.`)}
      </p>
      {isFullAdmin ? (
        <a class="admin__btn admin__btn--primary" href="/admin/projects/new" style="margin-top: 8px;">+ {t("Crear el primero", "Create the first")}</a>
      ) : null}
    </div>
  )}
</AdminLayout>

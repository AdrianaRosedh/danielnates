---
export const prerender = false;
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { getSupabaseServer } from "../../../lib/supabase";

const supabase = getSupabaseServer(Astro.cookies);
const scope = Astro.locals.adminScope ?? "all";
const isFullAdmin = scope === "all";

let rows: Array<{
  id: string;
  slug: string;
  title: string;
  status: string | null;
  hero_image_url: string | null;
  published: boolean;
  updated_at: string;
}> = [];

if (supabase) {
  let q = supabase
    .from("projects")
    .select("id, slug, title, status, hero_image_url, published, updated_at")
    .order("updated_at", { ascending: false })
    .limit(200);
  // Scoped users (e.g. Fritanguita team) only see their project.
  if (!isFullAdmin) q = q.eq("slug", scope);
  const { data } = await q;
  rows = (data ?? []) as typeof rows;
}

function statusLabel(s: string | null) {
  switch (s) {
    case "primary": return "Principal";
    case "secondary": return "Secundario";
    case "past": return "Pasado";
    default: return "—";
  }
}
---

<AdminLayout title="Proyectos · Admin" active="projects">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">Contenido</p>
      <h1 class="admin__title">Proyectos</h1>
    </div>
    {isFullAdmin ? (
      <a class="admin__btn admin__btn--primary" href="/admin/projects/new">+ Nuevo proyecto</a>
    ) : null}
  </header>

  {rows.length ? (
    <div class="admin__list">
      {rows.map((p) => (
        <a class="admin__row" href={`/admin/projects/${p.id}`}>
          {p.hero_image_url ? (
            <img src={p.hero_image_url} alt="" />
          ) : (
            <div style="width: 64px; height: 80px; background: rgba(244,239,230,.04); border-radius: 6px;"></div>
          )}
          <div class="admin__rowMain">
            <h3>{p.title}</h3>
            <p>/{p.slug} · {statusLabel(p.status)}</p>
          </div>
          <span class={`admin__pill${p.published ? " admin__pill--published" : ""}`}>
            {p.published ? "Publicado" : "Borrador"}
          </span>
          <span class="admin__rowMeta">{new Date(p.updated_at).toLocaleDateString("es-ES", { day: "numeric", month: "short" })}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="admin__list" style="padding: 40px; text-align: center;">
      <p style="margin: 0; color: var(--text-2);">
        {isFullAdmin ? "Aún no hay proyectos." : `Tu proyecto (${scope}) aún no existe — pídele a un admin que lo cree.`}
      </p>
      {isFullAdmin ? (
        <a class="admin__btn admin__btn--primary" href="/admin/projects/new" style="margin-top: 16px;">Crear el primero</a>
      ) : null}
    </div>
  )}
</AdminLayout>

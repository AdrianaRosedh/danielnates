---
export const prerender = false;
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { getSupabaseServer } from "../../../lib/supabase";
import { txFor, type AdminLang } from "../../../lib/admin-i18n";

const supabase = getSupabaseServer(Astro.cookies);
const lang: AdminLang = Astro.locals.adminLang ?? "es";
const t = txFor(lang);

let rows: Array<{
  id: string;
  slug: string;
  title: string;
  date: string;
  cover_url: string | null;
  excerpt_es: string | null;
  excerpt_en: string | null;
  published: boolean;
}> = [];

if (supabase) {
  const { data } = await supabase
    .from("articles")
    .select("id, slug, title, date, cover_url, excerpt_es, excerpt_en, published")
    .order("date", { ascending: false })
    .limit(200);
  rows = (data ?? []) as typeof rows;
}

function fmt(d: string) {
  try {
    return new Date(d + "T00:00:00").toLocaleDateString(lang === "en" ? "en-US" : "es-ES", {
      day: "numeric", month: "short", year: "numeric",
    });
  } catch { return d; }
}
---

<AdminLayout title={t("Diario · Admin", "Journal · Admin")} active="articles">
  <header class="admin__head">
    <div>
      <p class="admin__crumb">{t("Contenido", "Content")}</p>
      <h1 class="admin__title">{t("Diario", "Journal")}</h1>
      <p class="admin__lede" style="margin-top: 8px; max-width: 60ch; color: var(--text-2); font-family: var(--font-display); font-size: 16px; line-height: 1.5;">
        {t(
          "Notas, ensayos, lecturas. Publicado aparece en /diario.",
          "Notes, essays, readings. Published items appear at /diario."
        )}
      </p>
    </div>
    <a class="admin__btn admin__btn--primary" href="/admin/articles/new">+ {t("Nueva entrada", "New entry")}</a>
  </header>

  {rows.length ? (
    <section class="cardgrid" style="margin-top: 32px;">
      {rows.map((a) => (
        <a class="card" href={`/admin/articles/${a.id}`}>
          <div class={`card__media${a.cover_url ? "" : " card__media--placeholder"}`}>
            {a.cover_url ? (
              <img src={a.cover_url} alt={a.title} loading="lazy" />
            ) : (
              <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family: var(--font-display); font-style: italic; font-size: 56px; color: rgba(244,239,230,.18); letter-spacing: -0.02em;">
                {a.title.charAt(0)}
              </div>
            )}
            <span class={`card__pill${a.published ? " card__pill--published" : ""}`}>
              {a.published ? t("Publicado", "Published") : t("Borrador", "Draft")}
            </span>
          </div>
          <div class="card__body">
            <p class="card__kicker">{fmt(a.date)}</p>
            <h3 class="card__title">{a.title}</h3>
            {(a.excerpt_es ?? a.excerpt_en) ? (
              <p class="card__meta">{lang === "en" ? (a.excerpt_en ?? a.excerpt_es) : (a.excerpt_es ?? a.excerpt_en)}</p>
            ) : null}
            <p class="card__foot">
              <span>{t("Editar", "Edit")}</span>
              <span aria-hidden="true">→</span>
            </p>
          </div>
        </a>
      ))}
      <a class="card card--add" href="/admin/articles/new">
        <span class="card--add__plus">+</span>
        <span class="card--add__label">{t("Nueva entrada", "New entry")}</span>
      </a>
    </section>
  ) : (
    <div class="empty" style="margin-top: 32px;">
      <span class="empty__mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 2 H10 L13 5 V14 H3 Z"/><line x1="5" y1="6" x2="11" y2="6"/><line x1="5" y1="9" x2="11" y2="9"/><line x1="5" y1="12" x2="9" y2="12"/>
        </svg>
      </span>
      <h3 class="empty__title">{t("Aún no hay entradas", "No entries yet")}</h3>
      <p class="empty__sub">{t(
        "Cada entrada acepta título, fecha, portada, extracto bilingüe y cuerpo. Crea la primera.",
        "Each entry takes a title, date, cover, bilingual excerpt and body. Create the first."
      )}</p>
      <a class="admin__btn admin__btn--primary" href="/admin/articles/new" style="margin-top: 8px;">+ {t("Crear la primera", "Create the first")}</a>
    </div>
  )}
</AdminLayout>

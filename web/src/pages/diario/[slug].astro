---
export const prerender = false;

import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import PortableText from "../../components/content/PortableText.astro";
import BlockRenderer from "../../components/blocks/BlockRenderer.astro";

import { getArticle } from "../../lib/queries";
import { dateFormat, href, t2, tb2, ui } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const { slug } = Astro.params as { slug: string };
const article = await getArticle(slug);
if (!article) return Astro.redirect(href("/404", locale));

const title = article.title;
const excerpt = t2(article.excerpt_es, article.excerpt_en, locale);
const body = tb2(article.body_es, article.body_en, locale);

/* Inline-edit field paths. The bodyText is what the popover modal
 * pre-populates the textarea with — converted from PortableText
 * blocks to plain text (paragraphs separated by blank lines). On
 * save, the endpoint converts back to blocks via textToBlocks(). */
const titleField   = `article.${slug}.title`;
const excerptField = `article.${slug}.excerpt_${locale}`;
const bodyField    = `article.${slug}.body_${locale}`;
const bodyText = body.length
  ? body
      .map((b) => {
        const block = b as { _type?: string; children?: { text?: string }[] };
        if (block?._type !== "block" || !Array.isArray(block.children)) return "";
        return block.children.map((c) => c?.text ?? "").join("");
      })
      .filter(Boolean)
      .join("\n\n")
  : "";
---

<BaseLayout
  title={`${title} — ${ui("diary", locale)}`}
  description={excerpt}
  locale={locale}
  editContext={{
    entity: "article",
    id: slug,
    published: !!article.published,
    indexHref: "/admin/articles",
  }}
>
  <div class="shell">
    <TopDock locale={locale} />

    <article class="articleHeader reveal">
      <p class="kicker">{ui("diary", locale)} · {dateFormat(article.date, locale)}</p>
      <h1 class="h1" data-edit-field={titleField}>{title}</h1>
      {excerpt ? <p class="sub" style="margin-top:14px;" data-edit-field={excerptField}>{excerpt}</p> : null}
      <div class="articleHeader__coverWrap" data-edit-image-field={`article.${slug}.cover_url`}>
        {article.cover_url ? <img class="articleHeader__cover" src={article.cover_url} alt={title} /> : null}
      </div>
    </article>

    {body.length ? (
      <div data-edit-field={bodyField} data-edit-multi="1" data-edit-source={bodyText}>
        <PortableText value={body} />
      </div>
    ) : (
      <div data-edit-field={bodyField} data-edit-multi="1" data-edit-source="" />
    )}
    {article.blocks?.length ? <BlockRenderer blocks={article.blocks} locale={locale} /> : null}
  </div>
</BaseLayout>

<style>
  .articleHeader{ margin: 14px 0 18px; }
  .articleHeader__coverWrap{ display: block; margin-top: 22px; }
  .articleHeader__cover{ width: 100%; height: auto; border-radius: var(--r-3); display: block; }
</style>

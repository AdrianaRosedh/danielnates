---
import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import BlockRenderer from "../../components/blocks/BlockRenderer.astro";

import { clientFor, getArticle } from "../../lib/queries";
import { img } from "../../lib/image";
import { dateFormat, href, t, ui } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const { slug } = Astro.params as { slug: string };
const client = clientFor(Astro.cookies);
const article = await getArticle(slug, client);

if (!article) return Astro.redirect(href("/404", locale));

const title = article.title ?? slug;
const excerpt = t(article.excerpt, locale);
const cover = img(article.cover, { width: 2000 });
---

<BaseLayout title={`${title} — ${ui("diary", locale)}`} description={excerpt} locale={locale}>
  <div class="shell">
    <TopDock locale={locale} />

    <article class="articleHeader reveal">
      <p class="kicker">{ui("diary", locale)} · {dateFormat(article.date, locale)}</p>
      <h1 class="h1">{title}</h1>
      {excerpt ? <p class="sub" style="margin-top:14px;">{excerpt}</p> : null}
      {cover ? <img class="articleHeader__cover" src={cover} alt={title} /> : null}
    </article>

    <BlockRenderer blocks={article.blocks} locale={locale} />
  </div>

</BaseLayout>

<style>
  .articleHeader{ margin: 14px 0 18px; }
  .articleHeader__cover{ width: 100%; height: auto; border-radius: var(--radius); margin-top: 22px; display: block; }
</style>

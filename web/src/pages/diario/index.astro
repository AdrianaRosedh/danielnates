---
export const prerender = false;

import EmptyState from "../../components/content/EmptyState.astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import SmartImage from "../../components/content/SmartImage.astro";
import NextChapter from "../../components/content/NextChapter.astro";
import { getSupabase, getSupabaseServer } from "../../lib/supabase";
import { dateFormat, href, ui } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";
const isAdmin = Astro.locals.isAdmin === true;

interface Article {
  id: string;
  slug: string;
  title: string;
  date: string;
  cover_url: string | null;
  excerpt_es: string | null;
  excerpt_en: string | null;
  published: boolean;
}

/* When the visitor is an admin, fetch every article (including drafts)
 * via the authenticated server client so the list page doubles as a
 * draft inbox. Public visitors hit the anon client and only see
 * published rows. */
const supabase = isAdmin ? getSupabaseServer(Astro.cookies) : getSupabase();
let articles: Article[] = [];
if (supabase) {
  let q = supabase
    .from("articles")
    .select("id, slug, title, date, cover_url, excerpt_es, excerpt_en, published")
    .order("date", { ascending: false })
    .limit(120);
  if (!isAdmin) q = q.eq("published", true);
  const { data } = await q;
  articles = (data ?? []) as Article[];
}

const headline = locale === "es" ? "Lo que voy escribiendo." : "What I keep writing.";
const lede = locale === "es"
  ? "Notas desde la cocina y el cuaderno. Ingredientes, ideas, lecturas."
  : "Notes from the kitchen and the sketchbook. Ingredients, ideas, readings.";

const localizedExcerpt = (a: Article) =>
  locale === "es" ? (a.excerpt_es ?? a.excerpt_en ?? "") : (a.excerpt_en ?? a.excerpt_es ?? "");
---

<BaseLayout
  title={`${ui("diary", locale)} — Daniel Nates`}
  description={lede}
  locale={locale}
  createContext={{ entity: "article", label: "Nueva entrada" }}
>
  <div class="shell">
    <TopDock locale={locale} />

    <section class="section reveal">
      <p class="kicker">{ui("diary", locale)}</p>
      <h1 class="h1" style="margin-bottom:12px;">{headline}</h1>
      <p class="lede" style="margin-top: 14px;">{lede}</p>
    </section>

    {articles.length ? (
      <section class="section">
        <ol class="toc reveal-stagger">
          {articles.map((a, i) => (
            <li class="toc__item">
              <a class="toc__row" href={href(`/diario/${a.slug}`, locale)}>
                <span class="toc__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="toc__main">
                  <span class="toc__date">
                    {dateFormat(a.date, locale)}
                    {isAdmin && !a.published ? <span class="toc__draft">Borrador</span> : null}
                  </span>
                  <span class="toc__title" data-edit-field={`article.${a.slug}.title`}>{a.title}</span>
                  <span class="toc__excerpt" data-edit-field={`article.${a.slug}.excerpt_${locale}`}>{localizedExcerpt(a) ?? ""}</span>
                </span>
                {a.cover_url || isAdmin ? (
                  <span
                    class:list={["toc__cover", { "toc__cover--empty": !a.cover_url }]}
                    data-edit-image-field={`article.${a.slug}.cover_url`}
                  >
                    {a.cover_url ? (
                      <SmartImage src={a.cover_url} alt="" widths={[480, 800]} sizes="(min-width: 880px) 240px, 40vw" />
                    ) : null}
                  </span>
                ) : null}
                <span class="toc__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <EmptyState
        line={locale === "es" ? "El cuaderno está abierto. Pronto, la primera página." : "The notebook is open. The first page, soon."}
        adminHint="Activa Editar y pulsa “+ Nueva entrada”."
      />
    )}

    <NextChapter current="diario" locale={locale} />
  </div>
</BaseLayout>

<style>
  /* The journal as a table of contents — numbered rows on hairlines,
     the titles carry the page. Covers only when there is one. */
  .toc{
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .toc__item{ border-bottom: 1px solid var(--line); }
  .toc__row{
    display: grid;
    grid-template-columns: clamp(40px, 6vw, 96px) minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(26px, 4vh, 44px) 0;
    color: var(--text);
    text-decoration: none;
  }
  .toc__num{
    align-self: start;
    padding-top: .5em;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .2em;
    font-feature-settings: "tnum";
    color: var(--text-3);
  }
  .toc__main{ display: grid; gap: 10px; min-width: 0; }
  .toc__date{
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .toc__draft{
    font-size: 9px;
    letter-spacing: .16em;
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ember) 85%, transparent);
    color: var(--bone);
  }
  .toc__title{
    font-family: var(--font-display);
    font-size: clamp(32px, 4.4vw, 72px);
    line-height: .98;
    letter-spacing: -0.03em;
    text-wrap: balance;
    transition: transform 700ms var(--ease-fluid);
  }
  .toc__excerpt{
    max-width: 52ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.4;
    color: var(--text-2);
  }
  .toc__excerpt:empty{ display: none; }
  .toc__cover{
    display: block;
    width: clamp(120px, 16vw, 240px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
  }
  .toc__cover :global(img){
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1200ms var(--ease-fluid);
  }
  /* Empty slot exists only so Daniel can drop a cover in edit mode. */
  .toc__cover--empty{ display: none; }
  :global(html[data-edit-mode="1"]) .toc__cover--empty{
    display: block;
    border: 1px dashed var(--line-2);
  }
  .toc__go{
    font-size: 20px;
    color: var(--text-3);
    transition: transform 700ms var(--ease-fluid), color 700ms var(--ease-fluid);
  }
  .toc__row:hover .toc__title{ transform: translateX(clamp(6px, 1vw, 14px)); }
  .toc__row:hover .toc__go{ transform: translateX(6px); color: var(--text); }
  .toc__row:hover .toc__cover :global(img){ transform: scale(1.05); }

  @media (max-width: 720px){
    .toc__row{ grid-template-columns: minmax(0, 1fr) auto; }
    .toc__num, .toc__go{ display: none; }
    .toc__cover{ width: 92px; }
  }
</style>

---
export const prerender = false;

import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import { getSupabase, getSupabaseServer } from "../../lib/supabase";
import { dateFormat, href, ui } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";
const isAdmin = Astro.locals.isAdmin === true;

interface Article {
  id: string;
  slug: string;
  title: string;
  date: string;
  cover_url: string | null;
  excerpt_es: string | null;
  excerpt_en: string | null;
  published: boolean;
}

/* When the visitor is an admin, fetch every article (including drafts)
 * via the authenticated server client so the list page doubles as a
 * draft inbox. Public visitors hit the anon client and only see
 * published rows. */
const supabase = isAdmin ? getSupabaseServer(Astro.cookies) : getSupabase();
let articles: Article[] = [];
if (supabase) {
  let q = supabase
    .from("articles")
    .select("id, slug, title, date, cover_url, excerpt_es, excerpt_en, published")
    .order("date", { ascending: false })
    .limit(120);
  if (!isAdmin) q = q.eq("published", true);
  const { data } = await q;
  articles = (data ?? []) as Article[];
}

const headline = locale === "es" ? "Lo que voy escribiendo." : "What I keep writing.";
const lede = locale === "es"
  ? "Notas desde la cocina y el cuaderno. Ingredientes, ideas, lecturas."
  : "Notes from the kitchen and the sketchbook. Ingredients, ideas, readings.";

const localizedExcerpt = (a: Article) =>
  locale === "es" ? (a.excerpt_es ?? a.excerpt_en ?? "") : (a.excerpt_en ?? a.excerpt_es ?? "");
---

<BaseLayout
  title={`${ui("diary", locale)} — Daniel Nates`}
  description={lede}
  locale={locale}
  createContext={{ entity: "article", label: "Nueva entrada" }}
>
  <div class="shell">
    <TopDock locale={locale} />

    <section class="section reveal">
      <p class="kicker">{ui("diary", locale)}</p>
      <h1 class="h1" style="margin-bottom:12px;">{headline}</h1>
      <p class="lede" style="margin-top: 14px;">{lede}</p>
    </section>

    {articles.length ? (
      <section class="section">
        <div class="articleList reveal-stagger">
          {articles.map((a) => (
            <a class="articleRow" href={href(`/diario/${a.slug}`, locale)}>
              <div class="articleRow__cover" data-edit-image-field={`article.${a.slug}.cover_url`}>
                {a.cover_url ? (
                  <img src={a.cover_url} alt={a.title} loading="lazy" />
                ) : (
                  <div class="articleRow__noimg" aria-hidden="true"></div>
                )}
                {isAdmin && !a.published ? (
                  <span class="articleRow__draftPill" aria-label="Borrador">Borrador</span>
                ) : null}
              </div>
              <div class="articleRow__body">
                <p class="articleRow__date">{dateFormat(a.date, locale)}</p>
                <h3 class="articleRow__title" data-edit-field={`article.${a.slug}.title`}>{a.title}</h3>
                {localizedExcerpt(a) ? (
                  <p class="articleRow__excerpt" data-edit-field={`article.${a.slug}.excerpt_${locale}`}>{localizedExcerpt(a)}</p>
                ) : (
                  <p class="articleRow__excerpt" data-edit-field={`article.${a.slug}.excerpt_${locale}`}></p>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="section reveal">
        <p class="sub">{ui("noEntries", locale)}</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .articleList{ display: grid; gap: 14px; }
  .articleRow{
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    padding: 12px;
    border-radius: var(--r-2);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--text) 2%, transparent);
    transition: border-color 600ms var(--ease-fluid), background 600ms var(--ease-fluid), transform 600ms var(--ease-fluid);
  }
  .articleRow:hover{
    border-color: var(--line-2);
    background: color-mix(in srgb, var(--text) 5%, transparent);
    transform: translateY(-1px);
  }
  .articleRow__cover{ width: 96px; height: 96px; position: relative; }
  .articleRow__draftPill{
    position: absolute;
    top: 6px; left: 6px;
    background: rgba(217, 66, 28, .9);
    color: #F4EFE6;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 999px;
    pointer-events: none;
  }
  .articleRow img{ width: 96px; height: 96px; object-fit: cover; border-radius: 12px; display: block; }
  .articleRow__noimg{ width: 96px; height: 96px; border-radius: 12px; background: rgba(244,239,230,.04); }
  .articleRow__body{ min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .articleRow__date{ margin: 0; font-size: 11px; color: var(--text-3); letter-spacing: .12em; text-transform: uppercase; }
  .articleRow__title{ margin: 2px 0 0; font-size: 17px; letter-spacing: -0.01em; font-family: var(--font-display); }
  .articleRow__excerpt{ margin: 4px 0 0; font-size: 13px; color: var(--text-2); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 880px){
    .articleRow{ grid-template-columns: 140px 1fr; padding: 14px; }
    .articleRow__cover, .articleRow img, .articleRow__noimg{ width: 140px; height: 140px; }
  }
</style>

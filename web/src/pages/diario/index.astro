---
export const prerender = true;

import BaseLayout from "../../components/layout/BaseLayout.astro";
import TopDock from "../../components/layout/TopDock.astro";
import { getArticles } from "../../lib/queries";
import { img } from "../../lib/image";
import { dateFormat, href, t, ui } from "../../lib/i18n";
import type { Locale } from "../../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const articles = (await getArticles()) ?? [];
const headline = locale === "es"
  ? "Lo que voy escribiendo."
  : "What I keep writing.";
const lede = locale === "es"
  ? "Notas desde la cocina y el cuaderno. Ingredientes, ideas, lecturas."
  : "Notes from the kitchen and the sketchbook. Ingredients, ideas, readings.";
---

<BaseLayout
  title={`${ui("diary", locale)} — Daniel Nates`}
  description={lede}
  locale={locale}
>
  <div class="shell">
    <TopDock locale={locale} />

    <section class="section reveal">
      <p class="kicker">{ui("diary", locale)}</p>
      <h1 class="h1" style="margin-bottom:12px;">{headline}</h1>
      <p class="lede" style="margin-top: 14px;">{lede}</p>
    </section>

    {articles.length ? (
      <section class="section">
        <div class="articleList reveal-stagger">
          {articles.map((a) => {
            const cover = img(a.cover, { width: 800 });
            return (
              <a class="articleRow" href={href(`/diario/${a.slug?.current}`, locale)}>
                {cover ? <img src={cover} alt={a.title ?? ""} loading="lazy" /> : <div class="articleRow__noimg" aria-hidden="true"></div>}
                <div class="articleRow__body">
                  <p class="articleRow__date">{dateFormat(a.date, locale)}</p>
                  <h3 class="articleRow__title">{a.title ?? "Sin título"}</h3>
                  {t(a.excerpt, locale) ? <p class="articleRow__excerpt">{t(a.excerpt, locale)}</p> : null}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ) : (
      <section class="section reveal">
        <p class="sub">{ui("noEntries", locale)}</p>
      </section>
    )}
  </div>

</BaseLayout>

<style>
  .articleList{ display: grid; gap: 14px; }
  .articleRow{
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    padding: 12px;
    border-radius: var(--radius2);
    border: 1px solid rgba(255,255,255,.10);
    background: rgba(255,255,255,.02);
    transition: border-color .2s, background .2s, transform .2s;
  }
  .articleRow:hover{
    border-color: color-mix(in srgb, var(--brand-primary) 45%, rgba(255,255,255,.14));
    background: rgba(255,255,255,.04);
    transform: translateY(-1px);
  }
  .articleRow img{ width: 96px; height: 96px; object-fit: cover; border-radius: 12px; display: block; }
  .articleRow__noimg{ width: 96px; height: 96px; border-radius: 12px; background: rgba(255,255,255,.04); }
  .articleRow__body{ min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .articleRow__date{ margin: 0; font-size: 11px; color: var(--muted2); letter-spacing: .12em; text-transform: uppercase; }
  .articleRow__title{ margin: 2px 0 0; font-size: 17px; letter-spacing: -0.01em; }
  .articleRow__excerpt{ margin: 4px 0 0; font-size: 13px; color: var(--muted); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (min-width: 880px){
    .articleRow{ grid-template-columns: 140px 1fr; padding: 14px; }
    .articleRow img, .articleRow__noimg{ width: 140px; height: 140px; }
  }
</style>

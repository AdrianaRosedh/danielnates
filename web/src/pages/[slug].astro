---
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import HeroFilm from "../components/sections/HeroFilm.astro";
import PortableText from "../components/content/PortableText.astro";
import BlockRenderer from "../components/blocks/BlockRenderer.astro";

import NextChapter from "../components/content/NextChapter.astro";
import { chapterMedia } from "../lib/chapter-media";
import { resolveProjectPage } from "../lib/page-resolvers";
import { t2, tb2, ui } from "../lib/i18n";
import type { Locale } from "../lib/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const page = await resolveProjectPage(Astro, locale);
if ("notFound" in page) return page.notFound;
const { project } = page;
const slug = project.slug;

const title = project.title;
const summary = t2(project.summary_es, project.summary_en, locale);
const brand = slug;

// Fallback footage when Supabase has none (see lib/chapter-media).
const fallbackMedia = chapterMedia(slug);
const hasOwnMedia = !!(project.hero_video_url || project.hero_image_url);
const heroVideo = hasOwnMedia ? project.hero_video_url : null;
const heroVideoSources = hasOwnMedia ? null : (fallbackMedia?.sources ?? null);
const heroPoster = hasOwnMedia ? project.hero_image_url : (fallbackMedia?.poster ?? null);
const hasBlocks = (project.blocks?.length ?? 0) > 0;
const legacy = tb2(project.body_es, project.body_en, locale);

/* The legacy body is PortableText, edited in place with the rich
 * toolbar — formatting and links survive the round-trip. */
const legacyBodyField = `project.${slug}.body_${locale}`;
const hasLegacyBody = legacy.length > 0;

type ProjectFramingView = { kicker: string; intro: string; meta?: string };

/* Prefer DB framing (admin-editable), then fall back to the legacy
 * hardcoded dict for the original three projects. The migration in
 * supabase/migrations/20260503_projects_framing.sql backfills these
 * three rows; this fallback is belt-and-suspenders for fresh DBs. */
const fallbackFramings: Record<string, Record<Locale, ProjectFramingView>> = {
  olivea: {
    es: { kicker: "Capítulo 01 · Lo lento", intro: "Aquí cocino con lo que el huerto deja esa mañana. Valle de Guadalupe.", meta: "Estrella Michelin · Estrella Verde Michelin" },
    en: { kicker: "Chapter 01 · The slow", intro: "Here I cook with what the garden leaves that morning. Valle de Guadalupe.", meta: "Michelin Star · Michelin Green Star" },
  },
  fritanguita: {
    es: { kicker: "Capítulo 02 · Lo rápido", intro: "Cuando bajo a la ciudad. Fritanga poblana en Roma Norte, con Santiago Muñoz.", meta: "Calle Puebla 236 · Roma Norte · CDMX" },
    en: { kicker: "Chapter 02 · The fast", intro: "When I come down to the city. Poblano fritanga in Roma Norte, with Santiago Muñoz.", meta: "Calle Puebla 236 · Roma Norte · Mexico City" },
  },
  maizal: {
    es: { kicker: "Capítulo 03 · El primer maestro", intro: "Ocho años en La Casona de los Sapos. Lo que aprendí ahí todavía cocina lo que hago.", meta: "Puebla · 2017–2024 · Cerrado" },
    en: { kicker: "Chapter 03 · The first teacher", intro: "Eight years at La Casona de los Sapos. What I learned there still cooks what I do.", meta: "Puebla · 2017–2024 · Closed" },
  },
};

const f = project.framing;
let framing: ProjectFramingView | null = null;
if (f) {
  const kicker = (locale === "es" ? f.kicker_es : f.kicker_en) ?? "";
  const intro  = (locale === "es" ? f.intro_es  : f.intro_en)  ?? "";
  const meta   = (locale === "es" ? f.meta_es   : f.meta_en)   ?? "";
  if (kicker || intro || meta) framing = { kicker, intro, meta: meta || undefined };
}
if (!framing) framing = fallbackFramings[brand]?.[locale] ?? null;
---

<BaseLayout
  title={`${title} — Daniel Nates`}
  description={summary}
  locale={locale}
  editContext={{
    entity: "project",
    id: slug,
    published: !!project.published,
    indexHref: "/admin/projects",
  }}
  og={{
    title,
    kicker: framing?.kicker ?? title,
    sig: summary,
    brand: (brand as "olivea" | "fritanguita" | "maizal" | undefined) ?? "daniel",
    meta: framing?.meta ?? "Daniel Nates",
  }}
>
  <div class="shell" data-brand={brand}>
    <TopDock locale={locale} />

    {!hasBlocks ? (
      <HeroFilm
        title={title}
        sub={summary}
        kicker={framing?.kicker ?? null}
        meta={framing?.meta ?? null}
        videoUrl={heroVideo}
        videoSources={heroVideoSources}
        posterUrl={heroPoster}
        portraitX={hasOwnMedia ? null : (fallbackMedia?.portraitX ?? null)}
        transitionKey={brand}
        locale={locale}
        titleField={`project.${brand}.title`}
        subField={`project.${brand}.${locale === "es" ? "summary_es" : "summary_en"}`}
        kickerField={`project.${brand}.${locale === "es" ? "kicker_es" : "kicker_en"}`}
        metaField={`project.${brand}.${locale === "es" ? "meta_es" : "meta_en"}`}
        imageField={`project.${brand}.hero_image_url`}
      />
    ) : null}

    {hasBlocks ? <BlockRenderer blocks={project.blocks!} locale={locale} /> : null}

    {/* The chapter, read on paper — the hero is film, this is the page. */}
    {!hasBlocks && (framing?.intro || hasLegacyBody || project.links?.length) ? (
      <section class="chBody ui-bleed scene--bone" data-scene="bone">
        <div class="chBody__grid">
          <aside class="chBody__side">
            <div class="chBody__sticky">
              <p class="chBody__label ui-label">{ui("chapter", locale)}</p>
              <p class="chBody__name">{title}</p>
              {project.links?.length ? (
                <ul class="chBody__links reveal-stagger">
                  {project.links.map((l) => (
                    <li><a href={l.href} target="_blank" rel="noreferrer">{l.label} <span aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              ) : null}
            </div>
          </aside>

          <div class="chBody__main">
            {framing?.intro ? (
              <p
                class="chBody__lede reveal"
                data-edit-field={`project.${brand}.${locale === "es" ? "intro_es" : "intro_en"}`}
              >{framing.intro}</p>
            ) : null}

            {hasLegacyBody ? (
              <div
                class="chBody__prose"
                data-edit-field={legacyBodyField}
                data-edit-portable="1"
                data-reveal-body
              >
                <PortableText value={legacy} lead />
              </div>
            ) : null}
          </div>
        </div>
      </section>
    ) : null}

    <NextChapter current="proyectos" locale={locale} />
  </div>
</BaseLayout>

<style>
  .chBody{
    background: var(--bg);
    color: var(--text);
    padding: clamp(96px, 14vh, 180px) var(--page-gutter) clamp(112px, 16vh, 200px);
  }
  .chBody__grid{
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(32px, 5vw, 96px);
  }
  .chBody__sticky{
    position: sticky;
    top: clamp(96px, 14vh, 140px);
  }
  .chBody__label{ margin-bottom: 14px; }
  .chBody__name{
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.4vw, 40px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .chBody__links{
    list-style: none;
    margin: clamp(24px, 4vh, 40px) 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .chBody__links a{
    color: var(--text-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 4px;
    transition: color 400ms var(--ease-fluid), border-color 400ms var(--ease-fluid);
  }
  .chBody__links a:hover{ color: var(--text); border-color: var(--brand-primary, var(--olivar)); }

  .chBody__lede{
    margin: 0 0 clamp(48px, 8vh, 96px);
    max-width: 20ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.6vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }
  .chBody__prose{ max-width: 64ch; }

  @media (max-width: 880px){
    .chBody__grid{ grid-template-columns: 1fr; }
    .chBody__sticky{ position: static; }
    .chBody__side{ order: 2; }
  }
</style>

---
export const prerender = false;

import BaseLayout from "../components/layout/BaseLayout.astro";
import TopDock from "../components/layout/TopDock.astro";
import VoiceMark from "../components/motion/VoiceMark.astro";
import PortableText from "../components/content/PortableText.astro";
import SmartImage from "../components/content/SmartImage.astro";
import Sketch from "../components/content/Sketch.astro";
import NextChapter from "../components/content/NextChapter.astro";

import { getDaniel, getPressKit } from "../lib/queries";
import { href, pressHref, t2, tb2 } from "../lib/i18n";
import { MEDIA } from "../lib/site";
import type { Locale, PressRecognition } from "../lib/types";
import type { PortableTextBlock } from "@portabletext/types";

interface PageProps { lang?: Locale }
const { lang } = Astro.props as PageProps;
const locale: Locale = lang ?? Astro.locals.locale ?? "es";

const [daniel, kit] = await Promise.all([getDaniel(), getPressKit()]);

const name = daniel?.name ?? "Daniel Nates";
const tagline = t2(daniel?.tagline_es, daniel?.tagline_en, locale) || (locale === "es"
  ? "Cocinar y dibujar — la misma lengua."
  : "To cook and to draw — the same language.");
const subline = t2(daniel?.subline_es, daniel?.subline_en, locale) || (locale === "es"
  ? "Cocinero en Olivea · Socio en Fritanguita · Dibujante."
  : "Chef at Olivea · Partner at Fritanguita · Draughtsman.");

/* ── Long bio: pull from Supabase if present, else use a researched default ── */
const bioBlocks = tb2(daniel?.bio_long_es, daniel?.bio_long_en, locale);

const defaultBioParas = locale === "es" ? [
  "Daniel Nates es chef y dibujante. Vive en Valle de Guadalupe, Baja California, donde cocina en Olivea Farm to Table — un restaurante con Estrella Michelin y Estrella Verde Michelin, donde la carta cambia con la temporada del huerto. Es socio fundador de Fritanguita, una fritanga poblana en Roma Norte, Ciudad de México, junto a Santiago Muñoz Moctezuma de Maizajo.",
  "Es poblano de origen. Estudió en el Centro Culinario Internacional de la Universidad de Oriente. En 2016 fue finalista regional de Latinoamérica en la S.Pellegrino Young Chef Academy con su platillo Quiltamal, ganador del premio al Mensaje Más Inspirador. Food & Wine en Español lo nombró uno de los 19 mejores chefs nuevos de México.",
  "Antes de Olivea dirigió ocho años Maizal — su primer restaurante, en La Casona de los Sapos, Puebla. Lo cerró en 2024. Lo que aprendió ahí sigue cocinando lo que hace hoy.",
  "Cocinar y dibujar le interesan por las mismas razones: composición, contraste, intención. Su práctica visual —dibujo, pintura, marcas en papel— corre en paralelo a la cocina. La mesa, dice, es el último cuadro.",
] : [
  "Daniel Nates is a chef and a draughtsman. He lives in Valle de Guadalupe, Baja California, where he cooks at Olivea Farm to Table — a restaurant with a Michelin Star and a Michelin Green Star, whose menu changes with the garden's season. He is co-founder of Fritanguita, a poblano fritanga stand in Roma Norte, Mexico City, alongside Santiago Muñoz Moctezuma of Maizajo.",
  "He is poblano by origin. He studied at the Centro Culinario Internacional of the Universidad de Oriente. In 2016 he was a Latin America regional finalist in the S.Pellegrino Young Chef Academy with his dish Quiltamal, winner of the Most Inspiring Message award. Food & Wine en Español named him one of Mexico's 19 best new chefs.",
  "Before Olivea he led Maizal for eight years — his first restaurant, at La Casona de los Sapos in Puebla. He closed it in 2024. What he learned there still cooks what he does today.",
  "Cooking and drawing interest him for the same reasons: composition, contrast, intent. His visual practice — drawing, painting, marks on paper — runs parallel to the kitchen. The table, he says, is the last painting.",
];

/* ── Recognition timeline (uses press-kit if set, else researched defaults) ── */
const defaultRecs: PressRecognition[] = [
  { year: "2025", label: locale === "es" ? "Estrella Michelin · Estrella Verde Michelin" : "Michelin Star · Michelin Green Star", org: "Olivea Farm to Table" },
  { year: "2024", label: locale === "es" ? "Inclusión Guía Michelin" : "Michelin Guide listing", org: "Olivea Farm to Table" },
  { year: "2024", label: locale === "es" ? "Cierre de Maizal" : "Maizal closes", org: "La Casona de los Sapos · Puebla" },
  { year: "2025", label: "Fritanguita", org: locale === "es" ? "Apertura · Roma Norte, CDMX" : "Opens · Roma Norte, Mexico City" },
  { year: "2018", label: locale === "es" ? "19 Mejores Chefs Nuevos de México" : "Best New Chefs Mexico — 19", org: "Food & Wine en Español" },
  { year: "2017", label: locale === "es" ? "Apertura de Maizal" : "Maizal opens", org: "Puebla" },
  { year: "2016", label: locale === "es" ? "S.Pellegrino Young Chef · Mensaje Más Inspirador" : "S.Pellegrino Young Chef · Most Inspiring Message", org: locale === "es" ? "Latinoamérica · Quiltamal" : "Latin America · Quiltamal" },
];
/* The arc reads as a story — oldest first, grouped by year. */
const recs = (kit?.recognitions?.length ? kit.recognitions : defaultRecs)
  .slice()
  .sort((a, b) => Number(a.year) - Number(b.year));
const arcYears: { year: string; items: PressRecognition[] }[] = [];
for (const r of recs) {
  const last = arcYears[arcYears.length - 1];
  if (last && last.year === r.year) last.items.push(r);
  else arcYears.push({ year: r.year, items: [r] });
}

// Until Daniel sets a portrait inline, use his garden photograph
// (the same image the site's Person JSON-LD falls back to).
const portrait = daniel?.portrait_url ?? MEDIA.portrait;
const portraitIsFallback = !daniel?.portrait_url;

const headline = locale === "es" ? "Sobre" : "About";
const es = locale === "es";

/* Until Daniel saves his own bio, render the researched default through
 * PortableText too, so it gets the same editorial typography (and the
 * first inline save serializes exactly what's on screen). */
const bioValue: PortableTextBlock[] = bioBlocks.length
  ? (bioBlocks as PortableTextBlock[])
  : defaultBioParas.map((text, i) => ({
      _type: "block",
      _key: `b${i}`,
      style: "normal",
      markDefs: [],
      children: [{ _type: "span", _key: `s${i}`, text, marks: [] }],
    }) as unknown as PortableTextBlock);

/* Fact sheet — the profile at a glance (public, verified facts). */
const igHandle = daniel?.social?.instagram
  ? "@" + daniel.social.instagram.replace(/\/+$/, "").split("/").pop()
  : null;
const facts: { k: string; v: string; href?: string }[] = [
  { k: es ? "Origen" : "Origin", v: "Puebla, México" },
  { k: es ? "Vive" : "Lives", v: "Valle de Guadalupe, Baja California" },
  { k: es ? "Cocina" : "Cooks", v: es ? "Olivea Farm to Table — chef ejecutivo" : "Olivea Farm to Table — executive chef", href: href("/olivea", locale) },
  { k: es ? "Socio" : "Partner", v: "Fritanguita — Roma Norte, CDMX", href: href("/fritanguita", locale) },
  { k: es ? "Antes" : "Before", v: "Maizal — Puebla, 2017–2024", href: href("/maizal", locale) },
  { k: es ? "Formación" : "Training", v: "Centro Culinario Internacional, Universidad de Oriente" },
  ...(igHandle && daniel?.social?.instagram ? [{ k: "Instagram", v: igHandle, href: daniel.social.instagram }] : []),
];

/* Three kitchens, in the order he cooked in them. */
const kitchens = [
  {
    slug: "maizal", title: "Maizal", when: "2017–2024", where: "Puebla",
    line: es ? "Su primer restaurante. Ocho años; el primer maestro." : "His first restaurant. Eight years; the first teacher.",
    img: "/media/stills/maizal-poster.jpg", pos: "62% 50%",
  },
  {
    slug: "olivea", title: "Olivea", when: es ? "Hoy" : "Now", where: "Valle de Guadalupe",
    line: es ? "Chef ejecutivo. Estrella Michelin y Estrella Verde; la carta la escribe el huerto." : "Executive chef. Michelin Star and Green Star; the garden writes the menu.",
    img: "/media/stills/olivea-poster.jpg", pos: "45% 50%",
  },
  {
    slug: "fritanguita", title: "Fritanguita", when: es ? "Desde 2025" : "Since 2025", where: "Roma Norte, CDMX",
    line: es ? "Socio, con Santiago Muñoz. Fritanga poblana, de pie, en la esquina." : "Partner, with Santiago Muñoz. Poblano fritanga, standing, on the corner.",
    img: "/media/stills/fritanguita-poster.jpg", pos: "42% 50%",
  },
];

/* Inline-edit field paths. The bio is PortableText, edited in place —
 * the rendered paragraphs themselves become contentEditable, with a
 * floating toolbar for bold/italic/links/headings. First save of the
 * default (researched) bio serializes the visible paragraphs as-is. */
const taglineField = `daniel.tagline_${locale}`;
const sublineField = `daniel.subline_${locale}`;
const bioField     = `daniel.bio_long_${locale}`;
---

<BaseLayout
  title={`${headline} — ${name}`}
  description={subline}
  locale={locale}
  og={{
    title: name,
    kicker: es ? "Sobre" : "About",
    sig: tagline,
    brand: "daniel",
    meta: es ? "Valle de Guadalupe · CDMX" : "Valle de Guadalupe · Mexico City",
  }}
>
  <TopDock locale={locale} />

  {/* I — The profile opener: the name on paper, the man in the garden. */}
  <section class="ab-hero scene--bone" data-scene="bone">
    <div class="ab-hero__text">
      <p class="ab-kicker"><span class="ab-kicker__rule" aria-hidden="true"></span>{headline}</p>
      <h1 class="ab-hero__name" data-edit-field="daniel.name" data-reveal-text data-reveal-mode="letter" aria-label={name}>{name}</h1>
      <p class="ab-hero__subline" data-edit-field={sublineField}>{subline}</p>
      <p class="ab-hero__place">{es ? "Valle de Guadalupe · Ciudad de México" : "Valle de Guadalupe · Mexico City"}</p>
      {daniel?.voice ? (
        <div class="ab-hero__voice">
          <VoiceMark voice={daniel.voice} locale={locale} variant="inline" label={es ? "Su voz" : "His voice"} />
        </div>
      ) : null}
    </div>
    <figure class="ab-hero__media" data-edit-image-field="daniel.portrait_url" data-fallback={portraitIsFallback ? "1" : undefined}>
      <SmartImage src={portrait} alt={name} eager widths={[800, 1200, 1800]} sizes="(min-width: 880px) 58vw, 100vw" />
    </figure>
  </section>

  {/* II — The thesis, at display scale, while the hand draws. */}
  <section class="ab-thesis scene--ink" data-scene="ink">
    <div class="ab-thesis__grid">
      <p class="ab-thesis__quote" data-edit-field={taglineField} data-reveal-text data-reveal-mode="word" aria-label={tagline}>{tagline}</p>
      <Sketch kind="mano" tone="ink" class="ab-thesis__sketch" label={es ? "Fig. — la mano" : "Fig. — the hand"} />
    </div>
  </section>

  {/* III — The bio, read on paper, with the fact sheet alongside. */}
  <section class="ab-bio scene--bone" data-scene="bone">
    <div class="ab-bio__grid">
      <aside class="ab-bio__rail">
        <div class="ab-bio__sticky">
          <p class="ab-label ui-label">{es ? "Ficha" : "At a glance"}</p>
          <dl class="ab-facts">
            {facts.map((f) => (
              <div class="ab-facts__row">
                <dt>{f.k}</dt>
                <dd>{f.href ? <a href={f.href} target={f.href.startsWith("http") ? "_blank" : undefined} rel={f.href.startsWith("http") ? "noreferrer" : undefined}>{f.v}</a> : f.v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
      <div class="ab-bio__body">
        <p class="ab-label ui-label">Bio</p>
        <div data-edit-field={bioField} data-edit-portable="1" data-reveal-body>
          <PortableText value={bioValue} lead />
        </div>
      </div>
    </div>
  </section>

  {/* IV — Three kitchens, in the order he cooked in them. */}
  <section class="ab-kitchens scene--ink" data-scene="ink">
    <div class="ab-wrap">
      <header class="ab-sectionHead">
        <p class="ab-label ui-label">{es ? "Tres cocinas" : "Three kitchens"}</p>
        <h2 class="ab-h2">{es ? "Lo lento, lo rápido, lo que enseñó." : "The slow, the fast, the one that taught."}</h2>
      </header>
      <ol class="ab-kitchens__list reveal-stagger">
        {kitchens.map((k, i) => (
          <li>
            <a class="ab-kitchen" href={href(`/${k.slug}`, locale)}>
              <span class="ab-kitchen__img" style={`--pos: ${k.pos};`}>
                <SmartImage src={k.img} alt="" widths={[480, 800]} sizes="(min-width: 880px) 30vw, 100vw" />
              </span>
              <span class="ab-kitchen__num">{String(i + 1).padStart(2, "0")} · {k.when}</span>
              <span class="ab-kitchen__title">{k.title}</span>
              <span class="ab-kitchen__where">{k.where}</span>
              <span class="ab-kitchen__line">{k.line}</span>
              <span class="ab-kitchen__go">{es ? "Abrir capítulo" : "Open chapter"} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* V — The arc, oldest first: a story, not a trophy shelf. */}
  {arcYears.length ? (
    <section class="ab-arc scene--bone" data-scene="bone">
      <div class="ab-wrap">
        <header class="ab-sectionHead">
          <p class="ab-label ui-label">{es ? "Trayecto" : "Arc"}</p>
          <h2 class="ab-h2">{es ? "Lo que llevo." : "What I carry."}</h2>
        </header>
        <ol class="ab-arc__list">
          {arcYears.map((y) => (
            <li class="ab-arc__year reveal">
              <span class="ab-arc__num">{y.year}</span>
              <ul class="ab-arc__items">
                {y.items.map((r) => (
                  <li>
                    <p class="ab-arc__label">{r.url ? <a href={r.url} target="_blank" rel="noreferrer">{r.label}</a> : r.label}</p>
                    {r.org ? <p class="ab-arc__org">{r.org}</p> : null}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ) : null}

  {/* VI — Coda: an open door. */}
  <section class="ab-coda scene--ink" data-scene="ink">
    <div class="ab-wrap">
      <p class="ab-coda__line">{es ? "¿Prensa, una colaboración, una idea suelta?" : "Press, a collaboration, a loose idea?"}</p>
      <div class="ab-coda__ctas">
        <a class="ui-pill ui-pill--solid" href={href("/contacto", locale)}>{es ? "Escribe" : "Write"} <span aria-hidden="true">→</span></a>
        <a class="ui-pill" href={pressHref(locale)}>{es ? "Kit de prensa" : "Press kit"} <span aria-hidden="true">→</span></a>
      </div>
      <NextChapter current="sobre" locale={locale} />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Shared ───────────────────────────────────────────────── */
  .ab-wrap{ max-width: 1320px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }
  .ab-label{ margin-bottom: clamp(14px, 2vh, 22px); }
  .ab-h2{
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 5.4vw, 96px);
    line-height: .96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .ab-sectionHead{ margin-bottom: clamp(48px, 8vh, 96px); }
  /* position: relative — every scene must contain the global ink
     vignette (.scene--ink::after is absolutely positioned); unpositioned,
     it escapes and lays itself over the top of the page. */
  .ab-hero, .ab-thesis, .ab-bio, .ab-kitchens, .ab-arc, .ab-coda{
    position: relative;
    background: var(--bg);
    color: var(--text);
  }
  .ab-thesis > *, .ab-kitchens > *, .ab-coda > *{ position: relative; z-index: 1; }

  /* ── I · Hero ─────────────────────────────────────────────── */
  .ab-hero{
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    min-height: 100svh;
  }
  .ab-hero__text{
    align-self: end;
    padding: clamp(140px, 20vh, 220px) clamp(20px, 4vw, 64px) clamp(48px, 9vh, 104px);
  }
  .ab-kicker{
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 clamp(18px, 3vh, 30px);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .ab-kicker__rule{ width: clamp(28px, 4vw, 56px); height: 1px; background: var(--olivar); }
  .ab-hero__name{
    margin: 0;
    max-width: 6ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(76px, 10.5vw, 196px);
    line-height: .84;
    letter-spacing: -0.05em;
    padding-bottom: .04em;
  }
  .ab-hero__subline{
    margin: clamp(26px, 4vh, 44px) 0 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 1.7vw, 28px);
    line-height: 1.3;
    color: var(--text-2);
  }
  .ab-hero__place{
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .ab-hero__voice{ margin-top: clamp(24px, 4vh, 40px); }
  .ab-hero__media{
    position: relative;
    margin: 0;
    min-height: 100%;
    overflow: hidden;
  }
  .ab-hero__media :global(img){
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.92) contrast(1.03);
  }
  .ab-hero__media[data-fallback] :global(img){ object-position: 68% 40%; }

  /* ── II · Thesis ──────────────────────────────────────────── */
  .ab-thesis{ padding: clamp(110px, 18vh, 220px) clamp(20px, 4vw, 64px); }
  .ab-thesis__grid{
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    align-items: center;
    gap: clamp(32px, 6vw, 112px);
  }
  .ab-thesis__quote{
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 7.2vw, 136px);
    line-height: .96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  :global(.ab-thesis__sketch){ width: min(100%, 360px); justify-self: center; }

  /* ── III · Bio ────────────────────────────────────────────── */
  .ab-bio{ padding: clamp(100px, 15vh, 180px) clamp(20px, 4vw, 64px) clamp(110px, 16vh, 200px); }
  .ab-bio__grid{
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(36px, 6vw, 112px);
  }
  .ab-bio__sticky{ position: sticky; top: clamp(96px, 14vh, 140px); }
  .ab-facts{ margin: 0; display: grid; border-top: 1px solid var(--line); }
  .ab-facts__row{
    display: grid;
    grid-template-columns: 7.5em 1fr;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .ab-facts dt{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: .3em;
  }
  .ab-facts dd{
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.3;
  }
  .ab-facts a{
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--olivar) 55%, transparent);
    text-underline-offset: .2em;
  }

  /* ── IV · Kitchens ────────────────────────────────────────── */
  .ab-kitchens{ padding: clamp(110px, 16vh, 200px) 0; }
  .ab-kitchens__list{
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }
  .ab-kitchen{ display: grid; gap: 10px; color: var(--text); text-decoration: none; }
  .ab-kitchen__img{
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 12px;
    background: var(--ink-2);
  }
  .ab-kitchen__img :global(img){
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    filter: contrast(1.05) brightness(.88);
    transition: transform 1400ms var(--ease-fluid), filter 1400ms var(--ease-fluid);
  }
  .ab-kitchen:hover .ab-kitchen__img :global(img){ transform: scale(1.04); filter: contrast(1.08) brightness(1); }
  .ab-kitchen__num{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .ab-kitchen__title{
    font-family: var(--font-display);
    font-size: clamp(40px, 4.4vw, 76px);
    line-height: .9;
    letter-spacing: -0.04em;
  }
  .ab-kitchen__where{
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .ab-kitchen__line{
    max-width: 32ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(17px, 1.3vw, 21px);
    line-height: 1.38;
    color: var(--text-2);
  }
  .ab-kitchen__go{
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .ab-kitchen__go span{ display: inline-block; transition: transform 700ms var(--ease-fluid); }
  .ab-kitchen:hover .ab-kitchen__go span{ transform: translateX(6px); }

  /* ── V · Arc ──────────────────────────────────────────────── */
  .ab-arc{ padding: clamp(110px, 16vh, 200px) 0; }
  .ab-arc__list{ list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ab-arc__year{
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(20px, 5vw, 96px);
    padding: clamp(26px, 4vh, 44px) 0;
    border-bottom: 1px solid var(--line);
  }
  .ab-arc__num{
    font-family: var(--font-display);
    font-size: clamp(56px, 7vw, 120px);
    line-height: .8;
    letter-spacing: -0.04em;
    font-feature-settings: "lnum";
    color: var(--text);
  }
  .ab-arc__items{ list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; align-content: center; }
  .ab-arc__label{
    margin: 0;

# ── Supabase ──────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard
# Find the URL + anon key under Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for inserts that bypass RLS (Settings → API → service_role)
# Do NOT expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Salt for hashing contact-form IPs (rate limiting without
# storing addresses). Generate: openssl rand -hex 32
CONTACT_IP_SALT=

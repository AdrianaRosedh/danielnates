PUBLIC_SANITY_PROJECT_ID=2c2yp0gm
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-05-03

# Required for draft preview from Sanity Studio Presentation tool.
# Generate at https://www.sanity.io/manage/project/2c2yp0gm/api → Tokens
# Permissions: Viewer (read-only is enough for preview)
SANITY_API_READ_TOKEN=

# Random string used to gate /api/draft/enable. Pick anything long.
SANITY_PREVIEW_SECRET=change-me-to-something-random

# ── Supabase ──────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard
# Find the URL + anon key under Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for inserts that bypass RLS (Settings → API → service_role)
# Do NOT expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
